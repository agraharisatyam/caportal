@model caportal.Models.Entities.BlogPost
@{
    Layout = "~/Areas/Admin/Views/Shared/_DattaLayout.cshtml";
    ViewData["Title"] = "Create New Blog Article";
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="page-block">
        <div class="flex items-start justify-between flex-wrap gap-3 mb-2">
            <div>
                <h4 class="mb-0 font-weight-bold text-black flex items-center"><i data-feather="plus-circle" class="me-2 text-black" style="display: inline-block !important; vertical-align: middle;"></i> <span>Create New Blog Article</span></h4>
                <span class="text-muted small">Write and publish an informative article for your users</span>
            </div>
            <a href="/Admin/Blog" class="btn btn-outline-secondary btn-sm flex items-center gap-1">
                <i data-feather="arrow-left" style="width:14px;height:14px;display:inline-block;vertical-align:middle;"></i> Back to Articles
            </a>
        </div>
        <ul class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/ajs">Admin Home</a></li>
            <li class="breadcrumb-item"><a href="/Admin/Blog">Blogs</a></li>
            <li class="breadcrumb-item active" aria-current="page">Create Article</li>
        </ul>
    </div>
</div>

<div class="grid grid-cols-12 gap-x-6 gap-y-4">
    <div class="col-span-12 lg:col-span-8 lg:col-start-3">
        <div class="card" style="border-top: 4px solid #d4a017;">
            <div class="card-header">
                <h5 class="mb-0 text-gold flex items-center"><i data-feather="edit-3" class="me-2" style="display: inline-block !important; vertical-align: middle;"></i> <span>Publish New Article</span></h5>
            </div>
            <div class="card-body">
                <form method="post" action="/Admin/Blog/Create">
                    @Html.AntiForgeryToken()

                    <div class="grid grid-cols-12 gap-x-6 gap-y-4">
                        <div class="col-span-12 md:col-span-8">
                            <label class="form-label font-weight-bold">Article Title *</label>
                            <input type="text" name="Title" class="form-control" placeholder="e.g. GST Annual Return Filing Deadline & Checklist" required />
                        </div>
                        <div class="col-span-12 md:col-span-4">
                            <label class="form-label font-weight-bold">Category *</label>
                            <select name="Category" class="form-select">
                                <option>GST &amp; Tax</option>
                                <option>Income Tax</option>
                                <option>Corporate Law</option>
                                <option>Startup Advisory</option>
                                <option>Audit &amp; Assurance</option>
                            </select>
                        </div>

                        <div class="col-span-12 md:col-span-6">
                            <label class="form-label font-weight-bold">Author Name</label>
                            <input type="text" name="AuthorName" class="form-control" value="CA Priya Mehta" />
                        </div>
                        <div class="col-span-12 md:col-span-6">
                            <label class="form-label font-weight-bold">Author Designation / Role</label>
                            <input type="text" name="AuthorRole" class="form-control" value="FCA, Senior GST Partner" />
                        </div>

                        <div class="col-span-12 md:col-span-6">
                            <label class="form-label font-weight-bold">Featured Image Path / URL</label>
                            <input type="text" name="FeaturedImagePath" class="form-control" value="/images/services/gst-tax.svg" />
                        </div>
                        <div class="col-span-12 md:col-span-6">
                            <label class="form-label font-weight-bold">Estimated Read Time (Minutes)</label>
                            <input type="number" name="ReadTimeMinutes" class="form-control" value="5" />
                        </div>

                        <div class="col-span-12">
                            <label class="form-label font-weight-bold">Short Excerpt / Summary *</label>
                            <textarea name="Excerpt" class="form-control" rows="2" placeholder="Brief 2-sentence summary of the article..." required></textarea>
                        </div>

                        <div class="col-span-12">
                            <label class="form-label font-weight-bold">HTML Article Body Content *</label>
                            <textarea name="Content" class="form-control font-monospace" rows="12" placeholder="<p class='lead'>Article text...</p>" required></textarea>
                        </div>

                        <div class="col-span-12">
                            <label class="form-label font-weight-bold">Tags (Comma-separated)</label>
                            <input type="text" name="tagsText" class="form-control" placeholder="GST, Tax Filing, Compliance, Audit" />
                        </div>

                        <!-- SEO Settings Sub-Section -->
                        <div class="col-span-12 mt-3 mb-1">
                            <h6 class="text-primary font-weight-bold flex items-center border-bottom pb-2">
                                <i data-feather="search" class="me-2" style="width:16px;height:16px;display:inline-block;vertical-align:middle;"></i>
                                <span>SEO &amp; Search Engine Optimization</span>
                            </h6>
                        </div>

                        <div class="col-span-12 md:col-span-6">
                            <label class="form-label font-weight-bold">Meta Title</label>
                            <input type="text" name="MetaTitle" class="form-control" placeholder="SEO Title (e.g. GST Input Tax Credit Guide)" />
                            <small class="text-muted text-xs">Recommended: Under 60 characters</small>
                        </div>
                        <div class="col-span-12 md:col-span-6">
                            <label class="form-label font-weight-bold">Meta Keywords</label>
                            <input type="text" name="MetaKeywords" class="form-control" placeholder="Keywords (comma separated)" />
                            <small class="text-muted text-xs">e.g. gst, itc, reconciliation, tax compliance</small>
                        </div>
                        <div class="col-span-12">
                            <label class="form-label font-weight-bold">Meta Description</label>
                            <textarea name="MetaDescription" class="form-control" rows="2" placeholder="Search engine snippet description..."></textarea>
                            <small class="text-muted text-xs">Recommended: Under 160 characters</small>
                        </div>

                        <div class="col-span-12 form-check ms-3">
                            <input type="checkbox" name="IsPublished" class="form-check-input" id="isPublished" value="true" checked />
                            <label class="form-check-label font-weight-bold" for="isPublished">Publish Article Live Immediately</label>
                        </div>
                    </div>

                    <hr class="my-4" style="border-top: 1px solid var(--pc-border-color, #e5e7eb);" />

                    <div class="flex items-center justify-end gap-2">
                        <a href="/Admin/Blog" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-5 flex items-center gap-1">
                            <i data-feather="save" style="width:14px;height:14px;display:inline-block;vertical-align:middle;"></i> Publish Article
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
