@model caportal.Models.Entities.BlogPost
@{
    Layout = "~/Areas/Admin/Views/Shared/_DattaLayout.cshtml";
    ViewData["Title"] = $"Edit Article — {Model.Title}";
    var tagsStr = Model.Tags != null ? string.Join(", ", Model.Tags) : "";
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="page-block">
        <div class="flex items-start justify-between flex-wrap gap-3 mb-2">
            <div>
                <h4 class="mb-0 font-weight-bold text-black flex items-center"><i data-feather="edit-3" class="me-2 text-black" style="display: inline-block !important; vertical-align: middle;"></i> <span>Edit Article: @Model.Title</span></h4>
                <span class="text-muted small">Update article details, author role, read time, and excerpt</span>
            </div>
            <a href="/Admin/Blog" class="btn btn-outline-secondary btn-sm flex items-center gap-1">
                <i data-feather="arrow-left" style="width:14px;height:14px;display:inline-block;vertical-align:middle;"></i> Back to Articles
            </a>
        </div>
        <ul class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/ajs">Admin Home</a></li>
            <li class="breadcrumb-item"><a href="/Admin/Blog">Blogs</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit #@Model.Id</li>
        </ul>
    </div>
</div>

<div class="grid grid-cols-12 gap-x-6 gap-y-4">
    <div class="col-span-12 lg:col-span-8 lg:col-start-3">
        <div class="card" style="border-top: 4px solid #d4a017;">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0 text-gold flex items-center"><i data-feather="edit" class="me-2" style="display: inline-block !important; vertical-align: middle;"></i> <span>Edit Article Details</span></h5>
                <span class="badge bg-dark border text-muted">ID #@Model.Id</span>
            </div>
            <div class="card-body">
                <form method="post" action="/Admin/Blog/Edit">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@Model.Id" />

                    <div class="grid grid-cols-12 gap-x-6 gap-y-4">
                        <div class="col-span-12 md:col-span-8">
                            <label class="form-label font-weight-bold">Article Title *</label>
                            <input type="text" name="Title" class="form-control" value="@Model.Title" required />
                        </div>
                        <div class="col-span-12 md:col-span-4">
                            <label class="form-label font-weight-bold">Category *</label>
                            <select name="Category" class="form-select">
                                <option selected="@(Model.Category == "GST & Tax")">GST &amp; Tax</option>
                                <option selected="@(Model.Category == "Income Tax")">Income Tax</option>
                                <option selected="@(Model.Category == "Corporate Law")">Corporate Law</option>
                                <option selected="@(Model.Category == "Startup Advisory")">Startup Advisory</option>
                                <option selected="@(Model.Category == "Audit & Assurance")">Audit &amp; Assurance</option>
                            </select>
                        </div>

                        <div class="col-span-12 md:col-span-6">
                            <label class="form-label font-weight-bold">URL Slug *</label>
                            <input type="text" name="Slug" class="form-control" value="@Model.Slug" required />
                        </div>
                        <div class="col-span-12 md:col-span-3">
                            <label class="form-label font-weight-bold">Author Name</label>
                            <input type="text" name="AuthorName" class="form-control" value="@Model.AuthorName" />
                        </div>
                        <div class="col-span-12 md:col-span-3">
                            <label class="form-label font-weight-bold">Read Time (Mins)</label>
                            <input type="number" name="ReadTimeMinutes" class="form-control" value="@Model.ReadTimeMinutes" />
                        </div>

                        <div class="col-span-12">
                            <label class="form-label font-weight-bold">Short Excerpt / Summary *</label>
                            <textarea name="Excerpt" class="form-control" rows="2" required>@Model.Excerpt</textarea>
                        </div>

                        <div class="col-span-12">
                            <label class="form-label font-weight-bold">HTML Article Body Content *</label>
                            <textarea name="Content" class="form-control font-monospace" rows="12" required>@Model.Content</textarea>
                        </div>

                        <div class="col-span-12">
                            <label class="form-label font-weight-bold">Tags (Comma-separated)</label>
                            <input type="text" name="tagsText" class="form-control" value="@tagsStr" />
                        </div>

                        <!-- SEO Settings Sub-Section -->
                        <div class="col-span-12 mt-3 mb-1">
                            <h6 class="text-primary font-weight-bold flex items-center border-bottom pb-2">
                                <i data-feather="search" class="me-2" style="width:16px;height:16px;display:inline-block;vertical-align:middle;"></i>
                                <span>SEO &amp; Search Engine Optimization</span>
                            </h6>
                        </div>

                        <div class="col-span-12 md:col-span-6">
                            <label class="form-label font-weight-bold">Meta Title</label>
                            <input type="text" name="MetaTitle" class="form-control" value="@Model.MetaTitle" placeholder="SEO Title (e.g. GST Input Tax Credit Guide)" />
                            <small class="text-muted text-xs">Recommended: Under 60 characters</small>
                        </div>
                        <div class="col-span-12 md:col-span-6">
                            <label class="form-label font-weight-bold">Meta Keywords</label>
                            <input type="text" name="MetaKeywords" class="form-control" value="@Model.MetaKeywords" placeholder="Keywords (comma separated)" />
                            <small class="text-muted text-xs">e.g. gst, itc, reconciliation, tax compliance</small>
                        </div>
                        <div class="col-span-12">
                            <label class="form-label font-weight-bold">Meta Description</label>
                            <textarea name="MetaDescription" class="form-control" rows="2" placeholder="Search engine snippet description...">@Model.MetaDescription</textarea>
                            <small class="text-muted text-xs">Recommended: Under 160 characters</small>
                        </div>

                        <div class="col-span-12 form-check ms-3">
                            <input type="checkbox" name="IsPublished" class="form-check-input" id="isPublished" value="true" @(Model.IsPublished ? "checked" : "") />
                            <label class="form-check-label font-weight-bold" for="isPublished">Article Live Status</label>
                        </div>
                    </div>

                    <hr class="my-4" style="border-top: 1px solid var(--pc-border-color, #e5e7eb);" />

                    <div class="flex items-center justify-end gap-2">
                        <a href="/Admin/Blog" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-5 flex items-center gap-1">
                            <i data-feather="save" style="width:14px;height:14px;display:inline-block;vertical-align:middle;"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
