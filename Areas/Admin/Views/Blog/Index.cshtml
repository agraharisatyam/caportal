@model List<caportal.Models.Entities.BlogPost>
@{
    Layout = "~/Areas/Admin/Views/Shared/_DattaLayout.cshtml";
    ViewData["Title"] = "Manage Blog Articles";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0">Blog Articles CMS</h5>
            <small class="text-muted">Manage articles, tax guides, and knowledge base content</small>
        </div>
        <a href="/Admin/Blog/Create" class="btn btn-primary"><i class="feather icon-plus me-1"></i>New Article</a>
    </div>
    <div class="card-body table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Article Title</th>
                    <th>Category</th>
                    <th>Author</th>
                    <th>Views</th>
                    <th>Status</th>
                    <th>Published Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var post in Model)
                {
                    <tr>
                        <td>
                            <strong><a href="/blog/@post.Slug" target="_blank" class="text-dark text-decoration-none">@post.Title</a></strong><br />
                            <small class="text-muted">/@post.Slug</small>
                        </td>
                        <td><span class="badge bg-light-primary text-primary fw-bold">@post.Category</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <img src="@post.AuthorAvatar" style="width:28px;height:28px;border-radius:50%;" alt="@post.AuthorName" />
                                <small><strong>@post.AuthorName</strong></small>
                            </div>
                        </td>
                        <td><span class="badge bg-light text-dark"><i class="feather icon-eye me-1"></i>@post.ViewsCount</span></td>
                        <td>
                            <form method="post" action="/Admin/Blog/TogglePublish" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@post.Id" />
                                @if (post.IsPublished)
                                {
                                    <button type="submit" class="btn btn-xs btn-success" title="Click to Unpublish">Published</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-xs btn-secondary" title="Click to Publish">Draft</button>
                                }
                            </form>
                        </td>
                        <td><small>@post.PublishedDate.ToString("dd MMM yyyy")</small></td>
                        <td>
                            <a href="/Admin/Blog/Edit/@post.Id" class="btn btn-xs btn-primary me-1"><i class="feather icon-edit"></i></a>
                            <form method="post" action="/Admin/Blog/Delete" class="d-inline" onsubmit="return confirm('Delete article @post.Title?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@post.Id" />
                                <button type="submit" class="btn btn-xs btn-danger"><i class="feather icon-trash-2"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
