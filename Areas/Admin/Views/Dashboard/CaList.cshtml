@using caportal.Models.Entities
@{
    Layout = "~/Areas/Admin/Views/Shared/_DattaLayout.cshtml";
    ViewData["Title"] = "CA Professionals";
    var cas = (ViewBag.CAs as List<CaProfessional>) ?? new List<CaProfessional>();
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="page-block">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-2">
            <div>
                <h4 class="mb-0 font-weight-bold text-black flex items-center">
                    <i data-feather="users" class="me-2 text-black" style="display: inline-block !important; vertical-align: middle;"></i> 
                    <span>CA Professionals Roster</span>
                </h4>
                <span class="text-muted small">Manage verified Chartered Accountants, empanelment statuses, and visibility</span>
            </div>
            <a href="/Admin/Dashboard/CaCreate" class="btn btn-primary">
                <i data-feather="plus" class="me-1" style="width:14px;height:14px;display:inline-block;vertical-align:middle;"></i> Add New CA
            </a>
        </div>
        <ul class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/ajs">Admin Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">CA List</li>
        </ul>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i data-feather="check-circle" class="me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i data-feather="alert-circle" class="me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Summary Cards -->
<div class="grid grid-cols-12 gap-x-6 mb-4">
    <div class="col-span-12 md:col-span-3">
        <div class="card text-center">
            <div class="card-body py-3">
                <h4 class="font-bold text-primary mb-0">@ViewBag.TotalCAs</h4>
                <p class="text-muted text-sm mb-0">Total Registered CAs</p>
            </div>
        </div>
    </div>
    <div class="col-span-12 md:col-span-3">
        <div class="card text-center">
            <div class="card-body py-3">
                <h4 class="font-bold text-success-600 mb-0">@ViewBag.ActiveCAs</h4>
                <p class="text-muted text-sm mb-0">Active & Listed</p>
            </div>
        </div>
    </div>
    <div class="col-span-12 md:col-span-3">
        <div class="card text-center">
            <div class="card-body py-3">
                <h4 class="font-bold text-warning-600 mb-0">@ViewBag.PendingCAs</h4>
                <p class="text-muted text-sm mb-0">Pending Approval</p>
            </div>
        </div>
    </div>
    <div class="col-span-12 md:col-span-3">
        <div class="card text-center">
            <div class="card-body py-3">
                <h4 class="font-bold text-danger-600 mb-0">@ViewBag.SuspendedCAs</h4>
                <p class="text-muted text-sm mb-0">Suspended / Inactive</p>
            </div>
        </div>
    </div>
</div>

<!-- CA Table -->
<div class="grid grid-cols-12 gap-x-6">
    <div class="col-span-12">
        <div class="card">
            <div class="card-header flex items-center justify-between flex-wrap gap-2">
                <h5 class="mb-0 text-white">Empaneled CA Professionals</h5>
                <div class="flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" onclick="filterStatus('all')">All (@ViewBag.TotalCAs)</button>
                    <button class="btn btn-sm btn-success" onclick="filterStatus('Active')">Active</button>
                    <button class="btn btn-sm btn-warning" onclick="filterStatus('Pending')">Pending</button>
                    <button class="btn btn-sm btn-danger" onclick="filterStatus('Suspended')">Suspended</button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="caListTable" class="table table-hover align-middle" style="width:100%">
                        <thead class="table-light">
                            <tr>
                                <th style="width:40px;">#</th>
                                <th>CA Professional</th>
                                <th>Designation</th>
                                <th>Membership No.</th>
                                <th>Specialisations</th>
                                <th>Location</th>
                                <th>Exp / Cases</th>
                                <th>Fee (₹)</th>
                                <th>Rating</th>
                                <th>Status</th>
                                <th class="text-center" style="width:120px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ca in cas)
                            {
                                var expertSlug = $"{ca.Name.ToLowerInvariant().Replace(" ", "-")}-{ca.Id}";
                                <tr data-status="@ca.Status">
                                    <td><small class="text-muted">#@ca.Id</small></td>
                                    <td>
                                        <div class="flex items-center gap-2">
                                            @if (!string.IsNullOrEmpty(ca.ImagePath))
                                            {
                                                <img src="@ca.ImagePath" alt="@ca.Name" class="w-9 h-9 rounded-circle object-cover border flex-shrink-0" onerror="this.src='/images/ca/ca-priya-mehta.svg';" />
                                            }
                                            else
                                            {
                                                <div class="w-9 h-9 rounded-circle bg-primary-500 flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
                                                    @ca.Initials
                                                </div>
                                            }
                                            <div>
                                                <span class="font-weight-bold text-white d-block">@ca.Name</span>
                                                @if (ca.IsFeatured)
                                                {
                                                    <span class="badge bg-warning text-dark text-xs"><i data-feather="star" style="width:10px;height:10px;display:inline-block;vertical-align:middle;"></i> Featured</span>
                                                }
                                                @if (ca.IsVerified)
                                                {
                                                    <span class="badge bg-success text-xs"><i data-feather="check" style="width:10px;height:10px;display:inline-block;vertical-align:middle;"></i> Verified</span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-primary-100 text-primary-700">@ca.Designation</span></td>
                                    <td class="text-sm font-monospace text-muted">@ca.MembershipNo</td>
                                    <td>
                                        @foreach (var tag in ca.Specialisations.Take(2))
                                        {
                                            <span class="badge bg-secondary me-1 mb-1">@tag</span>
                                        }
                                        @if (ca.Specialisations.Length > 2)
                                        {
                                            <span class="badge bg-light text-muted">+@(ca.Specialisations.Length - 2)</span>
                                        }
                                    </td>
                                    <td>@ca.City</td>
                                    <td>
                                        <div>@ca.YearsExp yrs</div>
                                        <small class="text-muted">@ca.CasesHandled+ cases</small>
                                    </td>
                                    <td class="font-weight-bold text-gold">₹ @ca.ConsultationFee</td>
                                    <td>
                                        <span class="text-warning font-medium">⭐ @ca.Rating</span>
                                    </td>
                                    <td>
                                        @switch (ca.Status)
                                        {
                                            case "Active":
                                                <span class="badge bg-success text-white">Active</span>
                                                break;
                                            case "Pending":
                                                <span class="badge bg-warning text-dark">Pending</span>
                                                break;
                                            case "Suspended":
                                                <span class="badge bg-danger text-white">Suspended</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@ca.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="flex items-center justify-center gap-1">
                                            <a href="/expert/@expertSlug" target="_blank" class="btn btn-xs btn-outline-primary" title="View Public Profile">
                                                <i data-feather="eye" style="width:12px;height:12px;display:inline-block;vertical-align:middle;"></i>
                                            </a>
                                            <a href="/Admin/Dashboard/CaEdit/@ca.Id" class="btn btn-xs btn-outline-warning" title="Edit Profile">
                                                <i data-feather="edit-2" style="width:12px;height:12px;display:inline-block;vertical-align:middle;"></i>
                                            </a>
                                            <form method="post" action="/Admin/Dashboard/CaDelete" onsubmit="return confirm('Are you sure you want to remove @ca.Name?');" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@ca.Id" />
                                                <button type="submit" class="btn btn-xs btn-outline-danger" title="Delete Profile">
                                                    <i data-feather="trash-2" style="width:12px;height:12px;display:inline-block;vertical-align:middle;"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script>
        var table;
        $(function () {
            table = $('#caListTable').DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                order: [[0, 'asc']],
                responsive: true,
                columnDefs: [{ orderable: false, targets: [10] }]
            });

            if (typeof feather !== 'undefined') feather.replace();
        });

        function filterStatus(status) {
            if (status === 'all') {
                table.column(9).search('').draw();
            } else {
                table.column(9).search(status).draw();
            }
        }
    </script>
}
