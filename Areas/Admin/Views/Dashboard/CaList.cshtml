@using caportal.Models
@{
    ViewData["Title"] = "CA Professionals";
    var cas = (ViewBag.CAs as List<CaProfessional>) ?? new List<CaProfessional>();
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-block">
        <div class="page-header-title">
            <h5 class="mb-0 font-medium">CA Professionals</h5>
        </div>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="/ajs">Home</a></li>
            <li class="breadcrumb-item" aria-current="page">CA List</li>
        </ul>
    </div>
</div>

<!-- Summary Cards -->
<div class="grid grid-cols-12 gap-x-6 mb-4">
    <div class="col-span-12 md:col-span-4">
        <div class="card text-center">
            <div class="card-body py-3">
                <h4 class="font-bold text-primary mb-0">@ViewBag.TotalCAs</h4>
                <p class="text-muted text-sm mb-0">Total Registered</p>
            </div>
        </div>
    </div>
    <div class="col-span-12 md:col-span-4">
        <div class="card text-center">
            <div class="card-body py-3">
                <h4 class="font-bold text-success-600 mb-0">@ViewBag.ActiveCAs</h4>
                <p class="text-muted text-sm mb-0">Active</p>
            </div>
        </div>
    </div>
    <div class="col-span-12 md:col-span-4">
        <div class="card text-center">
            <div class="card-body py-3">
                <h4 class="font-bold text-warning-600 mb-0">@ViewBag.PendingCAs</h4>
                <p class="text-muted text-sm mb-0">Pending Approval</p>
            </div>
        </div>
    </div>
</div>

<!-- CA Table -->
<div class="grid grid-cols-12 gap-x-6">
    <div class="col-span-12">
        <div class="card">
            <div class="card-header flex items-center justify-between">
                <h5 class="mb-0">All CA Professionals</h5>
                <div class="flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" onclick="filterStatus('all')">All</button>
                    <button class="btn btn-sm btn-success" onclick="filterStatus('Active')">Active</button>
                    <button class="btn btn-sm btn-warning" onclick="filterStatus('Pending')">Pending</button>
                    <button class="btn btn-sm btn-danger" onclick="filterStatus('Suspended')">Suspended</button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="caListTable" class="table table-hover" style="width:100%">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>CA Name</th>
                                <th>Designation</th>
                                <th>Membership No.</th>
                                <th>Specialisations</th>
                                <th>City</th>
                                <th>Exp (yrs)</th>
                                <th>Cases</th>
                                <th>Rating</th>
                                <th>Joined</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ca in cas)
                            {
                                <tr data-status="@ca.Status">
                                    <td>@ca.Id</td>
                                    <td>
                                        <div class="flex items-center gap-2">
                                            <div class="w-8 h-8 rounded-full bg-primary-500 flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
                                                @ca.Initials
                                            </div>
                                            <span class="font-medium">@ca.Name</span>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-primary-100 text-primary-700">@ca.Designation</span></td>
                                    <td class="text-sm text-muted">@ca.MembershipNo</td>
                                    <td>
                                        @foreach (var tag in ca.Specialisations.Take(2))
                                        {
                                            <span class="badge bg-secondary me-1 mb-1">@tag</span>
                                        }
                                        @if (ca.Specialisations.Length > 2)
                                        {
                                            <span class="badge bg-light text-muted">+@(ca.Specialisations.Length - 2)</span>
                                        }
                                    </td>
                                    <td>@ca.City</td>
                                    <td>@ca.YearsExp</td>
                                    <td>@ca.CasesHandled+</td>
                                    <td>
                                        <span class="text-warning-500 font-medium">⭐ @ca.Rating</span>
                                    </td>
                                    <td class="text-sm">@ca.JoinedOn.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @switch (ca.Status)
                                        {
                                            case "Active":
                                                <span class="badge bg-success-500 text-white">Active</span>
                                                break;
                                            case "Pending":
                                                <span class="badge bg-warning-500 text-white">Pending</span>
                                                break;
                                            case "Suspended":
                                                <span class="badge bg-danger-500 text-white">Suspended</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <div class="flex gap-1">
                                            <button class="btn btn-sm btn-outline-primary" title="View Profile">
                                                <i data-feather="eye" class="w-3 h-3"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-warning" title="Edit">
                                                <i data-feather="edit-2" class="w-3 h-3"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" title="Suspend">
                                                <i data-feather="slash" class="w-3 h-3"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script>
        var table;
        $(function () {
            table = $('#caListTable').DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                order: [[9, 'desc']],
                responsive: true,
                columnDefs: [{ orderable: false, targets: [11] }]
            });

            if (typeof feather !== 'undefined') feather.replace();
        });

        function filterStatus(status) {
            if (status === 'all') {
                table.column(10).search('').draw();
            } else {
                table.column(10).search(status).draw();
            }
        }
    </script>
}
