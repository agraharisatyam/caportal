@using caportal.Models
@{
    ViewData["Title"] = "Clients";
    var clients = ViewBag.Clients as List<Client> ?? new List<Client>();
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-block">
        <div class="page-header-title">
            <h5 class="mb-0 font-medium">Registered Clients</h5>
        </div>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="/ajs">Home</a></li>
            <li class="breadcrumb-item" aria-current="page">Clients</li>
        </ul>
    </div>
</div>

<!-- KPI Cards -->
<div class="grid grid-cols-12 gap-x-6 mb-4">
    <div class="col-span-12 xl:col-span-3 md:col-span-6">
        <div class="card">
            <div class="card-body">
                <div class="flex items-center justify-between mb-2">
                    <div>
                        <p class="text-muted text-sm mb-1">Total Clients</p>
                        <h3 class="font-semibold mb-0">@ViewBag.TotalClients</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-primary-500 flex items-center justify-center text-white text-xl">
                        <i data-feather="briefcase"></i>
                    </div>
                </div>
                <p class="text-success-500 text-sm mb-0"><i data-feather="trending-up" class="inline w-4 h-4 me-1"></i> Growing steadily</p>
            </div>
        </div>
    </div>
    <div class="col-span-12 xl:col-span-3 md:col-span-6">
        <div class="card">
            <div class="card-body">
                <div class="flex items-center justify-between mb-2">
                    <div>
                        <p class="text-muted text-sm mb-1">Active Clients</p>
                        <h3 class="font-semibold mb-0">@ViewBag.ActiveClients</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-success-500 flex items-center justify-center text-white text-xl">
                        <i data-feather="check-circle"></i>
                    </div>
                </div>
                <p class="text-success-500 text-sm mb-0"><i data-feather="trending-up" class="inline w-4 h-4 me-1"></i> +@ViewBag.ActiveClients active now</p>
            </div>
        </div>
    </div>
    <div class="col-span-12 xl:col-span-3 md:col-span-6">
        <div class="card">
            <div class="card-body">
                <div class="flex items-center justify-between mb-2">
                    <div>
                        <p class="text-muted text-sm mb-1">Pending</p>
                        <h3 class="font-semibold mb-0">@ViewBag.PendingClients</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-warning-500 flex items-center justify-center text-white text-xl">
                        <i data-feather="clock"></i>
                    </div>
                </div>
                <p class="text-warning-500 text-sm mb-0"><i data-feather="alert-circle" class="inline w-4 h-4 me-1"></i> Awaiting onboarding</p>
            </div>
        </div>
    </div>
    <div class="col-span-12 xl:col-span-3 md:col-span-6">
        <div class="card">
            <div class="card-body">
                <div class="flex items-center justify-between mb-2">
                    <div>
                        <p class="text-muted text-sm mb-1">Top Client Type</p>
                        @{ var topType = clients.GroupBy(c => c.Type).OrderByDescending(g => g.Count()).FirstOrDefault(); }
                        <h3 class="font-semibold mb-0">@(topType?.Key ?? "—")</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-danger-500 flex items-center justify-center text-white text-xl">
                        <i data-feather="pie-chart"></i>
                    </div>
                </div>
                <p class="text-muted text-sm mb-0">@(topType?.Count() ?? 0) clients in this category</p>
            </div>
        </div>
    </div>
</div>

<!-- Clients Table -->
<div class="grid grid-cols-12 gap-x-6">
    <div class="col-span-12">
        <div class="card">
            <div class="card-header flex items-center justify-between flex-wrap gap-2">
                <h5 class="mb-0">All Clients</h5>
                <div class="flex gap-2 flex-wrap">
                    <button class="btn btn-sm btn-outline-secondary" onclick="filterType('all')">All</button>
                    @foreach (var type in new[]{"Corporate","Startup","SME","Individual"})
                    {
                        <button class="btn btn-sm btn-outline-primary" onclick="filterType('@type')">@type</button>
                    }
                    <button class="btn btn-sm btn-primary ms-2">
                        <i data-feather="plus" class="inline w-3 h-3 me-1"></i> Add Client
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="clientTable" class="table table-hover" style="width:100%">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Company / Name</th>
                                <th>Type</th>
                                <th>Contact</th>
                                <th>City</th>
                                <th>CA Assigned</th>
                                <th>Service</th>
                                <th>Registered</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in clients)
                            {
                                <tr>
                                    <td>@c.Id</td>
                                    <td>
                                        <div class="flex items-center gap-2">
                                            <div class="w-8 h-8 rounded-full bg-primary-100 flex items-center justify-center text-primary-700 text-xs font-bold flex-shrink-0">
                                                @string.Concat(c.CompanyName.Split(' ').Take(2).Select(w => w[0]))
                                            </div>
                                            <span class="font-medium">@c.CompanyName</span>
                                        </div>
                                    </td>
                                    <td>
                                        @{
                                            var typeColor = c.Type switch {
                                                "Corporate"  => "bg-primary-500",
                                                "Startup"    => "bg-purple-500",
                                                "SME"        => "bg-teal-500",
                                                "Individual" => "bg-orange-500",
                                                _            => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @typeColor text-white">@c.Type</span>
                                    </td>
                                    <td class="text-sm text-muted">
                                        <a href="mailto:@c.ContactEmail" class="text-muted">@c.ContactEmail</a>
                                    </td>
                                    <td>@c.City</td>
                                    <td class="text-sm">@c.AssignedCA</td>
                                    <td><span class="badge bg-secondary">@c.Service</span></td>
                                    <td class="text-sm">@c.RegisteredOn.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @switch (c.Status)
                                        {
                                            case "Active":
                                                <span class="badge bg-success-500 text-white">Active</span>
                                                break;
                                            case "Pending":
                                                <span class="badge bg-warning-500 text-white">Pending</span>
                                                break;
                                            case "Inactive":
                                                <span class="badge bg-danger-500 text-white">Inactive</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <div class="flex gap-1">
                                            <button class="btn btn-sm btn-outline-primary" title="View">
                                                <i data-feather="eye" class="w-3 h-3"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-warning" title="Edit">
                                                <i data-feather="edit-2" class="w-3 h-3"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" title="Remove">
                                                <i data-feather="trash-2" class="w-3 h-3"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script>
        var table;
        $(function () {
            table = $('#clientTable').DataTable({
                pageLength: 10,
                lengthMenu: [10, 25, 50],
                order: [[7, 'desc']],
                responsive: true,
                columnDefs: [{ orderable: false, targets: [9] }],
                language: { search: "Search Clients:" }
            });
            if (typeof feather !== 'undefined') feather.replace();
        });

        function filterType(type) {
            if (type === 'all') { table.column(2).search('').draw(); }
            else { table.column(2).search(type).draw(); }
        }
    </script>
}
