@using caportal.Models
@{
    ViewData["Title"] = "Dashboard";
    var recentCAs = (ViewBag.RecentCAs as List<CaProfessional>) ?? new List<CaProfessional>();
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-block">
        <div class="flex items-center gap-4 mb-1">
            @{
                var dashSvc = Context.RequestServices.GetService(typeof(caportal.Services.SiteSettingsService)) as caportal.Services.SiteSettingsService;
                var dashSettings = dashSvc?.Get();
                var dashLogo = dashSettings?.LogoPath;
                var dashSiteName = dashSettings?.SiteName ?? "CACampus";
            }
            @if (!string.IsNullOrEmpty(dashLogo))
            {
                <img src="@dashLogo" alt="@(dashSettings?.LogoAlt ?? dashSiteName)" style="max-height:44px;max-width:140px;object-fit:contain;" />
            }
            <div class="page-header-title">
                <h5 class="mb-0 font-medium">Welcome back, @ViewBag.Username 👋</h5>
            </div>
        </div>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="/ajs">Home</a></li>
            <li class="breadcrumb-item" aria-current="page">Dashboard</li>
        </ul>
    </div>
</div>

<!-- ── 8 KPI Cards Grid (3 cards per row) ── -->
<div class="grid grid-cols-12 gap-x-6 mb-2">
    <!-- Today's Revenue -->
    <div class="col-span-12 sm:col-span-6 md:col-span-4 mb-4">
        <div class="card h-full">
            <div class="card-body">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-muted text-sm mb-1">Today's Revenue</p>
                        <h3 class="font-semibold mb-0 text-white">@ViewBag.TodayRevenue</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-success-500 flex items-center justify-center text-white text-xl">
                        <i data-feather="dollar-sign"></i>
                    </div>
                </div>
                <p class="text-success-500 text-sm mb-0">
                    <i data-feather="trending-up" class="inline w-4 h-4 me-1"></i>
                    +12.5% <span class="text-muted">from last month</span>
                </p>
            </div>
        </div>
    </div>
    <!-- Today's Sales -->
    <div class="col-span-12 sm:col-span-6 md:col-span-4 mb-4">
        <div class="card h-full">
            <div class="card-body">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-muted text-sm mb-1">Today's Sales</p>
                        <h3 class="font-semibold mb-0 text-white">@ViewBag.TodaySales</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-primary-500 flex items-center justify-center text-white text-xl">
                        <i data-feather="shopping-cart"></i>
                    </div>
                </div>
                <p class="text-success-500 text-sm mb-0">
                    <i data-feather="trending-up" class="inline w-4 h-4 me-1"></i>
                    +8.3% <span class="text-muted">from yesterday</span>
                </p>
            </div>
        </div>
    </div>
    <!-- Total Leads -->
    <div class="col-span-12 sm:col-span-6 md:col-span-4 mb-4">
        <div class="card h-full">
            <div class="card-body">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-muted text-sm mb-1">Total Leads</p>
                        <h3 class="font-semibold mb-0 text-white">@ViewBag.TotalLeads</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-info-500 flex items-center justify-center text-white text-xl">
                        <i data-feather="target"></i>
                    </div>
                </div>
                <p class="text-success-500 text-sm mb-0">
                    <i data-feather="trending-up" class="inline w-4 h-4 me-1"></i>
                    +15.7% <span class="text-muted">from last month</span>
                </p>
            </div>
        </div>
    </div>
    <!-- Total Orders -->
    <div class="col-span-12 sm:col-span-6 md:col-span-4 mb-4">
        <div class="card h-full">
            <div class="card-body">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-muted text-sm mb-1">Total Orders</p>
                        <h3 class="font-semibold mb-0 text-white">@ViewBag.TotalOrders</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-danger-500 flex items-center justify-center text-white text-xl">
                        <i data-feather="shopping-bag"></i>
                    </div>
                </div>
                <p class="text-success-500 text-sm mb-0">
                    <i data-feather="trending-up" class="inline w-4 h-4 me-1"></i>
                    +10.0% <span class="text-muted">from last month</span>
                </p>
            </div>
        </div>
    </div>
    <!-- Active CAs -->
    <div class="col-span-12 sm:col-span-6 md:col-span-4 mb-4">
        <div class="card h-full">
            <div class="card-body">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-muted text-sm mb-1">Active CAs</p>
                        <h3 class="font-semibold mb-0 text-white">@ViewBag.ActiveCAs</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-success-500 flex items-center justify-center text-white text-xl">
                        <i data-feather="users"></i>
                    </div>
                </div>
                <p class="text-danger-500 text-sm mb-0">
                    <i data-feather="trending-down" class="inline w-4 h-4 me-1"></i>
                    -4.2% <span class="text-muted">from last month</span>
                </p>
            </div>
        </div>
    </div>
    <!-- Total Customers -->
    <div class="col-span-12 sm:col-span-6 md:col-span-4 mb-4">
        <div class="card h-full">
            <div class="card-body">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-muted text-sm mb-1">Total Customers</p>
                        <h3 class="font-semibold mb-0 text-white">@ViewBag.TotalCustomers</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-primary-500 flex items-center justify-center text-white text-xl">
                        <i data-feather="user-check"></i>
                    </div>
                </div>
                <p class="text-success-500 text-sm mb-0">
                    <i data-feather="trending-up" class="inline w-4 h-4 me-1"></i>
                    +11.4% <span class="text-muted">from last month</span>
                </p>
            </div>
        </div>
    </div>
    <!-- Pending Documents -->
    <div class="col-span-12 sm:col-span-6 md:col-span-4 mb-4">
        <div class="card h-full">
            <div class="card-body">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-muted text-sm mb-1">Pending Documents</p>
                        <h3 class="font-semibold mb-0 text-white">@ViewBag.PendingDocuments</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-warning-500 flex items-center justify-center text-white text-xl">
                        <i data-feather="file-text"></i>
                    </div>
                </div>
                <p class="text-success-500 text-sm mb-0">
                    <i data-feather="trending-up" class="inline w-4 h-4 me-1"></i>
                    +8.9% <span class="text-muted">from last month</span>
                </p>
            </div>
        </div>
    </div>
    <!-- Today's Appointments -->
    <div class="col-span-12 sm:col-span-6 md:col-span-4 mb-4">
        <div class="card h-full">
            <div class="card-body">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-muted text-sm mb-1">Today's Appointments</p>
                        <h3 class="font-semibold mb-0 text-white">@ViewBag.TodayAppointments</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-danger-500 flex items-center justify-center text-white text-xl">
                        <i data-feather="calendar"></i>
                    </div>
                </div>
                <p class="text-success-500 text-sm mb-0">
                    <i data-feather="trending-up" class="inline w-4 h-4 me-1"></i>
                    +3.2% <span class="text-muted">from yesterday</span>
                </p>
            </div>
        </div>
    </div>
</div>

<!-- ── Charts Row ── -->
<div class="grid grid-cols-12 gap-x-6 mb-4">
    <!-- Revenue Overview Line Chart -->
    <div class="col-span-12 xl:col-span-8 mb-4">
        <div class="card h-full">
            <div class="card-header flex items-center justify-between">
                <h5 class="mb-0">Revenue Overview</h5>
                <select class="form-select form-select-sm" style="max-width:120px;">
                    <option>This Year</option>
                    <option>Last Year</option>
                </select>
            </div>
            <div class="card-body">
                <div id="revenue-chart"></div>
            </div>
        </div>
    </div>
    <!-- Leads Source Donut Chart -->
    <div class="col-span-12 xl:col-span-4 mb-4">
        <div class="card h-full">
            <div class="card-header">
                <h5 class="mb-0">Leads Source</h5>
            </div>
            <div class="card-body flex items-center justify-center">
                <div id="leads-chart" style="width:100%;"></div>
            </div>
        </div>
    </div>
</div>

<!-- ── Recent Orders & Payments Overview ── -->
<div class="grid grid-cols-12 gap-x-6 mb-4">
    <!-- Recent Orders Table -->
    <div class="col-span-12 xl:col-span-8 mb-4">
        <div class="card h-full">
            <div class="card-header flex items-center justify-between">
                <h5 class="mb-0">Recent Orders</h5>
                <a href="#!" class="text-primary text-sm font-semibold">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" style="vertical-align: middle;">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Service</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var recentOrders = (ViewBag.RecentOrders as List<caportal.Models.DashboardOrder>) ?? new List<caportal.Models.DashboardOrder>();
                            }
                            @foreach (var order in recentOrders)
                            {
                                <tr>
                                    <td><span class="font-semibold text-white">@order.OrderId</span></td>
                                    <td>@order.Customer</td>
                                    <td>@order.Service</td>
                                    <td class="font-semibold text-white">@order.Amount</td>
                                    <td>
                                        <span class="badge @order.ColorClass-500 text-white">@order.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <!-- Payments Overview Donut Chart -->
    <div class="col-span-12 xl:col-span-4 mb-4">
        <div class="card h-full">
            <div class="card-header">
                <h5 class="mb-0">Payments Overview</h5>
            </div>
            <div class="card-body flex items-center justify-center">
                <div id="payments-chart" style="width:100%;"></div>
            </div>
        </div>
    </div>
</div>

<!-- ── Bottom Performance Metrics ── -->
<div class="grid grid-cols-12 gap-x-6 mb-4">
    <!-- Conversion Rate -->
    <div class="col-span-12 md:col-span-3 mb-4">
        <div class="card">
            <div class="card-body text-center py-4">
                <p class="text-muted text-sm mb-1">Conversion Rate</p>
                <h3 class="font-semibold mb-1 text-white">@ViewBag.ConversionRate</h3>
                <span class="text-success-500 text-xs font-semibold"><i data-feather="trending-up" class="inline w-3 h-3 me-0.5"></i> +4.6%</span>
            </div>
        </div>
    </div>
    <!-- Avg. Order Value -->
    <div class="col-span-12 md:col-span-3 mb-4">
        <div class="card">
            <div class="card-body text-center py-4">
                <p class="text-muted text-sm mb-1">Avg. Order Value</p>
                <h3 class="font-semibold mb-1 text-white">@ViewBag.AvgOrderValue</h3>
                <span class="text-success-500 text-xs font-semibold"><i data-feather="trending-up" class="inline w-3 h-3 me-0.5"></i> +7.3%</span>
            </div>
        </div>
    </div>
    <!-- Customer Satisfaction -->
    <div class="col-span-12 md:col-span-3 mb-4">
        <div class="card">
            <div class="card-body text-center py-4">
                <p class="text-muted text-sm mb-1">Customer Satisfaction</p>
                <h3 class="font-semibold mb-1 text-white">@ViewBag.CustomerSatisfaction</h3>
                <span class="text-success-500 text-xs font-semibold"><i data-feather="trending-up" class="inline w-3 h-3 me-0.5"></i> +0.2</span>
            </div>
        </div>
    </div>
    <!-- Repeat Customers -->
    <div class="col-span-12 md:col-span-3 mb-4">
        <div class="card">
            <div class="card-body text-center py-4">
                <p class="text-muted text-sm mb-1">Repeat Customers</p>
                <h3 class="font-semibold mb-1 text-white">@ViewBag.RepeatCustomers</h3>
                <span class="text-success-500 text-xs font-semibold"><i data-feather="trending-up" class="inline w-3 h-3 me-0.5"></i> +6.1%</span>
            </div>
        </div>
    </div>
</div>

<!-- ── Recent CA Registrations ── -->
<div class="grid grid-cols-12 gap-x-6 mt-2">
    <div class="col-span-12">
        <div class="card">
            <div class="card-header flex items-center justify-between">
                <h5 class="mb-0 text-white">Recent CA Registrations</h5>
                <a href="/Admin/Dashboard/CaList" class="btn btn-sm btn-primary">View All CAs</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="dashRecentTable" class="table table-hover" style="width:100%">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>CA Name</th>
                                <th>Membership No.</th>
                                <th>Specialisation</th>
                                <th>City</th>
                                <th>Rating</th>
                                <th>Joined</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ca in recentCAs)
                            {
                                <tr>
                                    <td>@ca.Id</td>
                                    <td>@ca.Name</td>
                                    <td>@ca.MembershipNo</td>
                                    <td>@string.Join(", ", ca.Specialisations.Take(2))</td>
                                    <td>@ca.City</td>
                                    <td>⭐ @ca.Rating</td>
                                    <td>@ca.JoinedOn.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @switch (ca.Status)
                                        {
                                            case "Active":
                                                <span class="badge bg-success-500 text-white">Active</span>
                                                break;
                                            case "Pending":
                                                <span class="badge bg-warning-500 text-white">Pending</span>
                                                break;
                                            case "Suspended":
                                                <span class="badge bg-danger-500 text-white">Suspended</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary text-white">@ca.Status</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    
    <!-- ApexCharts Library for modern UI charts -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    
    <script>
        $(function () {
            $('#dashRecentTable').DataTable({ pageLength: 5, lengthMenu: [5,10,25], order: [[6,'desc']], responsive: true });

            // Initialize theme-dependent styling colors
            var isDark = $('html').attr('data-pc-theme') === 'dark';
            var textCol = isDark ? '#a0aec0' : '#4a5568';
            var borderCol = isDark ? 'rgba(212,175,55,0.08)' : 'rgba(0,0,0,0.05)';

            // Apex Line Chart: Revenue Overview
            var optionsRevenue = {
                chart: { type: 'line', height: 280, toolbar: { show: false }, background: 'transparent' },
                stroke: { curve: 'smooth', width: 3, colors: ['#d4a017'] },
                series: [{ name: 'Revenue', data: [1000000, 1500000, 1200000, 2200000, 1800000, 2458760] }],
                xaxis: { categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'], labels: { style: { colors: textCol } } },
                yaxis: { labels: { formatter: function(val) { return '₹ ' + (val/100000).toFixed(0) + 'L'; }, style: { colors: textCol } } },
                grid: { borderColor: borderCol },
                theme: { mode: isDark ? 'dark' : 'light' },
                markers: { size: 5, colors: ['#d4a017'], strokeColors: isDark ? '#111216' : '#ffffff', strokeWidth: 2 }
            };
            var revChart = new ApexCharts(document.querySelector("#revenue-chart"), optionsRevenue);
            revChart.render();

            // Apex Donut Chart: Leads Source
            var optionsLeads = {
                chart: { type: 'donut', height: 260 },
                series: [528, 315, 226, 126, 63],
                labels: ['Website', 'Direct', 'Google', 'Social Media', 'Other'],
                colors: ['#d4a017', '#f0c040', '#28a745', '#17a2b8', '#6c757d'],
                plotOptions: {
                    pie: {
                        donut: {
                            labels: {
                                show: true,
                                name: { show: true, color: textCol },
                                value: { show: true, color: isDark ? '#ffffff' : '#111111', formatter: function(val) { return val; } },
                                total: { show: true, label: 'Total Leads', color: textCol, formatter: function(w) { return '1,258'; } }
                            }
                        }
                    }
                },
                legend: { show: true, position: 'bottom', labels: { colors: textCol } },
                theme: { mode: isDark ? 'dark' : 'light' }
            };
            var leadsChart = new ApexCharts(document.querySelector("#leads-chart"), optionsLeads);
            leadsChart.render();

            // Apex Donut Chart: Payments Overview
            var optionsPayments = {
                chart: { type: 'donut', height: 260 },
                series: [75, 20, 5],
                labels: ['Paid', 'Pending', 'Failed'],
                colors: ['#28a745', '#ffc107', '#dc3545'],
                plotOptions: {
                    pie: {
                        donut: {
                            labels: {
                                show: true,
                                name: { show: true, color: textCol },
                                value: { show: true, color: isDark ? '#ffffff' : '#111111', formatter: function(val) { return val + '%'; } },
                                total: { show: true, label: 'Paid', color: '#28a745', formatter: function(w) { return '75%'; } }
                            }
                        }
                    }
                },
                legend: { show: true, position: 'bottom', labels: { colors: textCol } },
                theme: { mode: isDark ? 'dark' : 'light' }
            };
            var payChart = new ApexCharts(document.querySelector("#payments-chart"), optionsPayments);
            payChart.render();

            // Event listener to re-render charts nicely when layout change occurs
            var original_layout_change = window.layout_change;
            window.layout_change = function(theme) {
                if (typeof original_layout_change === 'function') {
                    original_layout_change(theme);
                }
                var newIsDark = theme === 'dark';
                var newTextCol = newIsDark ? '#a0aec0' : '#4a5568';
                var newBorderCol = newIsDark ? 'rgba(212,175,55,0.08)' : 'rgba(0,0,0,0.05)';
                
                revChart.updateOptions({
                    xaxis: { labels: { style: { colors: newTextCol } } },
                    yaxis: { labels: { style: { colors: newTextCol } } },
                    grid: { borderColor: newBorderCol },
                    theme: { mode: theme }
                });
                leadsChart.updateOptions({
                    theme: { mode: theme },
                    legend: { labels: { colors: newTextCol } },
                    plotOptions: { pie: { donut: { labels: { name: { color: newTextCol }, value: { color: newIsDark ? '#ffffff' : '#111111' } } } } }
                });
                payChart.updateOptions({
                    theme: { mode: theme },
                    legend: { labels: { colors: newTextCol } },
                    plotOptions: { pie: { donut: { labels: { name: { color: newTextCol }, value: { color: newIsDark ? '#ffffff' : '#111111' } } } } }
                });
            };
        });
    </script>
}
