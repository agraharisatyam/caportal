@using caportal.Models
@{
    ViewData["Title"] = "Dashboard";
    var recentCAs = (ViewBag.RecentCAs as List<CaProfessional>) ?? new List<CaProfessional>();
    var recentOrders = (ViewBag.RecentOrders as List<caportal.Models.Entities.DashboardOrder>) ?? new List<caportal.Models.Entities.DashboardOrder>();
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="page-block">

        <div>
            <h4 class="mb-0 font-weight-bold text-black">Dashboard Overview</h4>
        </div>
        <ul class="breadcrumb mb-3">
            <li class="breadcrumb-item"><a href="/ajs">Admin Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
        </ul>

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
          
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="/Admin/Services" class="btn btn-primary btn-sm"><i data-feather="plus" class="me-1"></i> Add Service</a>
            </div>
        </div>
    </div>
</div>

<!-- ── 8 KPI Cards Grid (Primary & Secondary Metrics) ── -->
<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-x-6 gap-y-4 mb-4">
    <!-- Today's Revenue -->
    <div class="card h-100">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div>
                    <span class="text-muted small d-block mb-1">Today's Revenue</span>
                    <h4 class="font-weight-bold mb-0 text-white">@ViewBag.TodayRevenue</h4>
                </div>
                <div class="w-12 h-12 rounded-circle bg-success-500 d-flex align-items-center justify-content-center text-white">
                    <i data-feather="dollar-sign"></i>
                </div>
            </div>
            <div class="d-flex align-items-center text-success small font-weight-bold">
                <i data-feather="trending-up" class="me-1" style="width:14px;height:14px;"></i>
                +12.5% <span class="text-muted ms-1 font-weight-normal">vs last month</span>
            </div>
        </div>
    </div>
    <!-- Today's Sales -->
    <div class="card h-100">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div>
                    <span class="text-muted small d-block mb-1">Today's Sales</span>
                    <h4 class="font-weight-bold mb-0 text-white">@ViewBag.TodaySales</h4>
                </div>
                <div class="w-12 h-12 rounded-circle bg-primary-500 d-flex align-items-center justify-content-center text-white">
                    <i data-feather="shopping-cart"></i>
                </div>
            </div>
            <div class="d-flex align-items-center text-success small font-weight-bold">
                <i data-feather="trending-up" class="me-1" style="width:14px;height:14px;"></i>
                +8.3% <span class="text-muted ms-1 font-weight-normal">vs yesterday</span>
            </div>
        </div>
    </div>
    <!-- Active CAs -->
    <div class="card h-100">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div>
                    <span class="text-muted small d-block mb-1">Active CAs</span>
                    <h4 class="font-weight-bold mb-0 text-white">@ViewBag.ActiveCAs <small class="text-muted" style="font-size:.75rem;">/ @ViewBag.TotalCAs Total</small></h4>
                </div>
                <div class="w-12 h-12 rounded-circle bg-warning-500 d-flex align-items-center justify-content-center text-white">
                    <i data-feather="users"></i>
                </div>
            </div>
            <div class="d-flex align-items-center text-success small font-weight-bold">
                <i data-feather="user-check" class="me-1" style="width:14px;height:14px;"></i>
                @ViewBag.PendingCAs Pending <span class="text-muted ms-1 font-weight-normal">approvals</span>
            </div>
        </div>
    </div>
    <!-- Total Orders -->
    <div class="card h-100">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div>
                    <span class="text-muted small d-block mb-1">Total Orders</span>
                    <h4 class="font-weight-bold mb-0 text-white">@ViewBag.TotalOrders</h4>
                </div>
                <div class="w-12 h-12 rounded-circle bg-danger-500 d-flex align-items-center justify-content-center text-white">
                    <i data-feather="shopping-bag"></i>
                </div>
            </div>
            <div class="d-flex align-items-center text-success small font-weight-bold">
                <i data-feather="trending-up" class="me-1" style="width:14px;height:14px;"></i>
                +10.0% <span class="text-muted ms-1 font-weight-normal">vs last month</span>
            </div>
        </div>
    </div>
    <!-- Total Leads -->
    <div class="card h-100">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div>
                    <span class="text-muted small d-block mb-1">Total Leads</span>
                    <h4 class="font-weight-bold mb-0 text-white">@ViewBag.TotalLeads</h4>
                </div>
                <div class="w-12 h-12 rounded-circle bg-primary-500 d-flex align-items-center justify-content-center text-white">
                    <i data-feather="target"></i>
                </div>
            </div>
            <div class="d-flex align-items-center text-success small font-weight-bold">
                <i data-feather="trending-up" class="me-1" style="width:14px;height:14px;"></i>
                +15.7% <span class="text-muted ms-1 font-weight-normal">conversion growth</span>
            </div>
        </div>
    </div>
    <!-- Total Customers -->
    <div class="card h-100">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div>
                    <span class="text-muted small d-block mb-1">Total Clients</span>
                    <h4 class="font-weight-bold mb-0 text-white">@ViewBag.TotalCustomers</h4>
                </div>
                <div class="w-12 h-12 rounded-circle bg-success-500 d-flex align-items-center justify-content-center text-white">
                    <i data-feather="user-check"></i>
                </div>
            </div>
            <div class="d-flex align-items-center text-success small font-weight-bold">
                <i data-feather="trending-up" class="me-1" style="width:14px;height:14px;"></i>
                +11.4% <span class="text-muted ms-1 font-weight-normal">registered businesses</span>
            </div>
        </div>
    </div>
    <!-- Pending Documents -->
    <div class="card h-100">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div>
                    <span class="text-muted small d-block mb-1">Pending Documents</span>
                    <h4 class="font-weight-bold mb-0 text-white">@ViewBag.PendingDocuments</h4>
                </div>
                <div class="w-12 h-12 rounded-circle bg-warning-500 d-flex align-items-center justify-content-center text-white">
                    <i data-feather="file-text"></i>
                </div>
            </div>
            <div class="d-flex align-items-center text-warning small font-weight-bold">
                <i data-feather="clock" class="me-1" style="width:14px;height:14px;"></i>
                Requires CA review
            </div>
        </div>
    </div>
    <!-- Today's Appointments -->
    <div class="card h-100">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div>
                    <span class="text-muted small d-block mb-1">Today's Appointments</span>
                    <h4 class="font-weight-bold mb-0 text-white">@ViewBag.TodayAppointments</h4>
                </div>
                <div class="w-12 h-12 rounded-circle bg-danger-500 d-flex align-items-center justify-content-center text-white">
                    <i data-feather="calendar"></i>
                </div>
            </div>
            <div class="d-flex align-items-center text-success small font-weight-bold">
                <i data-feather="check-circle" class="me-1" style="width:14px;height:14px;"></i>
                Scheduled consultations
            </div>
        </div>
    </div>
</div>

<!-- ── Charts Row ── -->
<div class="grid grid-cols-12 gap-x-6 gap-y-4 mb-4">
    <!-- Revenue Overview Line Chart -->
    <div class="col-span-12 lg:col-span-8">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0 text-gold"><i data-feather="bar-chart-2" class="me-1"></i> Revenue &amp; Growth Overview</h5>
                <select class="form-select form-select-sm" style="max-width:140px;">
                    <option>This Year (2026)</option>
                    <option>Last Year (2025)</option>
                </select>
            </div>
            <div class="card-body">
                <div id="revenue-chart"></div>
            </div>
        </div>
    </div>
    <!-- Leads Source Donut Chart -->
    <div class="col-span-12 lg:col-span-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="mb-0 text-gold"><i data-feather="pie-chart" class="me-1"></i> Lead Distribution</h5>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <div id="leads-chart" style="width:100%;"></div>
            </div>
        </div>
    </div>
</div>

<!-- ── Structured Tables Section (Orders & Payments) ── -->
<div class="grid grid-cols-12 gap-x-6 gap-y-4 mb-4">
    <!-- Recent Service Orders Table -->
    <div class="col-span-12 lg:col-span-8">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0 text-white"><i data-feather="list" class="me-1 text-gold"></i> Recent Orders</h5>
                <a href="#!" class="btn btn-sm btn-outline-primary"><i data-feather="eye" class="me-1"></i> View All Orders</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:110px;">Order ID</th>
                                <th>Client Name</th>
                                <th>Service Requested</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th class="text-center" style="width:90px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in recentOrders)
                            {
                                <tr>
                                    <td><span class="badge bg-dark border text-gold fw-bold">@order.OrderId</span></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="w-8 h-8 rounded-circle bg-primary-500 d-flex align-items-center justify-content-center text-gold text-xs font-weight-bold">
                                                <i data-feather="user" style="width:14px;height:14px;"></i>
                                            </div>
                                            <span class="font-weight-semibold text-white">@order.Customer</span>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-light text-dark">@order.Service</span></td>
                                    <td class="font-weight-bold text-success">@order.Amount</td>
                                    <td>
                                        @switch (order.Status)
                                        {
                                            case "Completed":
                                                <span class="badge bg-success text-white px-2 py-1"><i data-feather="check" class="me-1" style="width:12px;height:12px;"></i> Completed</span>
                                                break;
                                            case "Processing":
                                                <span class="badge bg-warning text-dark px-2 py-1"><i data-feather="loader" class="me-1" style="width:12px;height:12px;"></i> Processing</span>
                                                break;
                                            default:
                                                <span class="badge bg-info text-white px-2 py-1"><i data-feather="file" class="me-1" style="width:12px;height:12px;"></i> @order.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary px-2" title="Order Details">
                                            <i data-feather="arrow-right" style="width:14px;height:14px;"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <!-- Payments Overview Donut Chart -->
    <div class="col-span-12 lg:col-span-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="mb-0 text-gold"><i data-feather="credit-card" class="me-1"></i> Payment Settlement Status</h5>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <div id="payments-chart" style="width:100%;"></div>
            </div>
        </div>
    </div>
</div>

<!-- ── Structured Recent CA Registrations Table ── -->
<div class="grid grid-cols-12 gap-x-6 gap-y-4 mb-4">
    <div class="col-span-12">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <div>
                    <h5 class="mb-0 text-white"><i data-feather="award" class="me-1 text-gold"></i> Recent CA Professional Registrations</h5>
                    <span class="text-muted small">Manage ICAI verified Chartered Accountants and approvals</span>
                </div>
                <a href="/Admin/Dashboard/CaList" class="btn btn-sm btn-primary"><i data-feather="users" class="me-1"></i> View All CAs</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="dashRecentTable" class="table table-hover align-middle mb-0" style="width:100%">
                        <thead class="table-light">
                            <tr>
                                <th style="width:50px;">#</th>
                                <th>CA Professional</th>
                                <th>ICAI Reg. No.</th>
                                <th>Specialisations</th>
                                <th>City</th>
                                <th>Rating</th>
                                <th>Joined Date</th>
                                <th>Status</th>
                                <th class="text-center" style="width:110px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ca in recentCAs)
                            {
                                <tr>
                                    <td><span class="text-muted">#@ca.Id</span></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrEmpty(ca.ImagePath))
                                            {
                                                <img src="@ca.ImagePath" alt="@ca.Name" style="width:36px;height:36px;border-radius:50%;object-fit:cover;border:1.5px solid #d4a017;" />
                                            }
                                            else
                                            {
                                                <div class="w-9 h-9 rounded-circle bg-primary-500 d-flex align-items-center justify-content-center text-gold font-weight-bold text-xs">
                                                    @ca.Initials
                                                </div>
                                            }
                                            <div>
                                                <span class="font-weight-bold text-white d-block">@ca.Name</span>
                                                <span class="text-muted small">@ca.Designation &middot; @ca.YearsExp Yrs Exp</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-dark border text-muted">@ca.MembershipNo</span></td>
                                    <td>
                                        @foreach (var tag in ca.Specialisations.Take(2))
                                        {
                                            <span class="badge bg-primary-100 text-gold me-1">@tag</span>
                                        }
                                    </td>
                                    <td><span class="text-white"><i data-feather="map-pin" class="me-1 text-muted" style="width:12px;height:12px;"></i> @ca.City</span></td>
                                    <td><span class="text-warning font-weight-bold">⭐ @ca.Rating</span></td>
                                    <td><span class="text-muted small">@ca.JoinedOn.ToString("dd MMM yyyy")</span></td>
                                    <td>
                                        @switch (ca.Status)
                                        {
                                            case "Active":
                                                <span class="badge bg-success text-white">Active</span>
                                                break;
                                            case "Pending":
                                                <span class="badge bg-warning text-dark">Pending</span>
                                                break;
                                            case "Suspended":
                                                <span class="badge bg-danger text-white">Suspended</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary text-white">@ca.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex gap-1 justify-content-center">
                                            <a href="/expert/@(ca.Name.ToLower().Replace("ca ","").Replace(" ","-") + "-" + ca.Id)" class="btn btn-sm btn-outline-primary px-2" title="View Profile" target="_blank">
                                                <i data-feather="eye" style="width:14px;height:14px;"></i>
                                            </a>
                                            <a href="/Admin/Dashboard/CaList" class="btn btn-sm btn-outline-warning px-2" title="Manage Status">
                                                <i data-feather="edit-2" style="width:14px;height:14px;"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Bottom Performance Metrics Band ── -->
<div class="grid grid-cols-12 gap-x-6 gap-y-4 mb-4">
    <div class="col-span-12 sm:col-span-6 lg:col-span-3">
        <div class="card text-center">
            <div class="card-body py-3">
                <span class="text-muted small d-block mb-1">Conversion Rate</span>
                <h4 class="font-weight-bold mb-1 text-white">@ViewBag.ConversionRate</h4>
                <span class="text-success small font-weight-bold"><i data-feather="trending-up" style="width:12px;height:12px;"></i> +4.6%</span>
            </div>
        </div>
    </div>
    <div class="col-span-12 sm:col-span-6 lg:col-span-3">
        <div class="card text-center">
            <div class="card-body py-3">
                <span class="text-muted small d-block mb-1">Avg. Order Value</span>
                <h4 class="font-weight-bold mb-1 text-white">@ViewBag.AvgOrderValue</h4>
                <span class="text-success small font-weight-bold"><i data-feather="trending-up" style="width:12px;height:12px;"></i> +7.3%</span>
            </div>
        </div>
    </div>
    <div class="col-span-12 sm:col-span-6 lg:col-span-3">
        <div class="card text-center">
            <div class="card-body py-3">
                <span class="text-muted small d-block mb-1">Customer Satisfaction</span>
                <h4 class="font-weight-bold mb-1 text-white">@ViewBag.CustomerSatisfaction</h4>
                <span class="text-success small font-weight-bold"><i data-feather="star" style="width:12px;height:12px;"></i> Top Rated</span>
            </div>
        </div>
    </div>
    <div class="col-span-12 sm:col-span-6 lg:col-span-3">
        <div class="card text-center">
            <div class="card-body py-3">
                <span class="text-muted small d-block mb-1">Repeat Clients</span>
                <h4 class="font-weight-bold mb-1 text-white">@ViewBag.RepeatCustomers</h4>
                <span class="text-success small font-weight-bold"><i data-feather="refresh-cw" style="width:12px;height:12px;"></i> High Loyalty</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    
    <!-- ApexCharts Library for modern UI charts -->
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    
    <script>
        $(function () {
            $('#dashRecentTable').DataTable({ pageLength: 5, lengthMenu: [5,10,25], order: [[6,'desc']], responsive: true });

            var isDark = true;
            var textCol = '#a0aec0';
            var borderCol = 'rgba(212,175,55,0.12)';

            // Apex Line Chart: Revenue Overview
            var optionsRevenue = {
                chart: { type: 'area', height: 280, toolbar: { show: false }, background: 'transparent' },
                stroke: { curve: 'smooth', width: 3, colors: ['#d4a017'] },
                fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.45, opacityTo: 0.05, stops: [0, 90, 100], colorStops: [{ offset: 0, color: '#d4a017', opacity: 0.4 }, { offset: 100, color: '#d4a017', opacity: 0.0 }] } },
                series: [{ name: 'Revenue (₹)', data: [1000000, 1500000, 1200000, 2200000, 1800000, 2458760] }],
                xaxis: { categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'], labels: { style: { colors: textCol } } },
                yaxis: { labels: { formatter: function(val) { return '₹ ' + (val/100000).toFixed(0) + 'L'; }, style: { colors: textCol } } },
                grid: { borderColor: borderCol },
                theme: { mode: 'dark' },
                markers: { size: 5, colors: ['#d4a017'], strokeColors: '#111216', strokeWidth: 2 }
            };
            var revChart = new ApexCharts(document.querySelector("#revenue-chart"), optionsRevenue);
            revChart.render();

            // Apex Donut Chart: Leads Source
            var optionsLeads = {
                chart: { type: 'donut', height: 260 },
                series: [528, 315, 226, 126, 63],
                labels: ['Website', 'Direct', 'Google', 'Social Media', 'Other'],
                colors: ['#d4a017', '#f0c040', '#28a745', '#17a2b8', '#6c757d'],
                plotOptions: {
                    pie: {
                        donut: {
                            labels: {
                                show: true,
                                name: { show: true, color: textCol },
                                value: { show: true, color: '#ffffff', formatter: function(val) { return val; } },
                                total: { show: true, label: 'Total Leads', color: textCol, formatter: function(w) { return '1,258'; } }
                            }
                        }
                    }
                },
                legend: { show: true, position: 'bottom', labels: { colors: textCol } },
                theme: { mode: 'dark' }
            };
            var leadsChart = new ApexCharts(document.querySelector("#leads-chart"), optionsLeads);
            leadsChart.render();

            // Apex Donut Chart: Payments Overview
            var optionsPayments = {
                chart: { type: 'donut', height: 260 },
                series: [75, 20, 5],
                labels: ['Paid', 'Pending', 'Failed'],
                colors: ['#28a745', '#ffc107', '#dc3545'],
                plotOptions: {
                    pie: {
                        donut: {
                            labels: {
                                show: true,
                                name: { show: true, color: textCol },
                                value: { show: true, color: '#ffffff', formatter: function(val) { return val + '%'; } },
                                total: { show: true, label: 'Settled', color: '#28a745', formatter: function(w) { return '75%'; } }
                            }
                        }
                    }
                },
                legend: { show: true, position: 'bottom', labels: { colors: textCol } },
                theme: { mode: 'dark' }
            };
            var payChart = new ApexCharts(document.querySelector("#payments-chart"), optionsPayments);
            payChart.render();
        });
    </script>
}
