@using caportal.Models
@{
    ViewData["Title"] = "Dashboard";
    var recentCAs = (ViewBag.RecentCAs as List<CaProfessional>) ?? new List<CaProfessional>();
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-block">
        <div class="flex items-center gap-4 mb-1">
            @{
                var dashSvc = Context.RequestServices.GetService(typeof(caportal.Services.SiteSettingsService)) as caportal.Services.SiteSettingsService;
                var dashSettings = dashSvc?.Get();
                var dashLogo = dashSettings?.LogoPath;
                var dashSiteName = dashSettings?.SiteName ?? "CACampus";
            }
            @if (!string.IsNullOrEmpty(dashLogo))
            {
                <img src="@dashLogo" alt="@(dashSettings?.LogoAlt ?? dashSiteName)" style="max-height:44px;max-width:140px;object-fit:contain;" />
            }
            <div class="page-header-title">
                <h5 class="mb-0 font-medium">Welcome back, @ViewBag.Username 👋</h5>
            </div>
        </div>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="/ajs">Home</a></li>
            <li class="breadcrumb-item" aria-current="page">Dashboard</li>
        </ul>
    </div>
</div>

<!-- ── KPI Cards ── -->
<div class="grid grid-cols-12 gap-x-6">

    <div class="col-span-12 xl:col-span-3 md:col-span-6">
        <div class="card">
            <div class="card-body">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-muted text-sm mb-1">Total CAs</p>
                        <h3 class="font-semibold mb-0">@ViewBag.TotalCAs</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-primary-500 flex items-center justify-center text-white text-xl">
                        <i data-feather="users"></i>
                    </div>
                </div>
                <p class="text-success-500 text-sm mb-0">
                    <i data-feather="trending-up" class="inline w-4 h-4 me-1"></i>
                    +8.2% <span class="text-muted">this month</span>
                </p>
            </div>
        </div>
    </div>

    <div class="col-span-12 xl:col-span-3 md:col-span-6">
        <div class="card">
            <div class="card-body">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-muted text-sm mb-1">Active CAs</p>
                        <h3 class="font-semibold mb-0">@ViewBag.ActiveCAs</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-success-500 flex items-center justify-center text-white text-xl">
                        <i data-feather="check-circle"></i>
                    </div>
                </div>
                <p class="text-success-500 text-sm mb-0">
                    <i data-feather="trending-up" class="inline w-4 h-4 me-1"></i>
                    +12.5% <span class="text-muted">this month</span>
                </p>
            </div>
        </div>
    </div>

    <div class="col-span-12 xl:col-span-3 md:col-span-6">
        <div class="card">
            <div class="card-body">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-muted text-sm mb-1">Pending Approval</p>
                        <h3 class="font-semibold mb-0">@ViewBag.PendingCAs</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-warning-500 flex items-center justify-center text-white text-xl">
                        <i data-feather="clock"></i>
                    </div>
                </div>
                <p class="text-warning-500 text-sm mb-0">
                    <i data-feather="alert-circle" class="inline w-4 h-4 me-1"></i>
                    Awaiting review
                </p>
            </div>
        </div>
    </div>

    <div class="col-span-12 xl:col-span-3 md:col-span-6">
        <div class="card">
            <div class="card-body">
                <div class="flex items-center justify-between mb-3">
                    <div>
                        <p class="text-muted text-sm mb-1">Avg Rating</p>
                        <h3 class="font-semibold mb-0">⭐ @ViewBag.AvgRating</h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-danger-500 flex items-center justify-center text-white text-xl">
                        <i data-feather="star"></i>
                    </div>
                </div>
                <p class="text-success-500 text-sm mb-0">
                    <i data-feather="trending-up" class="inline w-4 h-4 me-1"></i>
                    Across all professionals
                </p>
            </div>
        </div>
    </div>

</div>

<!-- ── Progress Cards ── -->
<div class="grid grid-cols-12 gap-x-6 mt-2">
    <div class="col-span-12 xl:col-span-4 md:col-span-6">
        <div class="card">
            <div class="card-header !pb-0 !border-b-0"><h5>Active CAs</h5></div>
            <div class="card-body">
                <div class="flex items-center justify-between gap-3 flex-wrap">
                    <h3 class="font-light flex items-center mb-0">
                        <i class="feather icon-arrow-up text-success-500 text-[28px] mr-1"></i> @ViewBag.ActiveCAs
                    </h3>
                    <p class="mb-0 text-muted">@(ViewBag.TotalCAs > 0 ? (int)((double)ViewBag.ActiveCAs / (double)ViewBag.TotalCAs * 100) : 0)%</p>
                </div>
                @{ int activePercent = ViewBag.TotalCAs > 0 ? (int)((double)ViewBag.ActiveCAs / (double)ViewBag.TotalCAs * 100) : 0; }
                <div class="w-full bg-theme-bodybg rounded-lg h-1.5 mt-5">
                    <div class="bg-success-500 h-full rounded-lg" role="progressbar" style="width:@activePercent%"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-span-12 xl:col-span-4 md:col-span-6">
        <div class="card">
            <div class="card-header !pb-0 !border-b-0"><h5>Pending Approvals</h5></div>
            <div class="card-body">
                <div class="flex items-center justify-between gap-3 flex-wrap">
                    <h3 class="font-light flex items-center mb-0">
                        <i class="feather icon-clock text-warning-500 text-[28px] mr-1"></i> @ViewBag.PendingCAs
                    </h3>
                    <p class="mb-0 text-muted">@(ViewBag.TotalCAs > 0 ? (int)((double)ViewBag.PendingCAs / (double)ViewBag.TotalCAs * 100) : 0)%</p>
                </div>
                @{ int pendingPercent = ViewBag.TotalCAs > 0 ? (int)((double)ViewBag.PendingCAs / (double)ViewBag.TotalCAs * 100) : 0; }
                <div class="w-full bg-theme-bodybg rounded-lg h-1.5 mt-5">
                    <div class="bg-warning-500 h-full rounded-lg" role="progressbar" style="width:@pendingPercent%"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-span-12 xl:col-span-4">
        <div class="card">
            <div class="card-header !pb-0 !border-b-0"><h5>Suspended</h5></div>
            <div class="card-body">
                <div class="flex items-center justify-between gap-3 flex-wrap">
                    <h3 class="font-light flex items-center mb-0">
                        <i class="feather icon-alert-circle text-danger-500 text-[28px] mr-1"></i> @ViewBag.SuspendedCAs
                    </h3>
                    <p class="mb-0 text-muted">@(ViewBag.TotalCAs > 0 ? (int)((double)ViewBag.SuspendedCAs / (double)ViewBag.TotalCAs * 100) : 0)%</p>
                </div>
                @{ int suspendedPercent = ViewBag.TotalCAs > 0 ? (int)((double)ViewBag.SuspendedCAs / (double)ViewBag.TotalCAs * 100) : 0; }
                <div class="w-full bg-theme-bodybg rounded-lg h-1.5 mt-5">
                    <div class="bg-danger-500 h-full rounded-lg" role="progressbar" style="width:@suspendedPercent%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Recent CA Registrations ── -->
<div class="grid grid-cols-12 gap-x-6 mt-2">
    <div class="col-span-12">
        <div class="card">
            <div class="card-header flex items-center justify-between">
                <h5 class="mb-0">Recent CA Registrations</h5>
                <a href="/Admin/Dashboard/CaList" class="btn btn-sm btn-primary">View All</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="dashRecentTable" class="table table-hover" style="width:100%">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>CA Name</th>
                                <th>Membership No.</th>
                                <th>Specialisation</th>
                                <th>City</th>
                                <th>Rating</th>
                                <th>Joined</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ca in recentCAs)
                            {
                                <tr>
                                    <td>@ca.Id</td>
                                    <td>@ca.Name</td>
                                    <td>@ca.MembershipNo</td>
                                    <td>@string.Join(", ", ca.Specialisations.Take(2))</td>
                                    <td>@ca.City</td>
                                    <td>⭐ @ca.Rating</td>
                                    <td>@ca.JoinedOn.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @switch (ca.Status)
                                        {
                                            case "Active":
                                                <span class="badge bg-success-500 text-white">Active</span>
                                                break;
                                            case "Pending":
                                                <span class="badge bg-warning-500 text-white">Pending</span>
                                                break;
                                            case "Suspended":
                                                <span class="badge bg-danger-500 text-white">Suspended</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary text-white">@ca.Status</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            $('#dashRecentTable').DataTable({ pageLength: 5, lengthMenu: [5,10,25], order: [[6,'desc']], responsive: true });
        });
    </script>
}
