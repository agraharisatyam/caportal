@model List<caportal.Areas.Admin.Controllers.MediaFileItem>
@{
    Layout = "~/Areas/Admin/Views/Shared/_DattaLayout.cshtml";
    ViewData["Title"] = "Media Asset Library";
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="page-block">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-2">
            <div>
                <h4 class="mb-0 font-weight-bold text-black flex items-center"><i data-feather="image" class="me-2 text-black" style="display: inline-block !important; vertical-align: middle;"></i> <span>Media Asset Library</span></h4>
                <span class="text-muted small">Upload and manage graphic assets, logos, and images</span>
            </div>
        </div>
        <ul class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/ajs">Admin Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Media</li>
        </ul>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i data-feather="check-circle" class="me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i data-feather="alert-circle" class="me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="grid grid-cols-12 gap-x-6 gap-y-4">
    <!-- Upload Widget -->
    <div class="col-span-12 lg:col-span-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0 text-gold">Upload Media Asset</h5>
            </div>
            <div class="card-body">
                <form method="post" action="/Admin/Media/Upload" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Select Image / Graphic *</label>
                        <input type="file" name="file" class="form-control" accept=".png,.jpg,.jpeg,.svg,.webp,.gif" required />
                        <small class="text-muted mt-1 d-block text-xs">Supported formats: PNG, JPG, SVG, WebP, GIF (Max 10MB)</small>
                    </div>

                    <button type="submit" class="btn btn-primary w-100"><i data-feather="upload" class="me-1"></i> Upload Asset</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Assets Grid -->
    <div class="col-span-12 lg:col-span-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-white">Media Library Assets</h5>
                <span class="badge bg-primary">@Model.Count Assets</span>
            </div>
            <div class="card-body">
                @if (Model.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <p class="mb-0">No media assets uploaded yet.</p>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-4">
                        @foreach (var item in Model)
                        {
                            <div class="card mb-0 border">
                                <div class="card-body p-2 text-center h-100 flex flex-col justify-between">
                                    <div style="height: 120px; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #fff;" class="rounded mb-2">
                                        <img src="@item.RelativeUrl" alt="@item.FileName" style="max-height: 100%; max-width: 100%; object-fit: contain;" />
                                    </div>
                                    <div class="text-truncate font-weight-bold small text-white" title="@item.FileName">@item.FileName</div>
                                    <div class="small text-muted mb-2 text-xs">@(item.SizeBytes / 1024) KB &middot; @item.LastModified.ToString("dd MMM yyyy")</div>
                                    <div class="flex gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-secondary w-100 flex items-center justify-center text-xs" onclick="navigator.clipboard.writeText('@item.RelativeUrl'); alert('Copied URL: @item.RelativeUrl');">
                                            <i data-feather="copy" style="width:12px;height:12px;display:inline-block;margin-right:4px;"></i> Copy URL
                                        </button>
                                        <form method="post" action="/Admin/Media/Delete" class="d-inline" onsubmit="return confirm('Delete @item.FileName?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="relativeUrl" value="@item.RelativeUrl" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i data-feather="trash-2" style="width:12px;height:12px;display:inline-block;vertical-align:middle;"></i></button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
