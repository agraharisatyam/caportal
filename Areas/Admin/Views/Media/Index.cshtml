@model List<caportal.Areas.Admin.Controllers.MediaFileItem>
@{
    Layout = "~/Areas/Admin/Views/Shared/_DattaLayout.cshtml";
    ViewData["Title"] = "Media Asset Library";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    <!-- Upload Widget -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5>Upload Media Asset</h5>
            </div>
            <div class="card-body">
                <form method="post" action="/Admin/Media/Upload" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Image / Graphic *</label>
                        <input type="file" name="file" class="form-control" accept=".png,.jpg,.jpeg,.svg,.webp,.gif" required />
                        <small class="text-muted mt-1 d-block">Supported formats: PNG, JPG, SVG, WebP, GIF (Max 10MB)</small>
                    </div>

                    <button type="submit" class="btn btn-primary w-100"><i class="feather icon-upload me-1"></i>Upload Asset</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Assets Grid -->
    <div class="col-md-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5>Media Library Assets</h5>
                <span class="badge bg-primary">@Model.Count Assets</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var item in Model)
                    {
                        <div class="col-md-4 col-sm-6">
                            <div class="border rounded p-2 text-center h-100 bg-light position-relative">
                                <div style="height: 120px; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #fff;" class="rounded mb-2">
                                    <img src="@item.RelativeUrl" alt="@item.FileName" style="max-height: 100%; max-width: 100%; object-fit: contain;" />
                                </div>
                                <div class="text-truncate fw-bold small" title="@item.FileName">@item.FileName</div>
                                <div class="small text-muted mb-2">@(item.SizeBytes / 1024) KB &middot; @item.LastModified.ToString("dd MMM yyyy")</div>
                                <div class="btn-group btn-group-sm w-100">
                                    <button type="button" class="btn btn-outline-secondary" onclick="navigator.clipboard.writeText('@item.RelativeUrl'); alert('Copied URL: @item.RelativeUrl');">
                                        <i class="feather icon-copy me-1"></i>Copy URL
                                    </button>
                                    <form method="post" action="/Admin/Media/Delete" class="d-inline" onsubmit="return confirm('Delete @item.FileName?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="relativeUrl" value="@item.RelativeUrl" />
                                        <button type="submit" class="btn btn-outline-danger"><i class="feather icon-trash-2"></i></button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
