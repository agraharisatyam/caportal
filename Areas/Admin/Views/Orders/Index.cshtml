@model List<caportal.Models.Entities.DashboardOrder>
@{
    Layout = "~/Areas/Admin/Views/Shared/_DattaLayout.cshtml";
    ViewData["Title"] = "Orders & Revenue";
    var activeCAs = (ViewBag.ActiveCAs as List<string>) ?? new List<string>();
    var services = (ViewBag.CoveredServices as List<string>) ?? new List<string>();
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="page-block">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-2">
            <div>
                <h4 class="mb-0 font-weight-bold text-black flex items-center">
                    <i data-feather="shopping-cart" class="me-2 text-black" style="display: inline-block !important; vertical-align: middle;"></i> 
                    <span>Orders & Revenue Management</span>
                </h4>
                <span class="text-muted small">Track client service orders, milestone deliverables, payments, and CA engagements</span>
            </div>
            <div class="flex gap-2">
                <a href="/Admin/Orders/ExportCsv" class="btn btn-outline-success">
                    <i data-feather="download" class="me-1" style="width:14px;height:14px;display:inline-block;vertical-align:middle;"></i> Export CSV
                </a>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newOrderModal">
                    <i data-feather="plus" class="me-1" style="width:14px;height:14px;display:inline-block;vertical-align:middle;"></i> Create New Order
                </button>
            </div>
        </div>
        <ul class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/ajs">Admin Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Orders</li>
        </ul>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i data-feather="check-circle" class="me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i data-feather="alert-circle" class="me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- KPI Cards -->
<div class="grid grid-cols-12 gap-x-6 gap-y-4 mb-4">
    <div class="col-span-12 sm:col-span-6 lg:col-span-3">
        <div class="card text-center">
            <div class="card-body py-3">
                <h4 class="font-bold text-gold mb-0">₹ @(((decimal)ViewBag.TotalRevenue).ToString("N0"))</h4>
                <p class="text-muted text-sm mb-0">Total Gross Volume</p>
            </div>
        </div>
    </div>
    <div class="col-span-12 sm:col-span-6 lg:col-span-3">
        <div class="card text-center">
            <div class="card-body py-3">
                <h4 class="font-bold text-primary mb-0">@ViewBag.TotalOrders</h4>
                <p class="text-muted text-sm mb-0">Total Orders Placed</p>
            </div>
        </div>
    </div>
    <div class="col-span-12 sm:col-span-6 lg:col-span-3">
        <div class="card text-center">
            <div class="card-body py-3">
                <h4 class="font-bold text-success-600 mb-0">@ViewBag.CompletedOrders</h4>
                <p class="text-muted text-sm mb-0">Completed & Delivered</p>
            </div>
        </div>
    </div>
    <div class="col-span-12 sm:col-span-6 lg:col-span-3">
        <div class="card text-center">
            <div class="card-body py-3">
                <h4 class="font-bold text-warning-600 mb-0">@ViewBag.PendingOrders</h4>
                <p class="text-muted text-sm mb-0">In Progress / Pending</p>
            </div>
        </div>
    </div>
</div>

<!-- Orders Table -->
<div class="card">
    <div class="card-header flex items-center justify-between flex-wrap gap-2">
        <h5 class="mb-0 text-white"><i data-feather="list" class="me-2 text-gold"></i> Service Order Registry</h5>
        <div class="flex gap-2 flex-wrap">
            <a href="/Admin/Orders?status=All" class="btn btn-sm @(ViewBag.CurrentStatus == "All" ? "btn-primary" : "btn-outline-secondary")">All (@ViewBag.TotalOrders)</a>
            <a href="/Admin/Orders?status=Processing" class="btn btn-sm @(ViewBag.CurrentStatus == "Processing" ? "btn-warning" : "btn-outline-secondary")">Processing</a>
            <a href="/Admin/Orders?status=Document Pending" class="btn btn-sm @(ViewBag.CurrentStatus == "Document Pending" ? "btn-info" : "btn-outline-secondary")">Doc Pending</a>
            <a href="/Admin/Orders?status=Completed" class="btn btn-sm @(ViewBag.CurrentStatus == "Completed" ? "btn-success" : "btn-outline-secondary")">Completed</a>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="ordersTable" class="table table-hover align-middle mb-0" style="width:100%">
                <thead class="table-light">
                    <tr>
                        <th style="width:110px;">Order ID</th>
                        <th>Client Details</th>
                        <th>Service Package</th>
                        <th>Amount</th>
                        <th>Assigned CA</th>
                        <th>Status</th>
                        <th>Payment</th>
                        <th>Date</th>
                        <th class="text-center" style="width:100px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        var statusBadge = o.Status switch
                        {
                            "Completed" => "bg-success text-white",
                            "Document Pending" => "bg-info text-white",
                            "Processing" => "bg-warning text-dark",
                            _ => "bg-secondary text-white"
                        };

                        var payBadge = o.PaymentStatus switch
                        {
                            "Paid" => "bg-success-100 text-success-700 border border-success-200",
                            "Unpaid" => "bg-danger-100 text-danger-700 border border-danger-200",
                            "Refunded" => "bg-secondary text-white",
                            _ => "bg-warning-100 text-warning-700"
                        };

                        <tr>
                            <td><span class="badge bg-dark border text-gold font-monospace">@o.OrderId</span></td>
                            <td>
                                <div class="font-weight-bold text-white">@o.Customer</div>
                                @if (!string.IsNullOrEmpty(o.ClientPhone))
                                {
                                    <small class="text-muted d-block"><i data-feather="phone" style="width:10px;height:10px;display:inline-block;vertical-align:middle;"></i> @o.ClientPhone</small>
                                }
                                @if (!string.IsNullOrEmpty(o.ClientEmail))
                                {
                                    <small class="text-muted d-block"><i data-feather="mail" style="width:10px;height:10px;display:inline-block;vertical-align:middle;"></i> @o.ClientEmail</small>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark font-weight-bold">@o.Service</span></td>
                            <td><span class="font-weight-bold text-success">@o.Amount</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(o.AssignedCA) && o.AssignedCA != "Unassigned")
                                {
                                    <span class="text-white"><i data-feather="user-check" class="text-gold me-1" style="width:12px;height:12px;display:inline-block;vertical-align:middle;"></i> @o.AssignedCA</span>
                                }
                                else
                                {
                                    <span class="text-muted font-italic">Unassigned</span>
                                }
                            </td>
                            <td><span class="badge @statusBadge">@o.Status</span></td>
                            <td><span class="badge @payBadge">@o.PaymentStatus</span></td>
                            <td><small class="text-muted">@o.CreatedAt.ToString("dd MMM yyyy")</small></td>
                            <td class="text-center">
                                <div class="flex items-center justify-center gap-1">
                                    <button type="button" class="btn btn-xs btn-outline-warning" onclick="openEditOrderModal(@o.Id, '@o.OrderId', '@o.Customer', '@o.ClientEmail', '@o.ClientPhone', '@o.Service', @o.AmountValue, '@o.Status', '@o.PaymentStatus', '@o.AssignedCA')" title="Edit Order">
                                        <i data-feather="edit-2" style="width:12px;height:12px;display:inline-block;vertical-align:middle;"></i>
                                    </button>
                                    <form method="post" action="/Admin/Orders/Delete" onsubmit="return confirm('Delete order @o.OrderId?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@o.Id" />
                                        <button type="submit" class="btn btn-xs btn-outline-danger" title="Delete">
                                            <i data-feather="trash-2" style="width:12px;height:12px;display:inline-block;vertical-align:middle;"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Create New Order -->
<div class="modal fade" id="newOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-dark text-white border border-secondary">
            <form method="post" action="/Admin/Orders/Save">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="0" />
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-gold"><i data-feather="plus-circle" class="me-2"></i> Create New Client Order</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold">Client / Company Name *</label>
                            <input type="text" name="Customer" class="form-control" placeholder="e.g. Acme Innovations Pvt Ltd" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold">Service Requested *</label>
                            <input type="text" name="Service" class="form-control" placeholder="e.g. GST Filing, Company Incorporation" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold">Contact Email</label>
                            <input type="email" name="ClientEmail" class="form-control" placeholder="client@domain.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold">Contact Mobile Phone</label>
                            <input type="text" name="ClientPhone" class="form-control" placeholder="+91 98765 43210" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label font-weight-bold">Order Amount (₹) *</label>
                            <input type="number" name="AmountValue" class="form-control" placeholder="2499" min="0" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label font-weight-bold">Workflow Status *</label>
                            <select name="Status" class="form-select">
                                <option value="Processing">Processing</option>
                                <option value="Document Pending">Document Pending</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label font-weight-bold">Payment Status *</label>
                            <select name="PaymentStatus" class="form-select">
                                <option value="Paid">Paid</option>
                                <option value="Unpaid">Unpaid</option>
                                <option value="Refunded">Refunded</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label font-weight-bold">Assign to CA Professional</label>
                            <select name="AssignedCA" class="form-select">
                                <option value="Unassigned">-- Choose Verified CA --</option>
                                @foreach (var ca in activeCAs)
                                {
                                    <option value="@ca">@ca</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i data-feather="save" class="me-1"></i> Save & Generate Order</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Order -->
<div class="modal fade" id="editOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-dark text-white border border-secondary">
            <form method="post" action="/Admin/Orders/Save">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editOrderIdVal" />
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-gold"><i data-feather="edit" class="me-2"></i> Edit Order <span id="editOrderIdBadge" class="badge bg-primary font-monospace"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold">Client Name *</label>
                            <input type="text" name="Customer" id="editCustomer" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold">Service Package *</label>
                            <input type="text" name="Service" id="editService" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold">Contact Email</label>
                            <input type="email" name="ClientEmail" id="editEmail" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold">Contact Phone</label>
                            <input type="text" name="ClientPhone" id="editPhone" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label font-weight-bold">Amount (₹) *</label>
                            <input type="number" name="AmountValue" id="editAmount" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label font-weight-bold">Workflow Status *</label>
                            <select name="Status" id="editStatus" class="form-select">
                                <option value="Processing">Processing</option>
                                <option value="Document Pending">Document Pending</option>
                                <option value="Completed">Completed</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label font-weight-bold">Payment Status *</label>
                            <select name="PaymentStatus" id="editPaymentStatus" class="form-select">
                                <option value="Paid">Paid</option>
                                <option value="Unpaid">Unpaid</option>
                                <option value="Refunded">Refunded</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label font-weight-bold">Assigned CA</label>
                            <select name="AssignedCA" id="editAssignedCA" class="form-select">
                                <option value="Unassigned">-- Select CA --</option>
                                @foreach (var ca in activeCAs)
                                {
                                    <option value="@ca">@ca</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i data-feather="save" class="me-1"></i> Update Order</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            $('#ordersTable').DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                order: [[7, 'desc']],
                responsive: true,
                columnDefs: [{ orderable: false, targets: [8] }]
            });
            if (typeof feather !== 'undefined') feather.replace();
        });

        function openEditOrderModal(id, orderId, customer, email, phone, service, amount, status, payStatus, assignedCa) {
            $('#editOrderIdVal').val(id);
            $('#editOrderIdBadge').text(orderId);
            $('#editCustomer').val(customer);
            $('#editEmail').val(email);
            $('#editPhone').val(phone);
            $('#editService').val(service);
            $('#editAmount').val(amount);
            $('#editStatus').val(status);
            $('#editPaymentStatus').val(payStatus);
            $('#editAssignedCA').val(assignedCa);

            var editModal = new bootstrap.Modal(document.getElementById('editOrderModal'));
            editModal.show();
        }
    </script>
}
