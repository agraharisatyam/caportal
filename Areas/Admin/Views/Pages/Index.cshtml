@model List<caportal.Models.Entities.ContentPage>
@{
    Layout = "~/Areas/Admin/Views/Shared/_DattaLayout.cshtml";
    ViewData["Title"] = "Manage Content Pages";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5>Website Content Pages</h5>
        <span class="badge bg-primary">@Model.Count Pages</span>
    </div>
    <div class="card-body table-responsive">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Page Title</th>
                    <th>Slug / URL</th>
                    <th>Meta Description</th>
                    <th>Status</th>
                    <th>Last Updated</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Title</strong></td>
                        <td><code>/@item.Slug</code></td>
                        <td><small class="text-muted">@item.MetaDescription</small></td>
                        <td>
                            @if (item.IsPublished)
                            {
                                <span class="badge bg-success">Published</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Draft</span>
                            }
                        </td>
                        <td><small>@item.LastUpdated.ToString("dd MMM yyyy")</small></td>
                        <td>
                            <a href="/Admin/Pages/Edit/@item.Id" class="btn btn-xs btn-primary"><i class="feather icon-edit me-1"></i>Edit Page</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
