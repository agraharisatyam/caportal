@model List<caportal.Models.Entities.PricingPlanEntity>
@{
    Layout = "~/Areas/Admin/Views/Shared/_DattaLayout.cshtml";
    ViewData["Title"] = "Manage Pricing Plans";
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="page-block">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-2">
            <div>
                <h4 class="mb-0 font-weight-bold text-black flex items-center"><i data-feather="credit-card" class="me-2 text-black" style="display: inline-block !important; vertical-align: middle;"></i> <span>Manage Pricing Plans</span></h4>
                <span class="text-muted small">Configure pricing plans and subscription packages shown on the platform</span>
            </div>
        </div>
        <ul class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/ajs">Admin Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Pricing</li>
        </ul>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i data-feather="check-circle" class="me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i data-feather="alert-circle" class="me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="grid grid-cols-12 gap-x-6 gap-y-4">
    <!-- Add Pricing Plan Form -->
    <div class="col-span-12 lg:col-span-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0 text-gold">Add New Pricing Plan</h5>
            </div>
            <div class="card-body">
                <form method="post" action="/Admin/Pricing/Save">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Plan Name *</label>
                        <input type="text" name="planName" class="form-control" placeholder="e.g. Professional" required />
                    </div>

                    <div class="grid grid-cols-12 gap-x-3">
                        <div class="col-span-6 mb-3">
                            <label class="form-label font-weight-bold">Price Display *</label>
                            <input type="text" name="priceDisplay" class="form-control" placeholder="e.g. ₹ 1,499" required />
                        </div>
                        <div class="col-span-6 mb-3">
                            <label class="form-label font-weight-bold">Billing Cycle</label>
                            <input type="text" name="billingCycle" class="form-control" placeholder="e.g. /month" value="/month" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Description</label>
                        <input type="text" name="description" class="form-control" placeholder="Short summary" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Features (One per line) *</label>
                        <textarea name="featuresText" class="form-control" rows="4" placeholder="Feature 1&#10;Feature 2&#10;Feature 3" required></textarea>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" name="isPopular" class="form-check-input" id="isPopular" value="true" />
                        <label class="form-check-label font-weight-bold" for="isPopular">Highlight as Popular Plan</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100"><i data-feather="plus" class="me-1"></i> Add Plan</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Pricing Plans Table -->
    <div class="col-span-12 lg:col-span-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-white">Created Pricing Plans</h5>
                <span class="badge bg-primary">@Model.Count Plans</span>
            </div>
            <div class="card-body p-0">
                @if (Model.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <p class="mb-0">No pricing plans added yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:50px;">#</th>
                                    <th style="width:180px;">Plan Details</th>
                                    <th style="width:130px;">Pricing</th>
                                    <th style="width:100px;">Popular</th>
                                    <th>Features</th>
                                    <th style="width:100px;" class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Count; i++)
                                {
                                    var plan = Model[i];
                                    <tr>
                                        <td class="text-muted small">#@(i + 1)</td>
                                        <td>
                                            <div class="font-weight-bold text-white">@plan.PlanName</div>
                                            <small class="text-muted text-xs">@plan.Description</small>
                                        </td>
                                        <td>
                                            <div class="font-weight-bold text-success">@plan.PriceDisplay</div>
                                            <small class="text-muted text-xs">@plan.BillingCycle</small>
                                        </td>
                                        <td>
                                            @if (plan.IsPopular)
                                            {
                                                <span class="badge bg-primary text-xs">Yes</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary text-xs">No</span>
                                            }
                                        </td>
                                        <td>
                                            <ul class="list-unstyled mb-0">
                                                @foreach (var f in plan.Features)
                                                {
                                                    <li class="small text-secondary mb-1">
                                                        <i data-feather="check" class="text-success me-1 inline-block" style="width:12px;height:12px;vertical-align:middle;"></i> @f
                                                    </li>
                                                }
                                            </ul>
                                        </td>
                                        <td class="text-center">
                                            <form method="post" action="/Admin/Pricing/Delete" onsubmit="return confirm('Delete plan @plan.PlanName?');" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@plan.Id" />
                                                <button type="submit" class="btn btn-xs btn-outline-danger">
                                                    <i data-feather="trash-2" style="width:12px;height:12px;display:inline-block;vertical-align:middle;"></i> Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
