@model List<caportal.Models.Entities.ClientRequest>
@{
    Layout = "~/Areas/Admin/Views/Shared/_DattaLayout.cshtml";
    ViewData["Title"] = "Client Requests & Enquiries";
    var activeCAs = (ViewBag.ActiveCAs as List<string>) ?? new List<string>();
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="page-block">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-2">
            <div>
                <h4 class="mb-0 font-weight-bold text-black flex items-center">
                    <i data-feather="inbox" class="me-2 text-black" style="display: inline-block !important; vertical-align: middle;"></i> 
                    <span>Client Requests & Lead Triage</span>
                </h4>
                <span class="text-muted small">Real-time incoming client queries, consultation requests, and CA allocations</span>
            </div>
            <div class="flex gap-2">
                <a href="/Admin/Requests/ExportCsv" class="btn btn-outline-success">
                    <i data-feather="download" class="me-1" style="width:14px;height:14px;display:inline-block;vertical-align:middle;"></i> Export Leads CSV
                </a>
            </div>
        </div>
        <ul class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/ajs">Admin Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Requests</li>
        </ul>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i data-feather="check-circle" class="me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-4 mb-4">
    <!-- Stat Cards -->
    <div class="card widget-visitor-card">
        <div class="card-body text-center">
            <h2 style="color: var(--text-primary, #1e293b);" class="font-bold mb-1">@ViewBag.TotalCount</h2>
            <h6 class="text-muted font-medium mb-0">Total Inquiries</h6>
            <i class="feather icon-file-text" style="color: var(--text-primary, #1e293b); opacity: 0.15;"></i>
        </div>
    </div>
    <div class="card widget-visitor-card">
        <div class="card-body text-center">
            <h2 style="color: var(--text-primary, #1e293b);" class="font-bold mb-1">@ViewBag.PendingCount</h2>
            <h6 class="text-muted font-medium mb-0">Pending Allocation</h6>
            <i class="feather icon-clock" style="color: var(--text-primary, #1e293b); opacity: 0.15;"></i>
        </div>
    </div>
    <div class="card widget-visitor-card">
        <div class="card-body text-center">
            <h2 style="color: var(--text-primary, #1e293b);" class="font-bold mb-1">@ViewBag.AssignedCount</h2>
            <h6 class="text-muted font-medium mb-0">Assigned to CA</h6>
            <i class="feather icon-user-check" style="color: var(--text-primary, #1e293b); opacity: 0.15;"></i>
        </div>
    </div>
    <div class="card widget-visitor-card">
        <div class="card-body text-center">
            <h2 style="color: var(--text-primary, #1e293b);" class="font-bold mb-1">@ViewBag.CompletedCount</h2>
            <h6 class="text-muted font-medium mb-0">Resolved & Closed</h6>
            <i class="feather icon-check-circle" style="color: var(--text-primary, #1e293b); opacity: 0.15;"></i>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header flex items-center justify-between flex-wrap gap-2">
        <h5 class="mb-0 text-white"><i data-feather="message-circle" class="me-2 text-gold"></i> Live Client Consultation Inquiries</h5>
        <div class="btn-group">
            <a href="/Admin/Requests?status=All" class="btn btn-sm @(ViewBag.CurrentStatus == "All" ? "btn-primary" : "btn-outline-secondary")">All</a>
            <a href="/Admin/Requests?status=Pending" class="btn btn-sm @(ViewBag.CurrentStatus == "Pending" ? "btn-warning" : "btn-outline-secondary")">Pending</a>
            <a href="/Admin/Requests?status=Assigned" class="btn btn-sm @(ViewBag.CurrentStatus == "Assigned" ? "btn-info" : "btn-outline-secondary")">Assigned</a>
            <a href="/Admin/Requests?status=Completed" class="btn btn-sm @(ViewBag.CurrentStatus == "Completed" ? "btn-success" : "btn-outline-secondary")">Completed</a>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="requestsTable" class="table table-hover align-middle mb-0" style="width:100%">
                <thead class="table-light">
                    <tr>
                        <th style="width:50px;">#ID</th>
                        <th>Client Details</th>
                        <th>Contact Info</th>
                        <th>Service Requested</th>
                        <th>Allocated CA</th>
                        <th>Workflow Status</th>
                        <th>Source / Date</th>
                        <th class="text-center" style="width:130px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusBadge = item.Status switch
                        {
                            "Pending" => "bg-warning text-dark",
                            "Assigned" => "bg-info text-white",
                            "Completed" => "bg-success text-white",
                            _ => "bg-secondary text-white"
                        };
                        <tr>
                            <td><span class="badge bg-dark border text-gold font-monospace">#@item.Id</span></td>
                            <td>
                                <strong class="text-white d-block">@item.ClientName</strong>
                                <small class="text-muted"><i data-feather="map-pin" style="width:10px;height:10px;display:inline-block;vertical-align:middle;"></i> @(string.IsNullOrEmpty(item.City) ? "Pan-India" : item.City)</small>
                            </td>
                            <td>
                                <div><i data-feather="phone" style="width:11px;height:11px;display:inline-block;vertical-align:middle;"></i> @item.ClientPhone</div>
                                @if (!string.IsNullOrEmpty(item.ClientEmail))
                                {
                                    <small class="text-muted"><i data-feather="mail" style="width:10px;height:10px;display:inline-block;vertical-align:middle;"></i> @item.ClientEmail</small>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark fw-bold">@item.ServiceRequired</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.AssignedCA) && item.AssignedCA != "Unassigned")
                                {
                                    <span class="text-white"><i data-feather="user-check" class="text-gold me-1" style="width:12px;height:12px;display:inline-block;vertical-align:middle;"></i> @item.AssignedCA</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Unallocated</span>
                                }
                            </td>
                            <td><span class="badge @statusBadge">@item.Status</span></td>
                            <td>
                                <small class="text-muted d-block">@item.Source</small>
                                <small class="text-xs text-muted">@item.RequestedOn.ToString("dd MMM, hh:mm tt")</small>
                            </td>
                            <td class="text-center">
                                <div class="flex items-center justify-center gap-1">
                                    <button type="button" class="btn btn-xs btn-outline-info" onclick="openAssignModal(@item.Id, '@item.ClientName', '@item.AssignedCA', '@item.Status', '@item.Description')" title="Assign / Update Status">
                                        <i data-feather="user-plus" style="width:12px;height:12px;display:inline-block;vertical-align:middle;"></i> Manage
                                    </button>
                                    <form method="post" action="/Admin/Requests/Delete" class="d-inline" onsubmit="return confirm('Delete inquiry #@item.Id?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-xs btn-outline-danger" title="Delete"><i data-feather="trash-2" style="width:12px;height:12px;display:inline-block;vertical-align:middle;"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Assign CA / Update Status -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border border-secondary">
            <form method="post" action="/Admin/Requests/UpdateStatus">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="assignReqId" />
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-gold"><i data-feather="user-check" class="me-2"></i> Manage Request #<span id="assignReqIdText"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Client</label>
                        <input type="text" id="assignClientName" class="form-control" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Client Requirement Description</label>
                        <textarea id="assignReqDesc" class="form-control" rows="3" readonly></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Assign to CA Professional</label>
                        <select name="assignedCa" id="assignCaSelect" class="form-select">
                            <option value="Unassigned">-- Unassigned --</option>
                            @foreach (var ca in activeCAs)
                            {
                                <option value="@ca">@ca</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Inquiry Workflow Status</label>
                        <select name="status" id="assignStatusSelect" class="form-select">
                            <option value="Pending">Pending</option>
                            <option value="Assigned">Assigned</option>
                            <option value="Completed">Completed / Resolved</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i data-feather="save" class="me-1"></i> Update Lead Status</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            $('#requestsTable').DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                order: [[0, 'desc']],
                responsive: true,
                columnDefs: [{ orderable: false, targets: [7] }]
            });
            if (typeof feather !== 'undefined') feather.replace();
        });

        function openAssignModal(id, clientName, assignedCa, status, desc) {
            $('#assignReqId').val(id);
            $('#assignReqIdText').text(id);
            $('#assignClientName').val(clientName);
            $('#assignReqDesc').val(desc || 'No additional notes provided by client.');
            $('#assignCaSelect').val(assignedCa || 'Unassigned');
            $('#assignStatusSelect').val(status || 'Pending');

            var modal = new bootstrap.Modal(document.getElementById('assignModal'));
            modal.show();
        }
    </script>
}
