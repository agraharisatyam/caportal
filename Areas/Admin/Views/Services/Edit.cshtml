@model caportal.Models.CoveredService
@{
    ViewData["Title"] = "Edit Service";
}

<div class="page-header">
    <div class="page-block">
        <div class="page-header-title">
            <h5 class="mb-0 font-medium">Edit Service</h5>
        </div>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="/ajs">Home</a></li>
            <li class="breadcrumb-item"><a href="/Admin/Services">Services</a></li>
            <li class="breadcrumb-item" aria-current="page">Edit Service</li>
        </ul>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i data-feather="alert-circle" class="inline w-4 h-4 me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i data-feather="edit-2" class="inline w-4 h-4 me-2"></i>
                    Edit Service &mdash; <span class="text-muted fw-normal">@Model.Title</span>
                </h5>
            </div>
            <div class="card-body">
                <form method="post" action="/Admin/Services/Edit/@Model.Id"
                      enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="existingImagePath" value="@Model.ImagePath" />

                    <!-- Image upload -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Service Image</label>
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <div class="mb-2 d-flex align-items-center gap-3">
                                <img src="@Model.ImagePath" alt="@Model.Title"
                                     style="height:64px;width:64px;object-fit:cover;border-radius:10px;border:1px solid #e5e7eb;" />
                                <span class="text-muted small">Current image — upload a new file to replace it.</span>
                            </div>
                        }
                        <input type="file" name="imageFile" class="form-control"
                               accept=".png,.jpg,.jpeg,.svg,.webp" />
                        <div class="form-text">PNG, JPG, SVG or WebP. Recommended: 80×80 px.</div>
                    </div>

                    <!-- Title -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Title <span class="text-danger">*</span>
                        </label>
                        <input type="text" name="title" class="form-control"
                               value="@Model.Title" placeholder="e.g. GST &amp; Indirect Tax" required />
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Description <span class="text-danger">*</span>
                        </label>
                        <input type="text" name="description" class="form-control"
                               value="@Model.Description"
                               placeholder="e.g. Registration, returns, audits &amp; litigation" required />
                    </div>

                    <!-- Display Order -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Display Order</label>
                        <input type="number" name="displayOrder" class="form-control"
                               value="@Model.DisplayOrder" min="1" max="999" style="max-width:140px;" />
                        <div class="form-text">Lower numbers appear first.</div>
                    </div>

                    <!-- Page URL -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Page URL <small class="text-muted">(where card click leads)</small></label>
                        <input type="text" name="pageUrl" class="form-control"
                               value="@Model.PageUrl" placeholder="#professionals or /services/gst" />
                        <div class="form-text">Use <code>#professionals</code> to scroll to CAs, or a full URL like <code>/services/gst</code>.</div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-5">
                            <i data-feather="save" class="inline w-4 h-4 me-1"></i> Save Changes
                        </button>
                        <a href="/Admin/Services" class="btn btn-outline-secondary px-4">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        if (typeof feather !== 'undefined') feather.replace();
    });
</script>
}
