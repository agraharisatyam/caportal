@model caportal.Models.Entities.CoveredService
@{
    ViewData["Title"] = "Edit Service — " + Model.Title;
}

<div class="page-header mb-4">
    <div class="page-block">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h4 class="mb-0 font-weight-bold text-white"><i data-feather="edit-3" class="me-2 text-gold"></i> Edit Service: @Model.Title</h4>
                <span class="text-muted small">Update service details, order, and graphic assets</span>
            </div>
            <a href="/Admin/Services" class="btn btn-outline-secondary btn-sm">
                <i data-feather="arrow-left" class="me-1"></i> Back to Services List
            </a>
        </div>
        <ul class="breadcrumb mt-2 mb-0">
            <li class="breadcrumb-item"><a href="/ajs">Admin Home</a></li>
            <li class="breadcrumb-item"><a href="/Admin/Services">Services</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit #@Model.Id</li>
        </ul>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card" style="border-top: 4px solid #d4a017;">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0 text-gold"><i data-feather="grid" class="me-1"></i> Edit Service Details</h5>
                <span class="badge bg-dark border text-muted">ID #@Model.Id</span>
            </div>
            <div class="card-body">
                <form method="post" action="/Admin/Services/Edit/@Model.Id" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="existingImagePath" value="@Model.ImagePath" />

                    <div class="mb-3">
                        <label class="form-label font-weight-bold text-white">Service Title <span class="text-danger">*</span></label>
                        <input type="text" name="title" class="form-control" value="@Model.Title" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-bold text-white">Short Description <span class="text-danger">*</span></label>
                        <textarea name="description" class="form-control" rows="3" required>@Model.Description</textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold text-white">Display Order</label>
                            <input type="number" name="displayOrder" class="form-control" value="@Model.DisplayOrder" min="1" max="999" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold text-white">Page URL / Target Link</label>
                            <input type="text" name="pageUrl" class="form-control" value="@Model.PageUrl" placeholder="#professionals" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label font-weight-bold text-white">Current Graphic / Icon</label>
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <div class="mb-2 p-3 bg-dark border rounded d-flex align-items-center gap-3">
                                <img src="@Model.ImagePath" alt="@Model.Title" style="height:60px;width:60px;object-fit:contain;border-radius:8px;background:rgba(255,255,255,0.05);padding:4px;" />
                                <div>
                                    <span class="text-white d-block font-weight-semibold">@Model.ImagePath</span>
                                    <span class="text-muted small">Upload a new image below to replace current icon</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small mb-2">No custom graphic uploaded. Default icon displayed.</div>
                        }
                        <input type="file" name="imageFile" class="form-control" accept=".png,.jpg,.jpeg,.svg,.webp" />
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex align-items-center justify-content-end gap-2">
                        <a href="/Admin/Services" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-5">
                            <i data-feather="save" class="me-1"></i> Update Service
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
