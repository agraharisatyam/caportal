@using caportal.Models
@{
    ViewData["Title"] = "Manage Services";
    var services = (ViewBag.Services as List<CoveredService>) ?? new List<CoveredService>();
    var settings  = ViewBag.Settings as caportal.Models.SiteSettings ?? new caportal.Models.SiteSettings();
    int nextOrder = services.Any() ? services.Max(s => s.DisplayOrder) + 1 : 1;
}

<div class="page-header">
    <div class="page-block">
        <div class="page-header-title">
            <h5 class="mb-0 font-medium">Manage Services</h5>
        </div>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="/ajs">Home</a></li>
            <li class="breadcrumb-item" aria-current="page">Services</li>
        </ul>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i data-feather="check-circle" class="inline w-4 h-4 me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i data-feather="alert-circle" class="inline w-4 h-4 me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Section Heading -->
<div class="card mb-4" style="border-left:4px solid #d4a017;">
    <div class="card-header"><h5 class="mb-0">Section Heading</h5></div>
    <div class="card-body">
        <form method="post" action="/Admin/Services/SaveSection">
            @Html.AntiForgeryToken()
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Badge</label>
                    <input type="text" name="servicesBadge" class="form-control" value="@settings.ServicesBadge" />
                </div>
                <div class="col-md-7">
                    <label class="form-label fw-semibold">Title <small class="text-muted">(use &lt;span&gt; for highlight)</small></label>
                    <input type="text" name="servicesTitle" class="form-control" value="@settings.ServicesTitle" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Save</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Services Table -->
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="mb-0">All Services <span class="badge bg-primary ms-2">@services.Count</span></h5>
        <button class="btn btn-primary" id="btnAddService">
            <i data-feather="plus" class="inline w-4 h-4 me-1"></i> Add Service
        </button>
    </div>
    <div class="card-body p-0">
        @if (!services.Any())
        {
            <div class="text-center py-12 text-muted">
                <p class="mt-3">No services yet. Click <strong>Add Service</strong> to get started.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="servicesTable" class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:60px;">#</th>
                            <th style="width:80px;">Image</th>
                            <th>Title</th>
                            <th>Description</th>
                            <th style="width:90px;" class="text-center">Order</th>
                            <th style="width:110px;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var svc in services.OrderBy(s => s.DisplayOrder))
                        {
                            <tr>
                                <td class="text-muted small">@svc.Id</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(svc.ImagePath))
                                    {
                                        <img src="@svc.ImagePath" alt="@svc.Title"
                                             style="width:44px;height:44px;object-fit:cover;border-radius:8px;border:1px solid #e5e7eb;" />
                                    }
                                    else
                                    {
                                        <div class="svc-tbl-icon"><i class="@svc.Icon"></i></div>
                                    }
                                </td>
                                <td><span class="fw-semibold">@svc.Title</span></td>
                                <td class="text-muted small">@svc.Description</td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@svc.DisplayOrder</span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center">
                                        <a href="/Admin/Services/Edit/@svc.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit">
                                            <i data-feather="edit-2" style="width:14px;height:14px;"></i>
                                        </a>
                                        <form method="post" action="/Admin/Services/Delete"
                                              style="display:inline;"
                                              onsubmit="return confirm('Delete @Html.Raw(svc.Title)?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@svc.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i data-feather="trash-2" style="width:14px;height:14px;"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal fade" id="svcModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="/Admin/Services/Save"
                  enctype="multipart/form-data" id="svcForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id"                id="fId"    value="0" />
                <input type="hidden" name="existingImagePath" id="fImage" value="" />

                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="svcModalLabel">Add Service</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Service Image</label>
                        <!-- Current image preview -->
                        <div id="currentImgWrap" class="mb-2" style="display:none;">
                            <img id="currentImg" src="" alt="Current"
                                 style="height:60px;border-radius:8px;border:1px solid #e5e7eb;" />
                            <div class="text-muted small mt-1">Current image — upload a new one to replace</div>
                        </div>
                        <input type="file" name="imageFile" id="fImageFile"
                               class="form-control" accept=".png,.jpg,.jpeg,.svg,.webp" />
                        <div class="form-text">PNG, JPG, SVG or WebP. Recommended: 80×80px.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                        <input type="text" name="title" id="fTitle" class="form-control"
                               placeholder="e.g. GST & Indirect Tax" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
                        <input type="text" name="description" id="fDesc" class="form-control"
                               placeholder="e.g. Registration, returns, audits & litigation" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Display Order</label>
                        <input type="number" name="displayOrder" id="fOrder" class="form-control"
                               value="1" min="1" max="999" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-5">
                        <i data-feather="save" class="inline w-4 h-4 me-1"></i> Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
<style>
    .svc-tbl-icon {
        width:44px;height:44px;border-radius:8px;
        background:linear-gradient(135deg,#1a3c5e,#2557a7);
        display:flex;align-items:center;justify-content:center;
        color:#fff;font-size:1.1rem;
    }
</style>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<script>
(function () {
    var modal;

    function getModal() {
        if (!modal) modal = new bootstrap.Modal(document.getElementById('svcModal'));
        return modal;
    }

    function resetForm() {
        document.getElementById('fId').value    = '0';
        document.getElementById('fImage').value = '';
        document.getElementById('fTitle').value = '';
        document.getElementById('fDesc').value  = '';
        document.getElementById('fOrder').value = '@nextOrder';
        document.getElementById('fImageFile').value = '';
        document.getElementById('currentImgWrap').style.display = 'none';
        document.getElementById('currentImg').src = '';
        document.getElementById('svcModalLabel').textContent = 'Add Service';
    }

    // Add button
    document.getElementById('btnAddService').addEventListener('click', function () {
        resetForm();
        getModal().show();
    });

    // Edit buttons — read data from data-* attributes, no fetch needed
    document.querySelectorAll('.btn-edit').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var id    = this.dataset.id;
            var title = this.dataset.title;
            var desc  = this.dataset.desc;
            var order = this.dataset.order;
            var image = this.dataset.image;

            document.getElementById('svcModalLabel').textContent = 'Edit Service';
            document.getElementById('fId').value    = id;
            document.getElementById('fTitle').value = title;
            document.getElementById('fDesc').value  = desc;
            document.getElementById('fOrder').value = order;
            document.getElementById('fImage').value = image;
            document.getElementById('fImageFile').value = '';

            // Show current image if exists
            var wrap = document.getElementById('currentImgWrap');
            var img  = document.getElementById('currentImg');
            if (image && image.trim() !== '') {
                img.src = image;
                wrap.style.display = 'block';
            } else {
                wrap.style.display = 'none';
                img.src = '';
            }

            getModal().show();
        });
    });

    // DataTable
    @if (services.Any())
    {
        <text>
        $(document).ready(function () {
            $('#servicesTable').DataTable({
                pageLength: 25,
                lengthMenu: [10,25,50],
                order: [[4,'asc']],
                columnDefs: [{ orderable: false, targets: [1,5] }]
            });
        });
        </text>
    }

    // Feather icons
    document.addEventListener('DOMContentLoaded', function () {
        if (typeof feather !== 'undefined') feather.replace();
    });
})();
</script>
}
