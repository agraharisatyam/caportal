@using caportal.Models
@{
    ViewData["Title"] = "Manage Services";
    var services = (ViewBag.Services as List<CoveredService>) ?? new List<CoveredService>();
    var settings  = ViewBag.Settings as caportal.Models.Entities.SiteSettings ?? new caportal.Models.Entities.SiteSettings();
}

<div class="page-header mb-4">
    <div class="page-block">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-2">
            <div>
                <h4 class="mb-0 font-weight-bold text-black flex items-center"><i data-feather="grid" class="me-2 text-black" style="display: inline-block !important; vertical-align: middle;"></i> <span>Manage Services</span></h4>
            </div>
            <a href="/Admin/Services/Create" class="btn btn-primary btn-sm">
                <i data-feather="plus" class="me-1"></i> Add Service
            </a>
        </div>
        <ul class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/ajs">Admin Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Services</li>
        </ul>
94

</div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i data-feather="check-circle" class="me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i data-feather="alert-circle" class="me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Section Heading -->
<div class="card mb-4" style="border-left:4px solid #d4a017;">
    <div class="card-header"><h5 class="mb-0 text-gold">Services Section Heading</h5></div>
    <div class="card-body">
        <form method="post" action="/Admin/Services/SaveSection">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-12 gap-x-6 gap-y-4 items-end">
                <div class="col-span-12 md:col-span-3">
                    <label class="form-label font-weight-bold">Badge Text</label>
                    <input type="text" name="servicesBadge" class="form-control" value="@settings.ServicesBadge" />
                </div>
                <div class="col-span-12 md:col-span-7">
                    <label class="form-label font-weight-bold">Title <small class="text-muted">(HTML tags allowed)</small></label>
                    <input type="text" name="servicesTitle" class="form-control" value="@settings.ServicesTitle" />
                </div>
                <div class="col-span-12 md:col-span-2">
                    <button type="submit" class="btn btn-primary w-100"><i data-feather="save" class="me-1"></i> Save Heading</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Services Table -->
<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="mb-0 text-white">All Services <span class="badge bg-primary ms-2">@services.Count</span></h5>
        <a href="/Admin/Services/Create" class="btn btn-primary btn-sm">
            <i data-feather="plus" class="me-1"></i> Add Service Page
        </a>
    </div>
    <div class="card-body p-0">
        @if (!services.Any())
        {
            <div class="text-center py-5 text-muted">
                <p class="mb-2">No services created yet.</p>
                <a href="/Admin/Services/Create" class="btn btn-sm btn-primary">
                    <i data-feather="plus" class="me-1"></i> Create First Service
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="servicesTable" class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:60px;">#</th>
                            <th style="width:80px;">Icon / Image</th>
                            <th>Title</th>
                            <th>Description</th>
                            <th style="width:90px;" class="text-center">Order</th>
                            <th style="width:120px;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var svc in services.OrderBy(s => s.DisplayOrder))
                        {
                            <tr>
                                <td class="text-muted small">#@svc.Id</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(svc.ImagePath))
                                    {
                                        <img src="@svc.ImagePath" alt="@svc.Title"
                                             style="width:44px;height:44px;object-fit:contain;border-radius:8px;border:1px solid rgba(212,175,55,0.2);padding:2px;background:rgba(255,255,255,0.02);" />
                                    }
                                    else
                                    {
                                        <div class="svc-tbl-icon"><i class="@svc.Icon"></i></div>
                                    }
                                </td>
                                <td><span class="font-weight-bold text-white">@svc.Title</span></td>
                                <td class="text-muted small">@svc.Description</td>
                                <td class="text-center">
                                    <span class="badge bg-dark text-gold border">@svc.DisplayOrder</span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center">
                                        <a href="/Admin/Services/Edit/@svc.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Edit Service Page">
                                            <i data-feather="edit-2" style="width:14px;height:14px;"></i>
                                        </a>
                                        <form method="post" action="/Admin/Services/Delete"
                                              style="display:inline;"
                                              onsubmit="return confirm('Are you sure you want to delete @Html.Raw(svc.Title)?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@svc.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Service">
                                                <i data-feather="trash-2" style="width:14px;height:14px;"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <style>
        .svc-tbl-icon {
            width:44px;height:44px;border-radius:8px;
            background:linear-gradient(135deg,rgba(212,175,55,0.2),rgba(212,175,55,0.05));
            border:1px solid rgba(212,175,55,0.3);
            display:flex;align-items:center;justify-content:center;
            color:#d4a017;font-size:1.1rem;
        }
    </style>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            @if (services.Any())
            {
                <text>
                $('#servicesTable').DataTable({
                    pageLength: 10,
                    lengthMenu: [10,25,50],
                    order: [[4,'asc']],
                    columnDefs: [{ orderable: false, targets: [1,5] }]
                });
                </text>
            }
            if (typeof feather !== 'undefined') feather.replace();
        });
    </script>
}
