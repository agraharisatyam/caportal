@model List<caportal.Models.ViewModels.Testimonial>
@{
    Layout = "~/Areas/Admin/Views/Shared/_DattaLayout.cshtml";
    ViewData["Title"] = "Manage Testimonials";
}

<!-- Page Header -->
<div class="page-header mb-4">
    <div class="page-block">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-2">
            <div>
                <h4 class="mb-0 font-weight-bold text-black flex items-center"><i data-feather="message-square" class="me-2 text-black" style="display: inline-block !important; vertical-align: middle;"></i> <span>Manage Testimonials</span></h4>
                <span class="text-muted small">Configure client testimonials and reviews shown on the platform</span>
            </div>
        </div>
        <ul class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/ajs">Admin Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Testimonials</li>
        </ul>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i data-feather="check-circle" class="me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i data-feather="alert-circle" class="me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="grid grid-cols-12 gap-x-6 gap-y-4">
    <!-- Add Testimonial Form -->
    <div class="col-span-12 lg:col-span-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0 text-gold">Add New Testimonial</h5>
            </div>
            <div class="card-body">
                <form method="post" action="/Admin/Testimonials/Save">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Author / Client Name *</label>
                        <input type="text" name="authorName" class="form-control" placeholder="e.g. Suresh G." required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Role / Designation *</label>
                        <input type="text" name="authorRole" class="form-control" placeholder="e.g. Business Owner" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Rating (Stars) *</label>
                        <select name="rating" class="form-select">
                            <option value="5">⭐⭐⭐⭐⭐ (5 Stars)</option>
                            <option value="4">⭐⭐⭐⭐ (4 Stars)</option>
                            <option value="3">⭐⭐⭐ (3 Stars)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Review Text *</label>
                        <textarea name="text" class="form-control" rows="4" placeholder="Enter client testimonial text..." required></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary w-100"><i data-feather="plus" class="me-1"></i> Add Testimonial</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Testimonials List -->
    <div class="col-span-12 lg:col-span-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-white">Client Review Testimonials</h5>
                <span class="badge bg-primary">@Model.Count Testimonials</span>
            </div>
            <div class="card-body p-0">
                @if (Model.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <p class="mb-0">No testimonials added yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:50px;">#</th>
                                    <th style="width:180px;">Client</th>
                                    <th style="width:110px;">Rating</th>
                                    <th>Review Text</th>
                                    <th style="width:100px;" class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Count; i++)
                                {
                                    var t = Model[i];
                                    <tr>
                                        <td class="text-muted small">#@(i + 1)</td>
                                        <td>
                                            <div class="font-weight-bold text-white">@t.AuthorName</div>
                                            <small class="text-muted text-xs">@t.AuthorRole</small>
                                        </td>
                                        <td>
                                            <span class="text-warning">@(string.Concat(Enumerable.Repeat("★", t.Rating)))</span>
                                        </td>
                                        <td class="small text-secondary" style="white-space: normal; word-break: break-word;">
                                            "@t.Text"
                                        </td>
                                        <td class="text-center">
                                            <form method="post" action="/Admin/Testimonials/Delete" onsubmit="return confirm('Remove testimonial by @t.AuthorName?');" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="index" value="@i" />
                                                <button type="submit" class="btn btn-xs btn-outline-danger">
                                                    <i data-feather="trash-2" style="width:12px;height:12px;display:inline-block;vertical-align:middle;"></i> Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
