@using caportal.Models
@{
    ViewData["Title"] = "Manage Why Choose Us";
    var items = (ViewBag.Items as List<WhyChooseUsItem>) ?? new List<WhyChooseUsItem>();
    var settings = ViewBag.Settings as SiteSettings ?? new SiteSettings();
    int nextOrder = items.Any() ? items.Max(s => s.DisplayOrder) + 1 : 1;
}

<div class="page-header">
    <div class="page-block">
        <div class="page-header-title">
            <h5 class="mb-0 font-medium">Manage Why Choose Us</h5>
        </div>
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="/ajs">Home</a></li>
            <li class="breadcrumb-item" aria-current="page">Why Choose Us</li>
        </ul>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i data-feather="check-circle" class="inline w-4 h-4 me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i data-feather="alert-circle" class="inline w-4 h-4 me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- Left Column: Section settings and Stats settings -->
    <div class="col-xl-4 col-lg-5">
        <div class="card mb-4" style="border-left: 4px solid #d4a017;">
            <div class="card-header">
                <h5 class="mb-0">Section Details</h5>
            </div>
            <div class="card-body">
                <form method="post" action="/Admin/WhyChooseUs/SaveSection">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Badge</label>
                        <input type="text" name="whyChooseUsBadge" class="form-control" value="@settings.WhyChooseUsBadge" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Title</label>
                        <input type="text" name="whyChooseUsTitle" class="form-control" value="@settings.WhyChooseUsTitle" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Subtitle / Description</label>
                        <textarea name="whyChooseUsSub" class="form-control" rows="3" required>@settings.WhyChooseUsSub</textarea>
                    </div>

                    <hr class="my-4" />

                    <h6 class="fw-bold mb-3 text-primary"><i data-feather="trending-up" class="inline w-4 h-4 me-1"></i> Bottom Stats Bar</h6>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Stats Banner Title</label>
                        <input type="text" name="whyChooseUsStatsTitle" class="form-control" value="@settings.WhyChooseUsStatsTitle" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Stat 1 Value</label>
                            <input type="text" name="whyChooseUsStat1Val" class="form-control form-control-sm" value="@settings.WhyChooseUsStat1Val" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Stat 1 Label</label>
                            <input type="text" name="whyChooseUsStat1Lbl" class="form-control form-control-sm" value="@settings.WhyChooseUsStat1Lbl" required />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Stat 2 Value</label>
                            <input type="text" name="whyChooseUsStat2Val" class="form-control form-control-sm" value="@settings.WhyChooseUsStat2Val" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Stat 2 Label</label>
                            <input type="text" name="whyChooseUsStat2Lbl" class="form-control form-control-sm" value="@settings.WhyChooseUsStat2Lbl" required />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Stat 3 Value</label>
                            <input type="text" name="whyChooseUsStat3Val" class="form-control form-control-sm" value="@settings.WhyChooseUsStat3Val" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Stat 3 Label</label>
                            <input type="text" name="whyChooseUsStat3Lbl" class="form-control form-control-sm" value="@settings.WhyChooseUsStat3Lbl" required />
                        </div>
                    </div>

                    <div class="row g-2 mb-4">
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Stat 4 Value</label>
                            <input type="text" name="whyChooseUsStat4Val" class="form-control form-control-sm" value="@settings.WhyChooseUsStat4Val" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small">Stat 4 Label</label>
                            <input type="text" name="whyChooseUsStat4Lbl" class="form-control form-control-sm" value="@settings.WhyChooseUsStat4Lbl" required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i data-feather="save" class="inline w-4 h-4 me-1"></i> Save Layout & Stats
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Right Column: Cards list table -->
    <div class="col-xl-8 col-lg-7">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0">Features Cards <span class="badge bg-primary ms-2">@items.Count</span></h5>
                <button class="btn btn-primary" id="btnAddItem">
                    <i data-feather="plus" class="inline w-4 h-4 me-1"></i> Add Card
                </button>
            </div>
            <div class="card-body p-0">
                @if (!items.Any())
                {
                    <div class="text-center py-12 text-muted">
                        <i data-feather="help-circle" class="w-12 h-12 text-muted mb-2"></i>
                        <p>No feature cards configured. Defaults will load on homepage.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table id="itemsTable" class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:60px;">#</th>
                                    <th style="width:70px;">Icon</th>
                                    <th>Title</th>
                                    <th>Description</th>
                                    <th style="width:80px;" class="text-center">Order</th>
                                    <th style="width:110px;" class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in items.OrderBy(i => i.DisplayOrder))
                                {
                                    <tr>
                                        <td class="text-muted small">@item.Id</td>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(item.ImagePath))
                                            {
                                                <img src="@item.ImagePath" alt="@item.Title"
                                                     style="width:36px;height:36px;object-fit:contain;border-radius:4px;border:1px solid #e5e7eb;" />
                                            }
                                            else
                                            {
                                                <div class="tbl-wcu-icon text-primary"><i class="@item.Icon"></i></div>
                                            }
                                        </td>
                                        <td><span class="fw-semibold">@item.Title</span></td>
                                        <td class="text-muted small text-truncate" style="max-width: 200px;">@item.Description</td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border">@item.DisplayOrder</span>
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex gap-2 justify-content-center">
                                                <button class="btn btn-sm btn-outline-primary btn-edit"
                                                        data-id="@item.Id"
                                                        data-title="@item.Title"
                                                        data-desc="@item.Description"
                                                        data-order="@item.DisplayOrder"
                                                        data-icon="@item.Icon"
                                                        data-image="@item.ImagePath"
                                                        title="Edit">
                                                    <i data-feather="edit-2" style="width:14px;height:14px;"></i>
                                                </button>
                                                <form method="post" action="/Admin/WhyChooseUs/Delete"
                                                      style="display:inline;"
                                                      onsubmit="return confirm('Delete @Html.Raw(item.Title)?')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                        <i data-feather="trash-2" style="width:14px;height:14px;"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal fade" id="wcuModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="/Admin/WhyChooseUs/Save"
                  enctype="multipart/form-data" id="wcuForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id"                id="fId"    value="0" />
                <input type="hidden" name="existingImagePath" id="fImage" value="" />

                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="wcuModalLabel">Add Card</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Custom Upload Icon <small class="text-muted">(Optional)</small></label>
                        <!-- Current image preview -->
                        <div id="currentImgWrap" class="mb-2" style="display:none;">
                            <img id="currentImg" src="" alt="Current"
                                 style="height:60px;border-radius:8px;border:1px solid #e5e7eb;" />
                            <div class="text-muted small mt-1">Current icon — upload a new one to replace</div>
                        </div>
                        <input type="file" name="imageFile" id="fImageFile"
                               class="form-control" accept=".png,.jpg,.jpeg,.svg,.webp" />
                        <div class="form-text">PNG, JPG, SVG or WebP.</div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Standard Icon Class <span class="text-muted">(FontAwesome)</span></label>
                        <input type="text" name="icon" id="fIcon" class="form-control"
                               placeholder="e.g. fas fa-user-graduate" value="fas fa-star" />
                        <div class="form-text">Used if no custom icon image is uploaded.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                        <input type="text" name="title" id="fTitle" class="form-control"
                               placeholder="e.g. EXPERT CA TEAM" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
                        <textarea name="description" id="fDesc" class="form-control" rows="3"
                                  placeholder="e.g. Qualified & experienced CAs..." required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Display Order</label>
                        <input type="number" name="displayOrder" id="fOrder" class="form-control"
                               value="1" min="1" max="999" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-5">
                        <i data-feather="save" class="inline w-4 h-4 me-1"></i> Save Card
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<style>
    .tbl-wcu-icon {
        width:36px;height:36px;border-radius:6px;
        background: rgba(212,175,55,0.1);
        display:inline-flex;align-items:center;justify-content:center;
        font-size:1.1rem;
    }
</style>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
    var modal;

    function getModal() {
        if (!modal) modal = new bootstrap.Modal(document.getElementById('wcuModal'));
        return modal;
    }

    function resetForm() {
        document.getElementById('fId').value    = '0';
        document.getElementById('fImage').value = '';
        document.getElementById('fTitle').value = '';
        document.getElementById('fDesc').value  = '';
        document.getElementById('fIcon').value  = 'fas fa-star';
        document.getElementById('fOrder').value = '@nextOrder';
        document.getElementById('fImageFile').value = '';
        document.getElementById('currentImgWrap').style.display = 'none';
        document.getElementById('currentImg').src = '';
        document.getElementById('wcuModalLabel').textContent = 'Add Card';
    }

    // Add button
    document.getElementById('btnAddItem').addEventListener('click', function () {
        resetForm();
        getModal().show();
    });

    // Edit buttons
    document.querySelectorAll('.btn-edit').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var id    = this.dataset.id;
            var title = this.dataset.title;
            var desc  = this.dataset.desc;
            var order = this.dataset.order;
            var icon  = this.dataset.icon;
            var image = this.dataset.image;

            document.getElementById('wcuModalLabel').textContent = 'Edit Card';
            document.getElementById('fId').value    = id;
            document.getElementById('fTitle').value = title;
            document.getElementById('fDesc').value  = desc;
            document.getElementById('fOrder').value = order;
            document.getElementById('fIcon').value  = icon;
            document.getElementById('fImage').value = image;
            document.getElementById('fImageFile').value = '';

            // Show current image if exists
            var wrap = document.getElementById('currentImgWrap');
            var img  = document.getElementById('currentImg');
            if (image && image.trim() !== '') {
                img.src = image;
                wrap.style.display = 'block';
            } else {
                wrap.style.display = 'none';
                img.src = '';
            }

            getModal().show();
        });
    });

    // Feather icons
    document.addEventListener('DOMContentLoaded', function () {
        if (typeof feather !== 'undefined') feather.replace();
    });
})();
</script>
}
