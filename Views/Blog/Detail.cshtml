@model caportal.Models.Entities.BlogPost
@{
    ViewData["Title"] = !string.IsNullOrWhiteSpace(Model.MetaTitle) 
        ? Model.MetaTitle 
        : $"{Model.Title} — CACampus Blog";

    ViewData["Description"] = !string.IsNullOrWhiteSpace(Model.MetaDescription) 
        ? Model.MetaDescription 
        : Model.Excerpt;

    ViewData["Keywords"] = !string.IsNullOrWhiteSpace(Model.MetaKeywords) 
        ? Model.MetaKeywords 
        : (Model.Tags != null && Model.Tags.Any() ? string.Join(", ", Model.Tags) : null);

    ViewData["OgImage"] = Model.FeaturedImagePath;

    Layout = "~/Views/Shared/_LandingLayout.cshtml";

    var relatedPosts = ViewBag.RelatedPosts as List<caportal.Models.Entities.BlogPost> ?? new();
}

<!-- ═══ Article Hero Section ═══ -->
<section class="blog-detail-hero">
    <div class="container position-relative" style="z-index: 2;">
        <nav aria-label="breadcrumb">
            <ul class="breadcrumb blog-breadcrumb">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/blog">Blog</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Category</li>
            </ul>
        </nav>

        <span class="badge bg-gold text-dark font-bold mb-3">@Model.Category</span>
        <h1 class="article-main-title">@Model.Title</h1>

        <div class="d-flex align-items-center gap-3 mt-4 pt-2">
            <img src="@Model.AuthorAvatar" class="detail-author-avatar" alt="@Model.AuthorName" />
            <div>
                <strong class="d-block text-white">@Model.AuthorName</strong>
                <span class="text-white-50 small">@Model.AuthorRole</span>
            </div>
            <div class="ms-auto text-end text-white-50 small">
                <div><i class="far fa-calendar-alt me-1"></i>@Model.PublishedDate.ToString("dd MMMM yyyy")</div>
                <div><i class="far fa-clock me-1"></i>@Model.ReadTimeMinutes min read &bull; @Model.ViewsCount views</div>
            </div>
        </div>
    </div>
</section>

<!-- ═══ Main Article Content Grid ═══ -->
<div class="container py-5">
    <div class="row g-4">
        <!-- Main Article Column -->
        <main class="col-lg-8" role="main">
            <article class="blog-content-card">
                <!-- Lead summary box -->
                <div class="lead-box mb-4">
                    <i class="fas fa-quote-left quote-icon me-2"></i>@Model.Excerpt
                </div>

                <!-- HTML Article Body -->
                <div class="article-html-body">
                    @Html.Raw(Model.Content)
                </div>

                <!-- Tags -->
                @if (Model.Tags != null && Model.Tags.Any())
                {
                    <div class="mt-4 pt-3 border-top">
                        <strong class="me-2 text-muted small">TAGS:</strong>
                        @foreach (var tag in Model.Tags)
                        {
                            <a href="/blog?search=@tag" class="badge bg-light text-dark text-decoration-none me-1 p-2">#@tag</a>
                        }
                    </div>
                }

                <!-- Author Bio Box -->
                <div class="author-bio-card mt-5 p-4 rounded bg-light border">
                    <div class="d-flex align-items-center gap-3">
                        <img src="@Model.AuthorAvatar" class="bio-avatar" alt="@Model.AuthorName" />
                        <div>
                            <h5 class="mb-1 font-bold">@Model.AuthorName</h5>
                            <p class="text-muted small mb-2">@Model.AuthorRole &bull; Empaneled CA Expert on CACampus</p>
                            <a href="/find-expert" class="btn btn-sm btn-primary">Book Consultation with Author</a>
                        </div>
                    </div>
                </div>
            </article>

            <!-- Related Articles -->
            @if (relatedPosts.Any())
            {
                <div class="mt-5">
                    <h3 class="font-bold mb-4">Related Articles</h3>
                    <div class="row g-3">
                        @foreach (var r in relatedPosts)
                        {
                            <div class="col-md-4">
                                <div class="card h-100 border-0 shadow-sm">
                                    <div class="p-3 bg-light text-center">
                                        <img src="@r.FeaturedImagePath" style="max-height:80px;" alt="@r.Title" />
                                    </div>
                                    <div class="card-body p-3">
                                        <h6 class="fw-bold small mb-2"><a href="/blog/@r.Slug" class="text-dark text-decoration-none">@r.Title</a></h6>
                                        <small class="text-muted">@r.PublishedDate.ToString("dd MMM yyyy")</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </main>

        <!-- Sidebar Widget -->
        <aside class="col-lg-4" role="complementary">
            <div class="sticky-top" style="top: 90px;">
                <div class="card border-0 shadow-sm p-4 text-center mb-4" style="background: linear-gradient(135deg, #0d1f33, #1a3c5e); color: #fff;">
                    <i class="fas fa-user-tie fa-3x text-warning mb-3"></i>
                    <h4 class="font-bold text-white">Need CA Consultation?</h4>
                    <p class="small text-white-50 mb-3">Connect directly with verified Chartered Accountants for your tax, audit, and legal requirements.</p>
                    <a href="/find-expert" class="btn btn-gold w-100 font-bold">Find an Expert CA</a>
                </div>
            </div>
        </aside>
    </div>
</div>

<style>
    .blog-detail-hero {
        background: linear-gradient(135deg, #0a1628 0%, #1a2a4a 100%);
        padding: 60px 0 40px;
        color: #ffffff;
        border-bottom: 3px solid #d4a017;
    }
    .blog-breadcrumb .breadcrumb-item a {
        color: rgba(255,255,255,0.7);
        text-decoration: none;
    }
    .blog-breadcrumb .breadcrumb-item.active {
        color: #d4a017;
    }
    .article-main-title {
        font-family: 'Playfair Display', serif;
        font-size: 2.4rem;
        font-weight: 800;
        line-height: 1.3;
    }
    .detail-author-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        border: 2px solid #d4a017;
    }
    .blog-content-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 35px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.04);
        border: 1px solid #f0f2f5;
    }
    .lead-box {
        background: #fffcf5;
        border-left: 4px solid #d4a017;
        padding: 20px;
        border-radius: 8px;
        font-size: 1.1rem;
        color: #374151;
        font-style: italic;
    }
    .quote-icon {
        color: #d4a017;
    }
    .article-html-body {
        font-size: 1.05rem;
        line-height: 1.8;
        color: #374151;
    }
    .article-html-body h3 {
        font-size: 1.4rem;
        font-weight: 700;
        color: #0d1f33;
        margin-top: 30px;
        margin-bottom: 15px;
    }
    .bio-avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        object-fit: cover;
    }
</style>
