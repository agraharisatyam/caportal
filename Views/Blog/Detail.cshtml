@model caportal.Models.Entities.BlogPost
@using caportal.Services.Repositories
@{
    ViewData["Title"] = !string.IsNullOrWhiteSpace(Model.MetaTitle) 
        ? Model.MetaTitle 
        : $"{Model.Title} — CACampus Blog";

    ViewData["Description"] = !string.IsNullOrWhiteSpace(Model.MetaDescription) 
        ? Model.MetaDescription 
        : Model.Excerpt;

    ViewData["Keywords"] = !string.IsNullOrWhiteSpace(Model.MetaKeywords) 
        ? Model.MetaKeywords 
        : (Model.Tags != null && Model.Tags.Any() ? string.Join(", ", Model.Tags) : null);

    ViewData["OgImage"] = Model.FeaturedImagePath;

    Layout = "~/Views/Shared/_LandingLayout.cshtml";

    // Retrieve blog repository data for widgets
    var allPosts = BlogRepository.GetAll(includeUnpublished: false);
    
    // Find Current Post index to resolve Prev/Next Navigation
    var currentIndex = allPosts.FindIndex(p => p.Id == Model.Id);
    var prevPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
    var nextPost = currentIndex < allPosts.Count - 1 ? allPosts[currentIndex + 1] : null;

    // Get 4 Related Posts (same category first, fallback to others if needed)
    var relatedPosts = allPosts
        .Where(p => p.Id != Model.Id && p.Category.Equals(Model.Category, StringComparison.OrdinalIgnoreCase))
        .Take(4)
        .ToList();

    if (relatedPosts.Count < 4)
    {
        var fillCount = 4 - relatedPosts.Count;
        var fillPosts = allPosts
            .Where(p => p.Id != Model.Id && !relatedPosts.Any(rp => rp.Id == p.Id))
            .Take(fillCount)
            .ToList();
        relatedPosts.AddRange(fillPosts);
    }

    // Get category list with counts
    var categoryCounts = allPosts
        .GroupBy(p => p.Category)
        .Select(g => new { Name = g.Key, Count = g.Count() })
        .OrderByDescending(x => x.Count)
        .ToList();

    // Get top 3 popular posts by views
    var popularPosts = allPosts
        .OrderByDescending(p => p.ViewsCount)
        .Take(3)
        .ToList();
}

