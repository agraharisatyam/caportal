<!-- ═══ Blog Header / Breadcrumbs & Title ═══ -->
<header class="blog-header">
    <div class="container">
        <!-- Breadcrumbs -->
        <nav aria-label="breadcrumb">
            <ul class="breadcrumb-custom">
                <li class="breadcrumb-custom-item"><a href="/">Home</a></li>
                <li class="breadcrumb-custom-item"><a href="/blog">Resources</a></li>
                <li class="breadcrumb-custom-item"><a href="/blog">Blogs</a></li>
                <li class="breadcrumb-custom-item active" aria-current="page">@Model.Category</li>
            </ul>
        </nav>

        <!-- Category Badge -->
        <span class="category-badge-custom mb-3">@Model.Category</span>
        
        <!-- Main Title -->
        <h1 class="blog-detail-title">@Model.Title</h1>
        
        <!-- Brief Excerpt/Summary -->
        <p class="blog-detail-excerpt">@Model.Excerpt</p>
        
        <!-- Meta Row -->
        <div class="meta-bar-custom">
            <div class="meta-bar-item">
                <i class="far fa-calendar-alt"></i>
                <span>@Model.PublishedDate.ToString("MMMM dd, yyyy")</span>
            </div>
            <div class="meta-bar-item">
                <i class="far fa-clock"></i>
                <span>@Model.ReadTimeMinutes Min Read</span>
            </div>
            <div class="meta-bar-item">
                <i class="far fa-eye"></i>
                <span>@(Model.ViewsCount > 1000 ? $"{(Model.ViewsCount / 1000.0):0.1}K" : Model.ViewsCount.ToString()) Views</span>
            </div>
            <div class="fact-checked-badge">
                <i class="fas fa-shield-halved"></i>
                <span>Fact Checked &amp; Reviewed</span>
            </div>
            
            <!-- Social Share container -->
            <div class="share-container">
                <span class="small font-weight-bold text-uppercase d-none d-sm-inline" style="font-size:0.75rem;letter-spacing:0.5px;">Share:</span>
                <a href="https://www.facebook.com/sharer/sharer.php?u=@(Context.Request.Scheme)://@(Context.Request.Host)/blog/@Model.Slug" target="_blank" class="share-btn" title="Share on Facebook"><i class="fab fa-facebook-f"></i></a>
                <a href="https://twitter.com/intent/tweet?url=@(Context.Request.Scheme)://@(Context.Request.Host)/blog/@Model.Slug&text=@Model.Title" target="_blank" class="share-btn" title="Share on Twitter"><i class="fab fa-x-twitter"></i></a>
                <a href="https://www.linkedin.com/sharing/share-offsite/?url=@(Context.Request.Scheme)://@(Context.Request.Host)/blog/@Model.Slug" target="_blank" class="share-btn" title="Share on LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                <a href="javascript:void(0);" onclick="navigator.clipboard.writeText(window.location.href); alert('Link copied to clipboard!');" class="share-btn" title="Copy Link"><i class="fas fa-link"></i></a>
            </div>
        </div>
    </div>
</header>

<!-- ═══ Main Blog Details Container ═══ -->
<div class="container py-4">
    <div class="row g-4">
        
        <!-- Left Column: Article Body -->
        <main class="col-lg-8" role="main">
            <!-- Featured Image -->
            <div class="featured-image-wrapper">
                <img src="@Model.FeaturedImagePath" alt="@Model.Title" />
            </div>

            <!-- Key Benefit highlighted box -->
            <div class="benefit-alert-box">
                <i class="far fa-star benefit-alert-icon"></i>
                <div class="benefit-alert-content">
                    <strong>Key Benefit</strong>
                    <p>Understanding these concepts will help you maximize tax benefits, secure structural assets, and ensure full compliance under Indian regulatory frameworks.</p>
                </div>
            </div>

            <!-- HTML Article Body -->
            <article class="article-html-body">
                @Html.Raw(Model.Content)
            </article>

            <!-- Tags block -->
            @if (Model.Tags != null && Model.Tags.Any())
            {
                <div class="post-tags-container">
                    @foreach (var tag in Model.Tags)
                    {
                        <a href="/blog?search=@tag" class="tag-badge">@tag</a>
                    }
                </div>
            }

            <!-- Previous & Next Navigation -->
            <div class="nav-post-container">
                @if (prevPost != null)
                {
                    <a href="/blog/@prevPost.Slug" class="nav-post-link text-start">
                        <span class="nav-post-label"><i class="fas fa-arrow-left me-1"></i> Previous Post</span>
                        <span class="nav-post-title">@prevPost.Title</span>
                    </a>
                }
                else
                {
                    <div style="flex: 1;"></div>
                }

                @if (nextPost != null)
                {
                    <a href="/blog/@nextPost.Slug" class="nav-post-link text-end">
                        <span class="nav-post-label">Next Post <i class="fas fa-arrow-right ms-1"></i></span>
                        <span class="nav-post-title">@nextPost.Title</span>
                    </a>
                }
                else
                {
                    <div style="flex: 1;"></div>
                }
            </div>

            <!-- Related Articles -->
            @if (relatedPosts.Any())
            {
                <div class="related-articles-section">
                    <div class="related-header">
                        <h3>Related Articles</h3>
                        <a href="/blog" class="related-header-link">View All Articles <i class="fas fa-arrow-right"></i></a>
                    </div>
                    <div class="row g-3">
                        @foreach (var r in relatedPosts)
                        {
                            <div class="col-sm-6 col-md-3">
                                <div class="related-card h-100">
                                    <div class="related-card-img-holder">
                                        <img src="@r.FeaturedImagePath" alt="@r.Title" />
                                    </div>
                                    <div class="related-card-body">
                                        <div class="related-card-category">@r.Category</div>
                                        <h4 class="related-card-title">
                                            <a href="/blog/@r.Slug">@r.Title</a>
                                        </h4>
                                        <div class="related-card-footer">
                                            <span>@r.PublishedDate.ToString("MMM dd, yyyy")</span>
                                            <span>@r.ReadTimeMinutes min read</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </main>

        <!-- Right Column: Sidebar Widgets -->
        <aside class="col-lg-4" role="complementary">
            
            <!-- Widget 1: Accuracy Banner -->
            <div class="sidebar-accuracy-card">
                <div class="accuracy-icon-holder">
                    <i class="fas fa-circle-check"></i>
                </div>
                <div class="accuracy-text">
                    <h6>Reviewed for Accuracy</h6>
                    <p>Our content is reviewed by experienced Chartered Accountants to ensure statutory accuracy and compliance reliability.</p>
                </div>
            </div>

            <!-- Widget 2: Table of Contents (TOC) -->
            <div id="toc-card" class="sidebar-widget-card">
                <h5 class="sidebar-widget-title">On This Page</h5>
                <ul id="toc-list" class="toc-list">
                    <!-- Javascript will auto-generate TOC links here -->
                </ul>
            </div>

            <!-- Widget 3: Categories List -->
            <div class="sidebar-widget-card">
                <h5 class="sidebar-widget-title">Categories</h5>
                <ul class="category-list-custom">
                    @foreach (var cat in categoryCounts)
                    {
                        <li class="category-list-item">
                            <a href="/blog?category=@cat.Name">@cat.Name</a>
                            <span class="category-count-badge">@cat.Count</span>
                        </li>
                    }
                </ul>
                <a href="/blog" class="d-block mt-3 text-gold text-decoration-none font-bold text-center small" style="color:#e2a014;">View All Categories <i class="fas fa-arrow-right ms-1"></i></a>
            </div>

            <!-- Widget 4: Popular Posts -->
            <div class="sidebar-widget-card">
                <h5 class="sidebar-widget-title">Popular Posts</h5>
                <div class="popular-posts-list">
                    @foreach (var p in popularPosts)
                    {
                        <div class="popular-post-item">
                            <div class="popular-post-thumbnail">
                                <img src="@p.FeaturedImagePath" alt="@p.Title" />
                            </div>
                            <div class="popular-post-details">
                                <h6 class="popular-post-title">
                                    <a href="/blog/@p.Slug">@p.Title</a>
                                </h6>
                                <span class="popular-post-meta">@p.PublishedDate.ToString("MMM dd, yyyy") &bull; @p.ReadTimeMinutes min read</span>
                            </div>
                        </div>
                    }
                </div>
                <a href="/blog" class="d-block mt-3 text-gold text-decoration-none font-bold text-center small" style="color:#e2a014;">View All Posts <i class="fas fa-arrow-right ms-1"></i></a>
            </div>

            <!-- Widget 5: Newsletter Card -->
            <div class="newsletter-widget-card">
                <div class="newsletter-widget-icon">
                    <i class="far fa-envelope-open"></i>
                </div>
                <h4>Stay Updated</h4>
                <p>Subscribe to our newsletter to receive the latest updates, GST circulars, and tax advisory insights straight in your inbox.</p>
                <div class="newsletter-input-group">
                    <input type="email" placeholder="Enter your email" class="newsletter-input" />
                    <button class="newsletter-submit-btn">Subscribe</button>
                </div>
                <div class="newsletter-privacy-text">
                    <i class="fas fa-lock"></i>
                    <span>We respect your privacy. Unsubscribe at any time.</span>
                </div>
            </div>
            
        </aside>

    </div>
</div>

<!-- ═══ Table of Contents Generation Javascript ═══ -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const body = document.querySelector(".article-html-body");
        const tocList = document.getElementById("toc-list");
        if (body && tocList) {
            const headings = body.querySelectorAll("h3, h2");
            if (headings.length > 0) {
                headings.forEach((heading, index) => {
                    // Create a unique ID for each header
                    const id = "section-heading-" + index;
                    heading.id = id;
                    
                    // Create list item and link
                    const li = document.createElement("li");
                    const a = document.createElement("a");
                    a.href = "#" + id;
                    a.innerText = heading.innerText;
                    
                    // Indent h3 tags a bit if mixed with h2
                    if (heading.tagName.toLowerCase() === "h3") {
                        li.style.paddingLeft = "30px";
                    }
                    
                    li.appendChild(a);
                    tocList.appendChild(li);
                });
            } else {
                // If there are no headings, hide the Table of Contents card
                const tocCard = document.getElementById("toc-card");
                if (tocCard) {
                    tocCard.style.display = "none";
                }
            }
        }
    });
</script>
