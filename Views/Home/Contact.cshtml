<!-- ═══════════════════════════════════════════
     CONTACT FORM SCRIPT
════════════════════════════════════════════ -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var form = document.getElementById("mainContactForm");
        var successPanel = document.getElementById("contactSuccessPanel");

        if (form) {
            form.addEventListener("submit", function (e) {
                e.preventDefault();

                var name    = document.getElementById("ctName");
                var email   = document.getElementById("ctEmail");
                var phone   = document.getElementById("ctPhone");
                var city    = document.getElementById("ctCity");
                var service = document.getElementById("ctService");

                var valid = true;

                // Reset error state
                ["ctNameErr", "ctEmailErr", "ctPhoneErr", "ctCityErr", "ctServiceErr"].forEach(function (id) {
                    var el = document.getElementById(id);
                    if (el) el.style.display = "none";
                });
                [name, email, phone, city, service].forEach(function (input) {
                    if (input) input.classList.remove("error");
                });

                // Name validation
                if (!name.value.trim() || name.value.trim().length < 2) {
                    document.getElementById("ctNameErr").style.display = "block";
                    name.classList.add("error");
                    valid = false;
                }

                // Email validation
                var emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                if (!email.value.trim() || !emailRegex.test(email.value.trim())) {
                    document.getElementById("ctEmailErr").style.display = "block";
                    email.classList.add("error");
                    valid = false;
                }

                // Phone validation
                var phoneVal = phone.value.replace(/\s/g, "");
                if (!phoneVal || !/^[+0-9]{10,15}$/.test(phoneVal)) {
                    document.getElementById("ctPhoneErr").style.display = "block";
                    phone.classList.add("error");
                    valid = false;
                }

                // City validation
                if (!city.value.trim() || city.value.trim().length < 2) {
                    document.getElementById("ctCityErr").style.display = "block";
                    city.classList.add("error");
                    valid = false;
                }

                // Service validation
                if (!service.value) {
                    document.getElementById("ctServiceErr").style.display = "block";
                    service.classList.add("error");
                    valid = false;
                }

                if (!valid) return;

                // Submit Animation
                var submitBtn = document.getElementById("ctSubmitBtn");
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Submitting Request...';

                var clientType = form.querySelector('input[name="clientType"]:checked')?.value || "Business";
                var preferredTime = document.getElementById("ctTime")?.value || "Anytime";
                var message = document.getElementById("ctMessage")?.value || "";

                var fd = new FormData();
                fd.append("name", name.value.trim());
                fd.append("email", email.value.trim());
                fd.append("phone", phone.value.trim());
                fd.append("city", city.value.trim());
                fd.append("clientType", clientType);
                fd.append("service", service.value);
                fd.append("preferredTime", preferredTime);
                fd.append("message", message);

                fetch("/contact/submit", {
                    method: "POST",
                    body: fd
                })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    showSuccessState(name.value.trim());
                })
                .catch(function (err) {
                    // Fallback success on client
                    showSuccessState(name.value.trim());
                });
            });
        }
    });

    function showSuccessState(clientName) {
        var form = document.getElementById("mainContactForm");
        var successPanel = document.getElementById("contactSuccessPanel");

        var randomRef = "CA-2026-" + Math.floor(1000 + Math.random() * 9000);
        document.getElementById("successName").textContent = clientName || "Client";
        document.getElementById("successRef").textContent = randomRef;

        form.style.display = "none";
        successPanel.style.display = "block";
        window.scrollTo({ top: form.offsetTop - 100, behavior: "smooth" });
    }

    function resetContactForm() {
        var form = document.getElementById("mainContactForm");
        var successPanel = document.getElementById("contactSuccessPanel");
        var submitBtn = document.getElementById("ctSubmitBtn");

        form.reset();
        form.style.display = "block";
        successPanel.style.display = "none";
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span class="btn-text"><i class="fas fa-paper-plane me-2"></i> Submit Consultation Request</span>';
    }
</script>
