@model caportal.Models.Entities.CaProfessional
@{
    Layout = "~/Views/Shared/_LandingLayout.cshtml";
    ViewData["Title"] = $"{Model.Name} — CA Profile";
    ViewData["Description"] = $"View the full profile of {Model.Name}, a {Model.Designation} based in {Model.City} specialising in {string.Join(", ", Model.Specialisations.Take(3))}. Book a consultation today.";

    var fee = 499 + (Model.YearsExp * 30) + (Model.Rating > 4.8m ? 200 : 0);
    var stars = (int)Math.Floor((double)Model.Rating);
    var halfStar = (Model.Rating - stars) >= 0.5m;
}

<style>
/* ─── Expert Detail Page ─────────────────────────────── */
.expert-hero {
    background: linear-gradient(135deg, #0a1628 0%, #0d1f33 60%, #14294a 100%);
    padding: 2rem 0 0;
    border-bottom: 1px solid rgba(212,160,23,.18);
}
.expert-breadcrumb { font-size:.8rem; color:rgba(255,255,255,.55); margin-bottom:1.2rem; }
.expert-breadcrumb a { color:rgba(255,255,255,.55); text-decoration:none; }
.expert-breadcrumb a:hover { color:#d4a017; }
.expert-breadcrumb span { color:#d4a017; }

/* Profile Card in Hero */
.expert-profile-card {
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(212,160,23,.18);
    border-radius: 16px 16px 0 0;
    padding: 2rem 2rem 0;
    margin-top: .5rem;
}
.expert-avatar-large {
    width: 110px;
    height: 110px;
    border-radius: 16px;
    background: linear-gradient(135deg, #1a3358, #0d1f33);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    font-weight: 700;
    color: #d4a017;
    border: 3px solid rgba(212,160,23,.4);
    flex-shrink: 0;
    letter-spacing: -2px;
}
.expert-name-block { flex: 1; }
.expert-name {
    font-size: 1.8rem;
    font-weight: 700;
    color: #fff;
    margin: 0;
    display: flex;
    align-items: center;
    gap: .6rem;
    flex-wrap: wrap;
}
.expert-verified {
    background: #22c55e;
    color: #fff;
    font-size: .72rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 20px;
    display: inline-flex;
    align-items: center;
    gap: .25rem;
}
.expert-desig { color: rgba(255,255,255,.65); font-size: .92rem; margin: .35rem 0; }
.expert-tags { display: flex; flex-wrap: wrap; gap: .4rem; margin: .6rem 0; }
.expert-tag {
    background: rgba(212,160,23,.15);
    border: 1px solid rgba(212,160,23,.3);
    color: #d4a017;
    font-size: .75rem;
    font-weight: 500;
    padding: 3px 12px;
    border-radius: 20px;
}
.expert-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: .6rem;
    padding-bottom: 1.5rem;
}
.expert-meta-item { display: flex; align-items: center; gap: .4rem; color: rgba(255,255,255,.7); font-size: .82rem; }
.expert-meta-item i { color: #d4a017; }
.expert-stars { color: #f59e0b; }

/* ─── Sticky CTA Bar ─────────────────────────────────── */
.expert-cta-bar {
    background: #fff;
    border-bottom: 1px solid #e2e8f3;
    padding: .8rem 0;
    position: sticky;
    top: 64px;
    z-index: 90;
    box-shadow: 0 2px 10px rgba(0,0,0,.07);
}
.expert-cta-bar .container { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .75rem; }
.cta-fee-display { display: flex; align-items: baseline; gap: .5rem; }
.cta-fee { font-size: 1.5rem; font-weight: 700; color: #0d1f33; }
.cta-fee-label { font-size: .78rem; color: #6b7a8d; }
.cta-btns { display: flex; gap: .6rem; flex-wrap: wrap; }
.btn-consult {
    background: #d4a017;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: .55rem 1.4rem;
    font-size: .88rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    transition: background .2s;
}
.btn-consult:hover { background: #b8880f; color: #fff; }
.btn-whatsapp-cta {
    border: 2px solid #25d366;
    color: #25d366;
    background: transparent;
    border-radius: 8px;
    padding: .52rem 1.2rem;
    font-size: .88rem;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    transition: all .2s;
}
.btn-whatsapp-cta:hover { background: #25d366; color: #fff; }

/* ─── Page Body ──────────────────────────────────────── */
.expert-body {
    background: #f3f6fb;
    padding: 2rem 0 4rem;
}
.detail-card {
    background: #fff;
    border-radius: 14px;
    border: 1px solid #e2e8f3;
    padding: 1.5rem;
    margin-bottom: 1.25rem;
    box-shadow: 0 2px 10px rgba(0,0,0,.05);
}
.detail-card-title {
    font-size: 1rem;
    font-weight: 700;
    color: #0d1f33;
    margin-bottom: 1rem;
    padding-bottom: .6rem;
    border-bottom: 2px solid #f0f3f8;
    display: flex;
    align-items: center;
    gap: .5rem;
}
.detail-card-title i { color: #d4a017; }

/* Stats Row */
.stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
.stat-item { text-align: center; padding: .8rem; background: #f8fafd; border-radius: 10px; border: 1px solid #eef1f7; }
.stat-number { font-size: 1.4rem; font-weight: 700; color: #0d1f33; }
.stat-label { font-size: .72rem; color: #6b7a8d; font-weight: 500; margin-top: 2px; }

/* About */
.about-text { color: #3a4a5c; font-size: .9rem; line-height: 1.7; }

/* Specialisations Grid */
.spec-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: .5rem; }
.spec-item {
    display: flex;
    align-items: center;
    gap: .5rem;
    background: #f8fafd;
    border-radius: 8px;
    padding: .5rem .75rem;
    font-size: .83rem;
    color: #1a2b42;
    border: 1px solid #eef1f7;
}
.spec-item i { color: #d4a017; font-size: .8rem; }

/* Timeline / Process */
.timeline { position: relative; padding-left: 2rem; }
.timeline::before { content:''; position:absolute; left:.75rem; top:0; bottom:0; width:2px; background:#eef1f7; }
.timeline-item { position: relative; margin-bottom: 1.2rem; }
.timeline-item:last-child { margin-bottom: 0; }
.timeline-dot {
    position: absolute;
    left: -2rem;
    top: .2rem;
    width: 24px;
    height: 24px;
    background: #d4a017;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: .7rem;
    font-weight: 700;
    border: 3px solid #fff;
    box-shadow: 0 0 0 2px rgba(212,160,23,.25);
}
.timeline-title { font-size: .88rem; font-weight: 700; color: #0d1f33; margin-bottom: .2rem; }
.timeline-desc { font-size: .81rem; color: #5a6a7e; }

/* Reviews */
.review-item {
    padding: .8rem 0;
    border-bottom: 1px solid #f0f3f8;
}
.review-item:last-child { border-bottom: none; padding-bottom: 0; }
.review-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: .35rem; }
.reviewer-name { font-size: .88rem; font-weight: 600; color: #0d1f33; }
.review-date { font-size: .75rem; color: #94a3b8; }
.review-stars { color: #f59e0b; font-size: .8rem; margin-bottom: .3rem; }
.review-text { font-size: .83rem; color: #3a4a5c; line-height: 1.6; }

/* FAQ */
.faq-item { border-bottom: 1px solid #f0f3f8; }
.faq-question {
    padding: .85rem 0;
    cursor: pointer;
    font-size: .88rem;
    font-weight: 600;
    color: #0d1f33;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
}
.faq-question i { color: #d4a017; font-size: .75rem; transition: transform .2s; }
.faq-question.open i { transform: rotate(180deg); }
.faq-answer { font-size: .83rem; color: #5a6a7e; line-height: 1.65; padding-bottom: .85rem; display: none; }

/* Sidebar booking card */
.booking-card {
    background: #fff;
    border-radius: 14px;
    border: 2px solid rgba(212,160,23,.35);
    padding: 1.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,.08);
    position: sticky;
    top: 120px;
}
.booking-card-title { font-size: 1.05rem; font-weight: 700; color: #0d1f33; margin-bottom: 1rem; text-align: center; }
.booking-fee-block { text-align: center; margin-bottom: 1.2rem; padding: 1rem; background: #f8fafd; border-radius: 10px; border: 1px solid #eef1f7; }
.booking-fee-amount { font-size: 2rem; font-weight: 700; color: #0d1f33; }
.booking-fee-note { font-size: .72rem; color: #6b7a8d; margin-top: 2px; }
.booking-form input, .booking-form select, .booking-form textarea {
    width: 100%;
    border: 1.5px solid #dde3ec;
    border-radius: 8px;
    padding: .5rem .8rem;
    font-size: .83rem;
    margin-bottom: .6rem;
    outline: none;
    transition: border-color .2s;
    color: #1a2b42;
}
.booking-form input:focus, .booking-form select:focus, .booking-form textarea:focus { border-color: #d4a017; }
.booking-form label { font-size: .76rem; font-weight: 600; color: #5a6a7e; margin-bottom: .2rem; display: block; }
.btn-book-full {
    width: 100%;
    background: #d4a017;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: .7rem;
    font-size: .92rem;
    font-weight: 600;
    cursor: pointer;
    margin-top: .3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .4rem;
    transition: background .2s;
}
.btn-book-full:hover { background: #b8880f; }
.booking-guarantees { margin-top: .9rem; }
.guarantee-item { display: flex; align-items: center; gap: .4rem; font-size: .76rem; color: #5a6a7e; margin-bottom: .35rem; }
.guarantee-item i { color: #22c55e; font-size: .75rem; }

/* Certification badge */
.cert-badge {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    background: #f0f9ff;
    border: 1px solid #bae6fd;
    border-radius: 8px;
    padding: .5rem .8rem;
    font-size: .8rem;
    font-weight: 600;
    color: #0369a1;
    margin: .3rem;
}
.cert-badge i { color: #0ea5e9; }

@@media (max-width: 768px) {
    .expert-name { font-size: 1.4rem; }
    .expert-avatar-large { width: 80px; height: 80px; font-size: 1.8rem; }
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .spec-grid { grid-template-columns: 1fr; }
}
</style>

<!-- Expert Hero / Profile Header -->
<section class="expert-hero">
    <div class="container">
        <nav class="expert-breadcrumb" aria-label="breadcrumb">
            <a href="/">Home</a> &rsaquo;
            <a href="/find-expert">Find CA</a> &rsaquo;
            <a href="/find-expert?city=@Model.City">@Model.City</a> &rsaquo;
            <span>@Model.Name</span>
        </nav>

        <div class="expert-profile-card">
                <div class="expert-avatar-large">
                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <img src="@Model.ImagePath" alt="@Model.Name" style="width:100%;height:100%;object-fit:cover;border-radius:12px;" />
                    }
                    else
                    {
                        <span>@Model.Initials</span>
                    }
                </div>
                <div class="expert-name-block">
                    <h1 class="expert-name">
                        @Model.Name
                        @if (Model.IsVerified)
                        {
                            <span class="expert-verified"><i class="fas fa-shield-alt"></i> Verified CA</span>
                        }
                    </h1>
                    <div class="expert-desig">@Model.Designation · ICAI Member No. @Model.MembershipNo</div>
                    <div class="expert-tags">
                        @foreach (var t in Model.Specialisations)
                        {
                            <span class="expert-tag">@t</span>
                        }
                    </div>
                    <div class="expert-meta-row">
                        <div class="expert-meta-item">
                            <i class="fas fa-star"></i>
                            <span class="expert-stars">@(string.Concat(Enumerable.Repeat("★", stars)))</span>
                            <strong style="color:#fff;">@Model.Rating</strong>
                            <span>(@(Model.CasesHandled / 3) Reviews)</span>
                        </div>
                        <div class="expert-meta-item"><i class="fas fa-map-marker-alt"></i> @Model.City</div>
                        <div class="expert-meta-item"><i class="fas fa-briefcase"></i> @Model.YearsExp+ Yrs Experience</div>
                        <div class="expert-meta-item"><i class="fas fa-users"></i> @Model.CasesHandled+ Clients</div>
                        <div class="expert-meta-item"><i class="fas fa-clock"></i> Replies in @Model.ResponseTime</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Sticky CTA Bar -->
<div class="expert-cta-bar">
    <div class="container">
        <div class="cta-fee-display">
            <div>
                <div class="cta-fee-label">Starting Consultation Fee</div>
                <div class="cta-fee">₹@fee <small style="font-size:.7rem;font-weight:400;color:#6b7a8d;">(incl. taxes)</small></div>
            </div>
        </div>
        <div class="cta-btns">
            <a href="tel:+919876543210" class="btn-consult"><i class="fas fa-phone-alt"></i> Contact Now</a>
            <a href="https://wa.me/919876543210" class="btn-whatsapp-cta" target="_blank"><i class="fab fa-whatsapp"></i> WhatsApp</a>
            <a href="#booking-form" class="btn-consult" style="background:#0d1f33;"><i class="fas fa-calendar-check"></i> Book Consultation</a>
        </div>
    </div>
</div>

<!-- Main Body -->
<div class="expert-body">
    <div class="container">
        <div class="row g-3">
            <!-- Left / Main Content -->
            <div class="col-lg-8">

                <!-- Stats -->
                <div class="detail-card">
                    <div class="stats-grid">
                        <div class="stat-item">
                            <div class="stat-number">@Model.YearsExp+</div>
                            <div class="stat-label">Years Experience</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-number">@Model.CasesHandled+</div>
                            <div class="stat-label">Clients Served</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-number" style="color:#d4a017;">@Model.Rating★</div>
                            <div class="stat-label">Overall Rating</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-number">@Model.ResponseTime</div>
                            <div class="stat-label">Avg. Response Time</div>
                        </div>
                    </div>
                </div>

                <!-- About -->
                <div class="detail-card">
                    <div class="detail-card-title"><i class="fas fa-user-circle"></i> About @Model.Name</div>
                    <p class="about-text">
                        @Model.Name is a distinguished @Model.Designation (Membership No. @Model.MembershipNo) with over @Model.YearsExp years of hands-on experience in
                        @string.Join(", ", Model.Specialisations). Based out of @Model.City, @Model.Name has successfully guided @Model.CasesHandled+ clients
                        ranging from startups and SMEs to large corporates, helping them navigate complex regulatory landscapes with precision and integrity.
                    </p>
                    <p class="about-text">
                        Known for proactive communication, @Model.Name ensures clients receive timely updates and clear explanations at every step. With a commitment
                        to accuracy and client confidentiality, @Model.Name is the trusted advisor for businesses looking for reliable financial and legal compliance solutions.
                    </p>
                </div>

                <!-- Specialisations -->
                <div class="detail-card">
                    <div class="detail-card-title"><i class="fas fa-tasks"></i> Areas of Specialisation</div>
                    <div class="spec-grid">
                        @foreach (var s in Model.Specialisations)
                        {
                            <div class="spec-item"><i class="fas fa-check-circle"></i> @s</div>
                        }
                        @{
                            var extras = new[]{ "Tax Advisory", "ICAI Standards Compliance", "Regulatory Filings", "Financial Planning", "Business Structuring", "Due Diligence" };
                            foreach (var e in extras.Take(Math.Max(0, 6 - Model.Specialisations.Length)))
                            {
                                <div class="spec-item"><i class="fas fa-check-circle"></i> @e</div>
                            }
                        }
                    </div>
                </div>

                <!-- How It Works -->
                <div class="detail-card">
                    <div class="detail-card-title"><i class="fas fa-route"></i> How Consultation Works</div>
                    <div class="timeline">
                        @{
                            var steps = new[]{
                                ("Share Your Requirement", "Fill in the consultation form with your business needs and choose a preferred time slot."),
                                ("Get a Callback", $"{Model.Name} reviews your requirement and typically responds within {Model.ResponseTime}."),
                                ("Initial Consultation", "A 30-minute call to understand your situation and outline the scope of work."),
                                ("Proposal & Agreement", "Receive a detailed proposal with timelines, deliverables and fees."),
                                ("Ongoing Support", "Regular updates, document review and compliance monitoring throughout the engagement.")
                            };
                        }
                        @for (int si = 0; si < steps.Length; si++)
                        {
                            <div class="timeline-item">
                                <div class="timeline-dot">@(si + 1)</div>
                                <div class="timeline-title">@steps[si].Item1</div>
                                <div class="timeline-desc">@steps[si].Item2</div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Certifications -->
                <div class="detail-card">
                    <div class="detail-card-title"><i class="fas fa-certificate"></i> Certifications &amp; Memberships</div>
                    <div>
                        <span class="cert-badge"><i class="fas fa-award"></i> ICAI Member — @Model.MembershipNo</span>
                        <span class="cert-badge"><i class="fas fa-graduation-cap"></i> @Model.Designation Qualified</span>
                        <span class="cert-badge"><i class="fas fa-user-shield"></i> DISA Certified</span>
                        <span class="cert-badge"><i class="fas fa-globe"></i> FEMA Practitioner</span>
                    </div>
                </div>

                <!-- Reviews -->
                <div class="detail-card">
                    <div class="detail-card-title"><i class="fas fa-star"></i> Client Reviews</div>
                    @{
                        var reviews = new[]{
                            ("Ramesh A.","Business Owner","★★★★★", "Exceptional expertise in GST compliance. @Model.Name resolved our multi-state registration issue in record time. Highly recommended!"),
                            ("Nisha P.","Managing Director","★★★★★", "Extremely thorough and professional. Our audit was completed ahead of schedule with zero complications. Will definitely hire again."),
                            ("Vikram S.","Enterprise Client","★★★★☆", "Very knowledgeable and responsive. Made a complex tax litigation case look straightforward. Great communicator too."),
                        };
                    }
                    @foreach (var (name, role, stars2, text) in reviews)
                    {
                        var reviewText = text.Replace("@Model.Name", Model.Name);
                        <div class="review-item">
                            <div class="review-header">
                                <div>
                                    <div class="reviewer-name">@name</div>
                                    <div style="font-size:.75rem;color:#6b7a8d;">@role</div>
                                </div>
                                <div class="review-date">2 months ago</div>
                            </div>
                            <div class="review-stars">@stars2</div>
                            <div class="review-text">@reviewText</div>
                        </div>
                    }
                </div>

                <!-- FAQ -->
                <div class="detail-card">
                    <div class="detail-card-title"><i class="fas fa-question-circle"></i> Frequently Asked Questions</div>
                    @{
                        var faqs = new[]{
                            ($"How experienced is {Model.Name}?", $"{Model.Name} has {Model.YearsExp}+ years of experience and has served {Model.CasesHandled}+ clients across India."),
                            ("How do I book a consultation?", "Click 'Book Consultation' or fill the form on this page. You'll receive a confirmation within the response time mentioned."),
                            ("What documents should I prepare?", "Depending on your requirement, you may need PAN card, GST certificate, financials, or company registration documents. The CA will guide you after the initial call."),
                            ("Is the consultation fee refundable?", "Yes. If we're unable to resolve your query in the first consultation, a full refund is initiated within 3 business days."),
                            ("What languages does the CA communicate in?", "English and Hindi. Regional language support may be available on request."),
                        };
                    }
                    @foreach (var (q, a) in faqs)
                    {
                        <div class="faq-item">
                            <div class="faq-question" onclick="toggleFaq(this)">
                                @q <i class="fas fa-chevron-down"></i>
                            </div>
                            <div class="faq-answer">@a</div>
                        </div>
                    }
                </div>

            </div>

            <!-- Right Sidebar — Booking Card -->
            <div class="col-lg-4">
                <div class="booking-card" id="booking-form">
                    <div class="booking-card-title">Book a Consultation</div>
                    <div class="booking-fee-block">
                        <div class="booking-fee-amount">₹@fee</div>
                        <div class="booking-fee-note">Starting consultation fee (incl. all taxes)</div>
                    </div>
                    <div class="booking-form">
                        <div>
                            <label>Your Full Name *</label>
                            <input type="text" placeholder="Enter your full name" id="bookName" />
                        </div>
                        <div>
                            <label>Mobile Number *</label>
                            <input type="tel" placeholder="Your Phone Number" id="bookPhone" />
                        </div>
                        <div>
                            <label>Email Address</label>
                            <input type="email" placeholder="your@email.com" id="bookEmail" />
                        </div>
                        <div>
                            <label>Service Required *</label>
                            <select id="bookService">
                                <option value="">Select service...</option>
                                @foreach (var s in Model.Specialisations)
                                {
                                    <option>@s</option>
                                }
                                <option>Other</option>
                            </select>
                        </div>
                        <div>
                            <label>Brief Description</label>
                            <textarea rows="3" placeholder="Briefly describe your requirement..." id="bookDesc"></textarea>
                        </div>
                        <button class="btn-book-full" onclick="handleBooking()">
                            <i class="fas fa-calendar-check"></i> Book Consultation
                        </button>
                    </div>
                    <div class="booking-guarantees">
                        <div class="guarantee-item"><i class="fas fa-check-circle"></i> Free cancellation within 24 hours</div>
                        <div class="guarantee-item"><i class="fas fa-check-circle"></i> Secure transparent billing</div>
                        <div class="guarantee-item"><i class="fas fa-check-circle"></i> Verified ICAI member</div>
                        <div class="guarantee-item"><i class="fas fa-check-circle"></i> Satisfaction guarantee</div>
                    </div>
                </div>

                <!-- Similar Experts Card -->
                <div class="detail-card mt-3">
                    <div class="detail-card-title"><i class="fas fa-users"></i> Similar Experts in @Model.City</div>
                    @{
                        var sim = new[]{("AR","Ankit Rao","FCA, 8 Yrs","₹399","4.8"),("PK","Priya Kumar","ACA, 5 Yrs","₹349","4.7"),("SV","Suresh Verma","FCA, 14 Yrs","₹649","4.9")};
                    }
                    @foreach (var (init,nm,dsg,fee2,rat) in sim)
                    {
                        <div class="d-flex align-items-center gap-2 mb-2 p-2" style="border-radius:8px;border:1px solid #eef1f7;">
                            <div style="width:42px;height:42px;border-radius:8px;background:linear-gradient(135deg,#0d1f33,#1a3358);display:flex;align-items:center;justify-content:center;font-size:.85rem;font-weight:700;color:#d4a017;flex-shrink:0;">@init</div>
                            <div class="flex-grow-1">
                                <div style="font-size:.83rem;font-weight:600;color:#0d1f33;">@nm</div>
                                <div style="font-size:.72rem;color:#6b7a8d;">@dsg · ⭐ @rat</div>
                            </div>
                            <div style="font-size:.8rem;font-weight:600;color:#d4a017;">@fee2</div>
                        </div>
                    }
                    <a href="/find-expert?city=@Model.City" class="show-more-link" style="display:block;margin-top:.5rem;font-size:.8rem;">
                        View all CAs in @Model.City →
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function toggleFaq(el) {
    const answer = el.nextElementSibling;
    const isOpen = el.classList.contains('open');
    document.querySelectorAll('.faq-question').forEach(q => {
        q.classList.remove('open');
        q.nextElementSibling.style.display = 'none';
    });
    if (!isOpen) {
        el.classList.add('open');
        answer.style.display = 'block';
    }
}
function handleBooking() {
    const name = document.getElementById('bookName').value.trim();
    const phone = document.getElementById('bookPhone').value.trim();
    const svc = document.getElementById('bookService').value;
    if (!name || !phone || !svc) {
        alert('Please fill in Name, Mobile, and Service fields.');
        return;
    }
    const btn = document.querySelector('.btn-book-full');
    btn.innerHTML = '<i class="fas fa-check"></i> Request Sent!';
    btn.style.background = '#22c55e';
    setTimeout(() => {
        btn.innerHTML = '<i class="fas fa-calendar-check"></i> Book Consultation';
        btn.style.background = '';
    }, 3000);
}
</script>
