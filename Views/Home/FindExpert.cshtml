@{
    Layout = "~/Views/Shared/_LandingLayout.cshtml";
    ViewData["Title"] = "Find a CA Expert";
    ViewData["Description"] = "Browse 12,000+ ICAI-verified Chartered Accountants across India. Filter by city, specialisation, experience and rating to find the right CA for your needs.";

    var allProfessionals = ViewBag.Professionals as List<caportal.Models.CaProfessional> ?? new List<caportal.Models.CaProfessional>();
    var totalCount = allProfessionals.Count;
    int page = ViewBag.Page ?? 1;
    int pageSize = 10;
    int totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);
    var paged = allProfessionals.Skip((page - 1) * pageSize).Take(pageSize).ToList();

    string qCity    = ViewBag.QCity    ?? "";
    string qService = ViewBag.QService ?? "";
    string qExp     = ViewBag.QExp     ?? "";
    string qRating  = ViewBag.QRating  ?? "";
    string qSort    = ViewBag.QSort    ?? "relevant";
}

<style>
/* ─── Find Expert Page ─────────────────────────────────── */
.find-hero {
    background: linear-gradient(135deg, #0a1628 0%, #0d1f33 60%, #14294a 100%);
    padding: 3rem 0 2.5rem;
    border-bottom: 1px solid rgba(212,160,23,.18);
}
.find-hero h1 {
    font-size: 2.2rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: .5rem;
}
.find-hero h1 span { color: #d4a017; }
.find-hero p { color: rgba(255,255,255,.7); margin-bottom: 0; }

.find-trust-badge {
    background: rgba(212,160,23,.12);
    border: 1px solid rgba(212,160,23,.25);
    border-radius: 12px;
    padding: .8rem 1.2rem;
    text-align: center;
    color: #d4a017;
    font-weight: 600;
    font-size: .85rem;
    white-space: nowrap;
}

/* ─── Filter Bar ─────────────────────────────────────────── */
.filter-bar {
    background: #fff;
    border-bottom: 1px solid #e8edf4;
    padding: .75rem 0;
    box-shadow: 0 2px 8px rgba(0,0,0,.05);
    position: sticky;
    top: 64px;
    z-index: 90;
}
.filter-bar select, .filter-bar input[type=text] {
    border: 1.5px solid #dde3ec;
    border-radius: 8px;
    padding: .45rem .9rem;
    font-size: .85rem;
    color: #1a2b42;
    background: #f8fafd;
    min-width: 120px;
    cursor: pointer;
    outline: none;
    transition: border-color .2s;
}
.filter-bar select:focus, .filter-bar input:focus { border-color: #d4a017; }
.filter-bar .filter-label {
    font-size: .78rem;
    color: #6b7a8d;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .04em;
    margin-bottom: 2px;
}

/* ─── Layout ─────────────────────────────────────────────── */
.find-layout {
    background: #f3f6fb;
    padding: 1.5rem 0 3rem;
    min-height: 70vh;
}

/* ─── Sidebar ────────────────────────────────────────────── */
.filter-sidebar {
    background: #fff;
    border-radius: 14px;
    border: 1px solid #e2e8f3;
    padding: 1.2rem;
    box-shadow: 0 2px 12px rgba(0,0,0,.06);
    position: sticky;
    top: 120px;
}
.filter-sidebar-title {
    font-size: 1rem;
    font-weight: 700;
    color: #0d1f33;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.filter-sidebar-title a { font-size: .78rem; font-weight: 500; color: #d4a017; text-decoration: none; }
.filter-group { margin-bottom: 1.2rem; border-top: 1px solid #eef1f7; padding-top: 1rem; }
.filter-group:first-child { border-top: none; padding-top: 0; }
.filter-group-header {
    font-size: .82rem;
    font-weight: 700;
    color: #0d1f33;
    text-transform: uppercase;
    letter-spacing: .05em;
    margin-bottom: .6rem;
    display: flex;
    justify-content: space-between;
    cursor: pointer;
}
.filter-group-header i { font-size: .7rem; color: #94a3b8; }
.filter-checkbox {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: .4rem;
}
.filter-checkbox label {
    display: flex;
    align-items: center;
    gap: .5rem;
    font-size: .83rem;
    color: #3a4a5c;
    cursor: pointer;
    margin: 0;
}
.filter-checkbox input[type=checkbox] { width: 14px; height: 14px; accent-color: #d4a017; }
.filter-count { font-size: .72rem; color: #94a3b8; background: #f0f3f8; border-radius: 20px; padding: 1px 7px; }
.show-more-link { font-size: .78rem; color: #d4a017; text-decoration: none; font-weight: 500; }

/* City search */
.city-search {
    width: 100%;
    border: 1.5px solid #dde3ec;
    border-radius: 8px;
    padding: .4rem .7rem;
    font-size: .82rem;
    margin-bottom: .6rem;
    outline: none;
}
.city-search:focus { border-color: #d4a017; }

/* ─── Results Area ─────────────────────────────────────── */
.results-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: .5rem;
}
.results-count { font-size: .9rem; color: #5a6a7e; }
.results-count strong { color: #0d1f33; }
.sort-select {
    border: 1.5px solid #dde3ec;
    border-radius: 8px;
    padding: .38rem .8rem;
    font-size: .83rem;
    color: #1a2b42;
    background: #fff;
    outline: none;
    cursor: pointer;
}

/* ─── CA Card ────────────────────────────────────────────── */
.ca-expert-card {
    background: #fff;
    border-radius: 14px;
    border: 1px solid #e2e8f3;
    padding: 1.25rem;
    margin-bottom: 1rem;
    box-shadow: 0 2px 10px rgba(0,0,0,.05);
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    transition: box-shadow .25s, transform .2s;
    position: relative;
    overflow: hidden;
}
.ca-expert-card:hover {
    box-shadow: 0 8px 28px rgba(13,31,51,.12);
    transform: translateY(-2px);
    border-color: #d4a017;
}
.ca-expert-card::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
    background: linear-gradient(180deg, #d4a017, #f0c040);
    border-radius: 4px 0 0 4px;
}
.ca-avatar {
    width: 88px;
    height: 88px;
    border-radius: 12px;
    background: linear-gradient(135deg, #0d1f33, #1a3358);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    font-weight: 700;
    color: #d4a017;
    flex-shrink: 0;
    border: 2px solid rgba(212,160,23,.25);
    letter-spacing: -1px;
}
.ca-card-body { flex: 1; min-width: 0; }
.ca-card-top { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: .4rem; }
.ca-name {
    font-size: 1.12rem;
    font-weight: 700;
    color: #0d1f33;
    margin: 0;
    display: flex;
    align-items: center;
    gap: .4rem;
}
.ca-verified-badge {
    display: inline-flex;
    align-items: center;
    gap: .2rem;
    background: #e8f5e9;
    color: #2e7d32;
    font-size: .7rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 20px;
}
.ca-verified-badge i { font-size: .65rem; }
.ca-designation { font-size: .82rem; color: #5a6a7e; margin-bottom: .4rem; }
.ca-specialisation-tags { display: flex; flex-wrap: wrap; gap: .35rem; margin: .45rem 0; }
.ca-tag {
    background: #eef4ff;
    color: #2563eb;
    font-size: .72rem;
    font-weight: 500;
    padding: 2px 10px;
    border-radius: 20px;
}
.ca-tag.more { background: #f0f3f8; color: #6b7a8d; }
.ca-meta { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; margin-top: .4rem; }
.ca-meta-item { display: flex; align-items: center; gap: .3rem; font-size: .78rem; color: #5a6a7e; }
.ca-meta-item i { color: #d4a017; font-size: .75rem; }
.ca-stars { color: #f59e0b; font-size: .8rem; }
.ca-rating-val { font-size: .83rem; font-weight: 700; color: #0d1f33; }
.ca-reviews { font-size: .75rem; color: #6b7a8d; }
.ca-card-right { display: flex; flex-direction: column; align-items: flex-end; gap: .5rem; flex-shrink: 0; min-width: 160px; }
.ca-fee-label { font-size: .7rem; color: #6b7a8d; text-align: right; }
.ca-fee { font-size: 1.4rem; font-weight: 700; color: #0d1f33; text-align: right; line-height: 1.2; }
.ca-fee small { font-size: .72rem; font-weight: 400; color: #6b7a8d; display: block; }
.ca-card-actions { display: flex; flex-direction: column; gap: .4rem; width: 100%; }
.btn-ca-contact {
    background: #d4a017;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: .45rem .9rem;
    font-size: .82rem;
    font-weight: 600;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    transition: background .2s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .35rem;
    white-space: nowrap;
}
.btn-ca-contact:hover { background: #b8880f; color: #fff; }
.btn-ca-profile {
    border: 1.5px solid #d4a017;
    color: #d4a017;
    background: transparent;
    border-radius: 8px;
    padding: .42rem .9rem;
    font-size: .82rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .35rem;
    transition: all .2s;
    white-space: nowrap;
}
.btn-ca-profile:hover { background: #d4a017; color: #fff; }
.btn-ca-whatsapp {
    border: 1.5px solid #25d366;
    color: #25d366;
    background: transparent;
    border-radius: 8px;
    padding: .42rem .9rem;
    font-size: .82rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .35rem;
    transition: all .2s;
    white-space: nowrap;
}
.btn-ca-whatsapp:hover { background: #25d366; color: #fff; }

/* ─── Pagination ─────────────────────────────────────────── */
.pagination { display: flex; align-items: center; gap: .4rem; justify-content: center; margin-top: 2rem; flex-wrap: wrap; }
.page-btn {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    border: 1.5px solid #dde3ec;
    background: #fff;
    color: #3a4a5c;
    font-size: .85rem;
    font-weight: 500;
    text-decoration: none;
    transition: all .2s;
}
.page-btn:hover { border-color: #d4a017; color: #d4a017; }
.page-btn.active { background: #d4a017; border-color: #d4a017; color: #fff; font-weight: 700; }
.page-btn.disabled { opacity: .4; pointer-events: none; }

@@media (max-width: 768px) {
    .find-hero h1 { font-size: 1.6rem; }
    .ca-expert-card { flex-direction: column; }
    .ca-card-right { align-items: flex-start; min-width: unset; width: 100%; }
    .ca-card-actions { flex-direction: row; }
    .ca-avatar { width: 64px; height: 64px; font-size: 1.2rem; }
}
</style>

<!-- Hero Banner -->
<section class="find-hero">
    <div class="container">
        <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
            <div>
                <nav aria-label="breadcrumb" class="mb-2">
                    <ol class="breadcrumb mb-0" style="font-size:.8rem; background:transparent; padding:0;">
                        <li class="breadcrumb-item"><a href="/" style="color:rgba(255,255,255,.55);">Home</a></li>
                        <li class="breadcrumb-item active" style="color:rgba(255,255,255,.75);">Find CA</li>
                        <li class="breadcrumb-item active" style="color:#d4a017;">Chartered Accountants in India</li>
                    </ol>
                </nav>
                <h1>Find the Best <span>Chartered Accountants</span> in India</h1>
                <p>Connect with verified CAs for your tax, compliance, audit &amp; business needs.</p>
            </div>
            <div class="find-trust-badge d-none d-md-block">
                <div style="font-size:1.3rem;">&#127942;</div>
                <div style="font-size:1rem; font-weight:700; color:#fff;">25,000+</div>
                <div>Clients Connected</div>
                <div style="color:rgba(255,255,255,.6); font-size:.72rem;">Trusted CA Network Across India</div>
            </div>
        </div>
    </div>
</section>

<!-- Filter Bar -->
<div class="filter-bar">
    <div class="container">
        <form method="get" action="/find-expert" class="d-flex align-items-end gap-2 flex-wrap">
            <div>
                <div class="filter-label">City</div>
                <select name="city" id="filterCity">
                    <option value="">All Cities</option>
                    @foreach (var c in new[]{"Mumbai","Delhi","Bangalore","Pune","Hyderabad","Chennai","Kolkata","Ahmedabad","Jaipur","Lucknow"})
                    {
                        <option value="@c" selected="@(qCity==c?"selected":null)">@c</option>
                    }
                </select>
            </div>
            <div>
                <div class="filter-label">Service</div>
                <select name="service" id="filterService">
                    <option value="">All Services</option>
                    @foreach (var s in new[]{"GST Filing","Income Tax","Company Registration","Audit","Transfer Pricing","FEMA","Startup Finance","Tax Litigation","ROC Filing","Bookkeeping"})
                    {
                        <option value="@s" selected="@(qService==s?"selected":null)">@s</option>
                    }
                </select>
            </div>
            <div>
                <div class="filter-label">Experience</div>
                <select name="exp" id="filterExp">
                    <option value="">Any Experience</option>
                    <option value="0-5"  selected="@(qExp=="0-5"?"selected":null)">0–5 Years</option>
                    <option value="5-10" selected="@(qExp=="5-10"?"selected":null)">5–10 Years</option>
                    <option value="10+"  selected="@(qExp=="10+"?"selected":null)">10+ Years</option>
                </select>
            </div>
            <div>
                <div class="filter-label">Rating</div>
                <select name="rating" id="filterRating">
                    <option value="">Any Rating</option>
                    <option value="4.5" selected="@(qRating=="4.5"?"selected":null)">4.5 &amp; above</option>
                    <option value="4"   selected="@(qRating=="4"?"selected":null)">4 &amp; above</option>
                    <option value="3.5" selected="@(qRating=="3.5"?"selected":null)">3.5 &amp; above</option>
                </select>
            </div>
            <div>
                <div class="filter-label">Sort By</div>
                <select name="sort" id="filterSort">
                    <option value="relevant" selected="@(qSort=="relevant"?"selected":null)">Most Relevant</option>
                    <option value="rating"   selected="@(qSort=="rating"?"selected":null)">Highest Rated</option>
                    <option value="exp"      selected="@(qSort=="exp"?"selected":null)">Most Experienced</option>
                    <option value="fee_asc"  selected="@(qSort=="fee_asc"?"selected":null)">Fee: Low to High</option>
                    <option value="fee_desc" selected="@(qSort=="fee_desc"?"selected":null)">Fee: High to Low</option>
                </select>
            </div>
            <button type="submit" class="btn" style="background:#d4a017;color:#fff;border-radius:8px;padding:.45rem 1.2rem;font-weight:600;font-size:.85rem;border:none;">
                <i class="fas fa-search me-1"></i> Search
            </button>
        </form>
    </div>
</div>

<!-- Main Layout -->
<div class="find-layout">
    <div class="container">
        <div class="row g-3">

            <!-- Sidebar Filters -->
            <div class="col-lg-3 d-none d-lg-block">
                <div class="filter-sidebar">
                    <div class="filter-sidebar-title">
                        <span><i class="fas fa-sliders-h me-2" style="color:#d4a017;"></i>Filter Results</span>
                        <a href="/find-expert">Clear All</a>
                    </div>

                    <!-- Services Filter -->
                    <div class="filter-group">
                        <div class="filter-group-header">Services <i class="fas fa-chevron-up"></i></div>
                        @{
                            var sideServices = new[]{
                                ("GST Filing",1203),("Income Tax Return",1540),("Company Registration",987),
                                ("Audit & Assurance",876),("TDS Compliance",654)
                            };
                        }
                        @foreach (var (svc, cnt) in sideServices)
                        {
                            <div class="filter-checkbox">
                                <label>
                                    <input type="checkbox" @(qService==svc?"checked":"") />
                                    @svc
                                </label>
                                <span class="filter-count">@cnt</span>
                            </div>
                        }
                        <a href="#" class="show-more-link">+ Show More</a>
                    </div>

                    <!-- Experience Filter -->
                    <div class="filter-group">
                        <div class="filter-group-header">Experience <i class="fas fa-chevron-up"></i></div>
                        @foreach (var (exp, cnt) in new[]{("0 - 5 Years",1240),("5 - 10 Years",1350),("10+ Years",2150)})
                        {
                            <div class="filter-checkbox">
                                <label><input type="checkbox" /> @exp</label>
                                <span class="filter-count">@cnt</span>
                            </div>
                        }
                    </div>

                    <!-- Rating Filter -->
                    <div class="filter-group">
                        <div class="filter-group-header">Rating <i class="fas fa-chevron-up"></i></div>
                        @foreach (var (stars, cnt) in new[]{("⭐⭐⭐⭐⭐",2420),("⭐⭐⭐⭐ & above",1800),("⭐⭐⭐ & above",520)})
                        {
                            <div class="filter-checkbox">
                                <label><input type="checkbox" /> @stars</label>
                                <span class="filter-count">@cnt</span>
                            </div>
                        }
                    </div>

                    <!-- City Filter -->
                    <div class="filter-group">
                        <div class="filter-group-header">City <i class="fas fa-chevron-up"></i></div>
                        <input type="text" class="city-search" placeholder="Search city..." />
                        @foreach (var (city, cnt) in new[]{("Mumbai",1200),("Pune",980),("Delhi",870),("Bangalore",760),("Hyderabad",540)})
                        {
                            <div class="filter-checkbox">
                                <label>
                                    <input type="checkbox" @(qCity==city?"checked":"") />
                                    @city
                                </label>
                                <span class="filter-count">@cnt</span>
                            </div>
                        }
                        <a href="#" class="show-more-link">+ Show More</a>
                    </div>
                </div>
            </div>

            <!-- Results -->
            <div class="col-lg-9">
                <div class="results-header">
                    <div class="results-count">
                        Showing <strong>@((page-1)*pageSize+1)–@(Math.Min(page*pageSize, totalCount))</strong> of <strong>@totalCount</strong> Results
                    </div>
                    <select class="sort-select" onchange="this.form?.submit()">
                        <option>Most Relevant</option>
                        <option>Highest Rated</option>
                        <option>Most Experienced</option>
                    </select>
                </div>

                @foreach (var p in paged)
                {
                    var slug = p.Name.ToLower().Replace("ca ","").Replace(" ","-");
                    var displayTags = p.Specialisations.Take(3).ToArray();
                    var moreTags = p.Specialisations.Length > 3 ? p.Specialisations.Length - 3 : 0;
                    var stars = (int)Math.Floor((double)p.Rating);
                    var fee = 499 + (p.YearsExp * 30) + (p.Rating > 4.8m ? 200 : 0);

                    <div class="ca-expert-card">
                        <div class="ca-avatar">@p.Initials</div>
                        <div class="ca-card-body">
                            <div class="ca-card-top">
                                <div>
                                    <div class="ca-name">
                                        @p.Name
                                        @if (p.IsVerified)
                                        {
                                            <span class="ca-verified-badge"><i class="fas fa-shield-alt"></i> Verified CA</span>
                                        }
                                    </div>
                                    <div class="ca-designation">@p.Designation · @(p.Specialisations.FirstOrDefault() ?? "CA Expert")</div>
                                </div>
                                <div class="text-end">
                                    <div class="ca-stars">@(string.Concat(Enumerable.Repeat("★", stars)))</div>
                                    <span class="ca-rating-val">@p.Rating</span>
                                    <span class="ca-reviews">(@(p.CasesHandled / 3) Reviews)</span>
                                </div>
                            </div>
                            <div class="ca-specialisation-tags">
                                @foreach (var t in displayTags)
                                {
                                    <span class="ca-tag">@t</span>
                                }
                                @if (moreTags > 0)
                                {
                                    <span class="ca-tag more">+@moreTags More</span>
                                }
                            </div>
                            <div class="ca-meta">
                                <div class="ca-meta-item"><i class="fas fa-map-marker-alt"></i> @p.City</div>
                                <div class="ca-meta-item"><i class="fas fa-calendar-alt"></i> @p.YearsExp+ Years Experience</div>
                                <div class="ca-meta-item"><i class="fas fa-users"></i> @p.CasesHandled+ Clients Served</div>
                                <div class="ca-meta-item"><i class="fas fa-language"></i> English, Hindi</div>
                            </div>
                        </div>
                        <div class="ca-card-right">
                            <div>
                                <div class="ca-fee-label">Starting Consultation Fee</div>
                                <div class="ca-fee">
                                    ₹@fee
                                    <small>(Inclusive of all taxes)</small>
                                </div>
                            </div>
                            <div class="ca-card-actions">
                                <a href="tel:+919876543210" class="btn-ca-contact"><i class="fas fa-phone-alt"></i> Contact Now</a>
                                <a href="/expert/@slug-@p.Id" class="btn-ca-profile"><i class="fas fa-user"></i> View Profile</a>
                                <a href="https://wa.me/919876543210" class="btn-ca-whatsapp" target="_blank"><i class="fab fa-whatsapp"></i> WhatsApp</a>
                            </div>
                        </div>
                    </div>
                }

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <div class="pagination">
                        <a href="/find-expert?page=@(page-1)" class="page-btn @(page<=1?"disabled":"")"><i class="fas fa-chevron-left"></i></a>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            if (i == 1 || i == totalPages || (i >= page - 2 && i <= page + 2))
                            {
                                <a href="/find-expert?page=@i" class="page-btn @(i==page?"active":"")">@i</a>
                            }
                            else if (i == page - 3 || i == page + 3)
                            {
                                <span class="page-btn" style="border:none;pointer-events:none;">…</span>
                            }
                        }
                        <a href="/find-expert?page=@(page+1)" class="page-btn @(page>=totalPages?"disabled":"")"><i class="fas fa-chevron-right"></i></a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
