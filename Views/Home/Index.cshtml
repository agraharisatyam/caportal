@model caportal.Models.HomeViewModel
@{
    ViewData["Title"] = "Find Verified Chartered Accountants";
    Layout = "~/Views/Shared/_LandingLayout.cshtml";
    var featured = Model.FeaturedProfessionals.Where(p => p.IsFeatured).ToList();
}

<!-- ═══════════════════════════════════════
     HERO V2 — Dark gold, full-width
════════════════════════════════════════ -->
<section class="hero-v2" aria-labelledby="hero-heading">
    <div class="hero-v2-overlay" aria-hidden="true"></div>
    <div class="container position-relative" style="z-index:2;">

        <div class="hero-v2-label">
            <i class="fas fa-star me-1" style="color:#d4a017;font-size:.7rem;"></i>
            India's #1 CA &amp; Legal Compliance Platform
        </div>

        <h1 class="hero-v2-title" id="hero-heading">
            CA &amp; Legal Compliance<br>
            <span class="hero-v2-gold">Platform</span>
        </h1>

        <p class="hero-v2-sub">
            Connecting businesses with <strong>ICAI-verified Chartered Accountants</strong> across India.<br>
            GST &middot; Income Tax &middot; Audit &middot; Corporate Law &middot; FEMA &middot; Startup Finance
        </p>

        <!-- Search -->
        <form class="hero-v2-search" role="search" aria-label="Find a CA">
            <div class="hero-v2-search-inner">
                <div class="hero-v2-field">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <input type="text" placeholder="Search by specialisation (e.g. GST, Audit)" aria-label="Specialisation" />
                </div>
                <div class="hero-v2-field hero-v2-field-border">
                    <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                    <input type="text" placeholder="City or State" aria-label="Location" />
                </div>
                <button type="submit" class="hero-v2-search-btn">
                    <i class="fas fa-search me-2" aria-hidden="true"></i>Find Expert
                </button>
            </div>
        </form>

        <!-- Quick tags -->
        <div class="hero-v2-tags" aria-label="Popular searches">
            <span class="hero-v2-tag-label">Popular:</span>
            @foreach (var tag in new[]{"GST Filing","Income Tax","Startup Compliance","Transfer Pricing","ROC / MCA","Tax Litigation","Forensic Audit"})
            {
                <a href="#professionals" class="hero-v2-tag">@tag</a>
            }
        </div>

        <!-- Stats -->
        <div class="hero-v2-stats" role="list" aria-label="Platform statistics">
            <div class="hero-v2-stat" role="listitem">
                <span class="hero-v2-stat-num">@Model.Stats.TotalCAs</span>
                <span class="hero-v2-stat-lbl">Verified CAs</span>
            </div>
            <div class="hero-v2-stat-divider" aria-hidden="true"></div>
            <div class="hero-v2-stat" role="listitem">
                <span class="hero-v2-stat-num">@Model.Stats.CasesHandled</span>
                <span class="hero-v2-stat-lbl">Cases Resolved</span>
            </div>
            <div class="hero-v2-stat-divider" aria-hidden="true"></div>
            <div class="hero-v2-stat" role="listitem">
                <span class="hero-v2-stat-num">@Model.Stats.Cities</span>
                <span class="hero-v2-stat-lbl">Cities Covered</span>
            </div>
            <div class="hero-v2-stat-divider" aria-hidden="true"></div>
            <div class="hero-v2-stat" role="listitem">
                <span class="hero-v2-stat-num">@Model.Stats.ClientSatisfaction</span>
                <span class="hero-v2-stat-lbl">Client Satisfaction</span>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════
     SERVICES GRID
════════════════════════════════════════ -->
<section class="services-grid-section" aria-labelledby="services-heading">
    <div class="container">
        <div class="text-center mb-4">
            <span class="section-badge">What We Cover</span>
            <h2 class="section-title" id="services-heading">Comprehensive Solutions <span>for Your Business</span></h2>
        </div>
        <div class="row g-3">
            @{
                var services = new (string Icon, string Title, string Desc)[]
                {
                    ("fas fa-file-invoice-dollar","GST & Indirect Tax","Registration, returns, audits & litigation"),
                    ("fas fa-landmark","Income Tax","ITR filing, assessments & appeals"),
                    ("fas fa-building","Corporate Compliance","ROC filings, MCA & company law"),
                    ("fas fa-balance-scale","Tax Litigation","ITAT, HC & SC representations"),
                    ("fas fa-chart-line","Audit & Assurance","Statutory, internal & forensic audit"),
                    ("fas fa-rocket","Startup Finance","Fundraising, ESOP & equity structuring"),
                    ("fas fa-globe","FEMA & RBI","Cross-border transactions & NRI taxation"),
                    ("fas fa-handshake","Transfer Pricing","International transactions & documentation"),
                };
            }
            @foreach (var svc in services)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="service-card reveal">
                        <div class="service-icon"><i class="@svc.Icon" aria-hidden="true"></i></div>
                        <div class="service-title">@svc.Title</div>
                        <div class="service-desc">@svc.Desc</div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════
     EXPERT CONNECT BAND
════════════════════════════════════════ -->
<div class="expert-band">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h3 class="expert-band-title">Need a CA Right Now?</h3>
                <p class="expert-band-sub">Post your requirement — get matched with 3 verified experts within 2 hours. Free to start.</p>
            </div>
            <div class="col-lg-5 text-lg-end mt-3 mt-lg-0">
                <a href="#professionals" class="btn-hero-primary me-2">
                    <i class="fas fa-user-tie me-1"></i> Find a CA
                </a>
                <a href="#how-it-works" class="btn-hero-secondary">
                    <i class="fas fa-info-circle me-1"></i> Learn More
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════
     HOW IT WORKS
════════════════════════════════════════ -->
<section class="how-section" id="how-it-works" aria-labelledby="how-heading">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-badge">Simple Process</span>
            <h2 class="section-title" id="how-heading">Find Your CA in <span>3 Easy Steps</span></h2>
            <p class="section-desc mx-auto">No long paperwork. No middlemen. Connect directly with the right expert in minutes.</p>
        </div>
        <div class="steps-wrapper">
            <div class="step-connector" aria-hidden="true"></div>
            <div class="row g-4">
                @{
                    var steps = new (string Title, string Desc)[]
                    {
                        ("Post Your Requirement",  "Describe what you need — tax filing, GST, audit, or compliance advisory. Takes under 2 minutes."),
                        ("Browse Matched CAs",     "Our smart algorithm surfaces ICAI-verified professionals matched to your exact need and location."),
                        ("Engage & Get It Done",   "Chat, schedule a call, or hire directly. Secure payments and milestone tracking built in.")
                    };
                }
                @for (int i = 0; i < steps.Length; i++)
                {
                    <div class="col-md-4">
                        <div class="step-card reveal @(i > 0 ? $"reveal-delay-{i*2}" : "")">
                            <div class="step-number" aria-label="Step @(i+1)">@(i+1)</div>
                            <h5>@steps[i].Title</h5>
                            <p>@steps[i].Desc</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════
     FEATURED CA PROFESSIONALS
════════════════════════════════════════ -->
<section class="professionals-section" id="professionals" aria-labelledby="prof-heading">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-badge">Top Talent</span>
            <h2 class="section-title" id="prof-heading">Trusted Chartered Accountants <span>Across India</span></h2>
            <p class="section-desc mx-auto">Handpicked CAs with proven track records, top ratings, and deep domain expertise.</p>
        </div>
        <div class="row g-4">
            @{ int delay = 0; }
            @foreach (var ca in featured)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="prof-card reveal @(delay > 0 ? $"reveal-delay-{delay}" : "")">
                        <div class="prof-card-header">
                            @if (ca.IsVerified)
                            {
                                <span class="prof-verified"><i class="fas fa-check-circle" aria-hidden="true"></i> Verified</span>
                            }
                            <div class="prof-avatar" aria-label="@ca.Name">@ca.Initials</div>
                            <div class="prof-name">@ca.Name</div>
                            <div class="prof-designation">@ca.Designation &middot; @ca.YearsExp yrs &middot; @ca.City</div>
                        </div>
                        <div class="prof-card-body">
                            <div class="mb-2">
                                @foreach (var tag in ca.Specialisations.Take(2))
                                {
                                    <span class="prof-tag">@tag</span>
                                }
                            </div>
                            <div class="prof-rating" aria-label="Rating @ca.Rating out of 5">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    <span>@(s <= (int)ca.Rating ? "★" : "☆")</span>
                                }
                                <span class="ms-1 text-muted small">@ca.Rating</span>
                            </div>
                            <div class="prof-meta">
                                <i class="fas fa-briefcase" aria-hidden="true"></i> @ca.CasesHandled+ cases &nbsp;|&nbsp;
                                <i class="fas fa-clock" aria-hidden="true"></i> ~@ca.ResponseTime
                            </div>
                            <button class="btn btn-connect" aria-label="Connect with @ca.Name">
                                <i class="fas fa-user-plus" aria-hidden="true"></i> Connect
                            </button>
                        </div>
                    </div>
                </div>
                delay++;
            }
        </div>
        <div class="text-center mt-4">
            <a href="#" class="btn-hero-secondary d-inline-flex" style="color:#1a3c5e;border-color:#1a3c5e;">
                <i class="fas fa-th-large" aria-hidden="true"></i>&nbsp; Browse All @Model.FeaturedProfessionals.Count+ Professionals
            </a>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════
     TESTIMONIALS
════════════════════════════════════════ -->
<section class="testimonials-section" aria-labelledby="testi-heading">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-badge">Client Stories</span>
            <h2 class="section-title" id="testi-heading">What Our <span>Clients Say</span></h2>
        </div>
        <div class="row g-4">
            @{ int td = 0; }
            @foreach (var t in Model.Testimonials)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="testi-card reveal @(td > 0 ? $"reveal-delay-{td*2}" : "")">
                        <div class="testi-quote" aria-hidden="true">"</div>
                        <p class="testi-text">@t.Text</p>
                        <div class="testi-author">
                            <div class="testi-avatar" aria-hidden="true">@t.Initials</div>
                            <div>
                                <div class="testi-name">@t.AuthorName</div>
                                <div class="testi-role">@t.AuthorRole</div>
                                <div class="testi-stars" aria-label="@t.Rating star rating">
                                    @for (int s = 0; s < t.Rating; s++) { <span>★</span> }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                td++;
            }
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════
     FAQ
════════════════════════════════════════ -->
<section class="faq-section" id="faq" aria-labelledby="faq-heading">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-badge">Got Questions?</span>
            <h2 class="section-title" id="faq-heading">Frequently Asked <span>Questions</span></h2>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="accordion faq-accordion" id="faqAccordion">
                    @{ int fi = 0; }
                    @foreach (var faq in Model.Faqs)
                    {
                        var faqId = $"faqH{fi}";
                        var collapseId = $"faqC{fi}";
                        <div class="accordion-item faq-item reveal">
                            <h3 class="accordion-header" id="@faqId">
                                <button class="accordion-button @(fi > 0 ? "collapsed" : "")" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                        aria-expanded="@(fi == 0 ? "true" : "false")" aria-controls="@collapseId">
                                    @faq.Question
                                </button>
                            </h3>
                            <div id="@collapseId" class="accordion-collapse collapse @(fi == 0 ? "show" : "")"
                                 aria-labelledby="@faqId" data-bs-parent="#faqAccordion">
                                <div class="accordion-body">@faq.Answer</div>
                            </div>
                        </div>
                        fi++;
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════
     CTA
════════════════════════════════════════ -->
<section class="cta-section" aria-labelledby="cta-heading">
    <div class="container">
        <div class="cta-content">
            <span class="section-badge" style="background:rgba(212,160,23,0.15);color:#f0c040;border-color:rgba(212,160,23,0.3);">Ready to Begin?</span>
            <h2 class="section-title mt-2" id="cta-heading">
                Join <span>@Model.Stats.TotalCAs Professionals</span><br>Already on CACampus
            </h2>
            <p class="section-desc">Whether you're a business looking for expert CA services, or a CA wanting to grow your practice — CACampus is built for you.</p>
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a href="#" class="btn-cta-white">
                    <i class="fas fa-user-tie" aria-hidden="true"></i> I'm Looking for a CA
                </a>
                <a href="#" class="btn-cta-outline">
                    <i class="fas fa-graduation-cap" aria-hidden="true"></i> I'm a CA Professional
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════
     FOOTER
════════════════════════════════════════ -->
