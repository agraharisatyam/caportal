    <div class="container">
        <div class="row g-4">
            <!-- Column 1: Brand Info -->
            <div class="col-lg-3 col-md-6">
                @{
                    var ftSvc = ViewContext.HttpContext.RequestServices.GetService(typeof(caportal.Services.SiteSettingsService)) as caportal.Services.SiteSettingsService;
                    var ftLogo = ftSvc?.Get().LogoPath;
                    var ftLogoAlt = ftSvc?.Get().LogoAlt ?? "CACampus";
                }
                <div class="footer-brand">
                    @if (!string.IsNullOrEmpty(ftLogo))
                    {
                        <img src="@ftLogo" alt="@ftLogoAlt" class="site-logo-footer" />
