<!-- ═══════════════════════════════════════════
     HOW IT WORKS
════════════════════════════════════════════ -->
<section class="how-section" id="how-it-works" aria-labelledby="how-heading">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-badge">Simple Process</span>
            <h2 class="section-title" id="how-heading">
                Find Your CA in <span>3 Easy Steps</span>
            </h2>
            <p class="section-desc mx-auto">
                No long paperwork. No middlemen. Connect directly with the right chartered accountant in minutes.
            </p>
        </div>
        <div class="steps-wrapper">
            <div class="step-connector" aria-hidden="true"></div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="step-card reveal">
                        <div class="step-number" aria-label="Step 1">1</div>
                        <h5>Post Your Requirement</h5>
                        <p>Describe what you need — tax filing, GST, audit, or compliance advisory. Takes under 2 minutes.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="step-card reveal reveal-delay-2">
                        <div class="step-number" aria-label="Step 2">2</div>
                        <h5>Browse Matched CAs</h5>
                        <p>Our smart algorithm surfaces ICAI-verified CA professionals matched to your exact need and location.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="step-card reveal reveal-delay-4">
                        <div class="step-number" aria-label="Step 3">3</div>
                        <h5>Engage & Get It Done</h5>
                        <p>Chat, schedule a call, or hire directly. Secure payments and milestone tracking built in.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

