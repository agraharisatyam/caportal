@model caportal.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Find Verified Chartered Accountants in India";
    ViewData["Description"] = "CACampus connects businesses with verified Chartered Accountants across India. Find CAs for GST filing, Income Tax, Audit, Corporate Compliance, FEMA & Startup Finance.";
    Layout = "~/Views/Shared/_LandingLayout.cshtml";
    var featured = Model.FeaturedProfessionals.Where(p => p.IsFeatured).ToList();
    var settings = ViewBag.Settings as caportal.Models.Entities.SiteSettings ?? new caportal.Models.Entities.SiteSettings();
}

@{
    var sectionOrder = (settings.SectionOrder ?? "hero,about,services,portfolio,testimonials,blog,cta")
        .Split(',')
        .Select(s => s.Trim().ToLower())
        .ToList();
}

@foreach (var sectionKey in sectionOrder)
{
    if (sectionKey == "hero" && settings.ShowHeroSection)
    {
        var heroSlides = Model.HeroBannerSlides?.Where(s => s.IsActive).OrderBy(s => s.DisplayOrder).ToList()
                         ?? new List<caportal.Models.Entities.HeroBannerSlide>();

        if (!heroSlides.Any())
        {
            heroSlides = new List<caportal.Models.Entities.HeroBannerSlide>
            {
                new()
                {
                    Title = settings.HeroTitle ?? "CA & Legal Compliance Platform",
                    Subtitle = settings.HeroSubtitle,
                    Badge = settings.HeroBadge,
                    ImagePath = !string.IsNullOrEmpty(settings.HeroBannerImage) ? settings.HeroBannerImage : "/images/hero-banner.png",
                    MobileImagePath = settings.HeroBannerMobileImage,
                    LinkUrl = settings.HeroBannerLink,
                    SlideType = settings.HeroMode ?? "image",
                    ButtonText = settings.HeroPrimaryCtaText,
                    ButtonUrl = settings.HeroPrimaryCtaUrl
                }
            };
        }

        <section class="hero-carousel-section" aria-label="Hero Carousel Banner">
            <div id="homeHeroCarousel" class="carousel slide @(heroSlides.Count > 1 ? "carousel-fade" : "")"
                 data-bs-ride="@(heroSlides.Count > 1 ? "carousel" : "false")"
                 data-bs-interval="4500" data-bs-pause="hover" data-bs-touch="true">
                
                @if (heroSlides.Count > 1)
                {
                    <!-- Indicators / Dots -->
                    <div class="carousel-indicators hero-carousel-dots">
                        @for (int i = 0; i < heroSlides.Count; i++)
                        {
                            <button type="button" data-bs-target="#homeHeroCarousel" data-bs-slide-to="@i"
                                    class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")"
                                    aria-label="Slide @(i + 1)"></button>
                        }
                    </div>
                }

                <!-- Carousel Slides -->
                <div class="carousel-inner">
                    @for (int i = 0; i < heroSlides.Count; i++)
                    {
                        var slide = heroSlides[i];
                        var bannerImg = !string.IsNullOrEmpty(slide.ImagePath) ? slide.ImagePath : "/images/hero-banner.png";
                        var bannerMobile = !string.IsNullOrEmpty(slide.MobileImagePath) ? slide.MobileImagePath : bannerImg;

                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            @if (slide.SlideType == "content")
                            {
                                <!-- Rich Content Hero Slide -->
                                <div class="hero-v2 hero-slide-content-wrap" style="background: linear-gradient(135deg, @(slide.BgGradientFrom ?? "#0a1628") 0%, @(slide.BgGradientTo ?? "#1a2a4a") 100%);">
                                    <div class="hero-v2-overlay"></div>
                                    <div class="container position-relative" style="z-index: 2;">
                                        <div class="text-center max-w-4xl mx-auto py-5">
                                            @if (!string.IsNullOrEmpty(slide.Badge))
                                            {
                                                <div class="hero-v2-label">
                                                    <span>@slide.Badge</span>
                                                </div>
                                            }
                                            <h1 class="hero-v2-title">@slide.Title</h1>
                                            @if (!string.IsNullOrEmpty(slide.Subtitle))
                                            {
                                                <p class="hero-v2-sub">@slide.Subtitle</p>
                                            }

                                            @if (settings.HeroShowSearch)
                                            {
                                                <div class="hero-v2-search">
                                                    <form action="/find-expert" method="get" class="hero-v2-search-inner">
                                                        <div class="hero-v2-field">
                                                            <i class="fas fa-search text-warning"></i>
                                                            <input type="text" name="q" placeholder="Search by service (GST, ITR, Audit, MCA)..." />
                                                        </div>
                                                        <div class="hero-v2-field-border"></div>
                                                        <div class="hero-v2-field">
                                                            <i class="fas fa-map-marker-alt text-warning"></i>
                                                            <input type="text" name="city" placeholder="City (e.g. Mumbai, Delhi, Noida)" />
                                                        </div>
                                                        <button type="submit" class="hero-v2-search-btn">
                                                            <span>Find CA</span>
                                                            <i class="fas fa-arrow-right ms-1"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            }

                                            <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
                                                @if (!string.IsNullOrEmpty(slide.ButtonText))
                                                {
                                                    <a href="@(!string.IsNullOrEmpty(slide.ButtonUrl) ? slide.ButtonUrl : "/find-expert")" class="btn-hero-primary">
                                                        <i class="fas fa-user-tie me-1"></i> @slide.ButtonText
                                                    </a>
                                                }
                                                @if (!string.IsNullOrEmpty(slide.SecondaryButtonText))
                                                {
                                                    <a href="@(!string.IsNullOrEmpty(slide.SecondaryButtonUrl) ? slide.SecondaryButtonUrl : "/#features")" class="btn-hero-secondary">
                                                        <i class="fas fa-layer-group me-1"></i> @slide.SecondaryButtonText
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- Full Image Banner Slide -->
                                <div class="w-100 text-center hero-slide-img-wrap" style="background:#000000;">
                                    @if (!string.IsNullOrEmpty(slide.LinkUrl))
                                    {
                                        <a href="@slide.LinkUrl" class="d-block w-100">
                                            <picture>
                                                @if (!string.IsNullOrEmpty(slide.MobileImagePath))
                                                {
                                                    <source media="(max-width: 768px)" srcset="@bannerMobile">
                                                }
                                                <img src="@bannerImg" alt="@slide.Title" class="hero-carousel-img" />
                                            </picture>
                                        </a>
                                    }
                                    else
                                    {
                                        <picture>
                                            @if (!string.IsNullOrEmpty(slide.MobileImagePath))
                                            {
                                                <source media="(max-width: 768px)" srcset="@bannerMobile">
                                            }
                                            <img src="@bannerImg" alt="@slide.Title" class="hero-carousel-img" />
                                        </picture>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                @if (heroSlides.Count > 1)
                {
                    <!-- Next / Prev Controls -->
                    <button class="carousel-control-prev hero-carousel-arrow hero-arrow-left" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="prev" aria-label="Previous Slide">
                        <i class="fas fa-chevron-left" aria-hidden="true"></i>
                    </button>
                    <button class="carousel-control-next hero-carousel-arrow hero-arrow-right" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="next" aria-label="Next Slide">
                        <i class="fas fa-chevron-right" aria-hidden="true"></i>
                    </button>
                }
            </div>
        </section>
    }
    else if (sectionKey == "services" && settings.ShowServicesSection)
    {
        <!-- ═══════════════════════════════════════
             SERVICES GRID
        ════════════════════════════════════════ -->
        <section class="services-grid-section" aria-labelledby="services-heading">
            <div class="container">
                <div class="text-center mb-4">
                    <span class="section-badge">@ViewBag.ServicesBadge</span>
                    <h2 class="section-title" id="services-heading">@Html.Raw(ViewBag.ServicesTitle)</h2>
                </div>
                <div class="row g-3">
                    @foreach (var svc in Model.Services)
                    {
                        <div class="col-6 col-md-4 col-lg-3">
                            <a href="/service/@svc.Id"
                               class="service-card reveal text-decoration-none d-block">
                                <div class="service-icon">
                                    @if (!string.IsNullOrEmpty(svc.ImagePath))
                                    {
                                        <img src="@svc.ImagePath" alt="@svc.Title" />
                                    }
                                    else
                                    {
                                        <i class="@svc.Icon" aria-hidden="true"></i>
                                    }
                                </div>
                                <div class="service-title">@svc.Title</div>
                                <div class="service-desc">@svc.Description</div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
    else if (sectionKey == "about" && settings.ShowAboutUsSection)
    {
        <!-- ═══════════════════════════════════════
             WHY CHOOSE US
        ════════════════════════════════════════ -->
        <section class="why-choose-section" aria-labelledby="wcu-heading">
            <div class="container">
                <div class="text-center wcu-header">
                    <div class="wcu-badge-container">
                        <div class="wcu-line"></div>
                        <span class="wcu-badge-main">@settings.WhyChooseUsBadge</span>
                        <div class="wcu-line"></div>
                    </div>
                    <h2 class="wcu-title" id="wcu-heading">@settings.WhyChooseUsTitle</h2>
                    <div class="wcu-header-icon">
                        <i class="fas fa-shield-alt" aria-hidden="true"></i>
                    </div>
                    <p class="wcu-subtitle">@settings.WhyChooseUsSub</p>
                </div>

                <div class="wcu-grid">
                    @foreach (var item in Model.WhyChooseUsItems)
                    {
                        <div class="wcu-card text-center">
                            <div class="wcu-card-icon-wrap">
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@item.ImagePath" alt="@item.Title" class="wcu-custom-icon" />
                                }
                                else
                                {
                                    <i class="@item.Icon" aria-hidden="true"></i>
                                }
                            </div>
                            <h5 class="wcu-card-title">@item.Title</h5>
                            <p class="wcu-card-desc">@item.Description</p>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- ═══════════════════════════════════════
             EXPERT CONNECT BAND
        ════════════════════════════════════════ -->
        <div class="expert-band">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-7">
                        <h3 class="expert-band-title">Need a CA Right Now?</h3>
                        <p class="expert-band-sub">Post your requirement — connect directly with verified experts for your business requirements. Free to start.</p>
                    </div>
                    <div class="col-lg-5 text-lg-end mt-3 mt-lg-0">
                        <a href="#professionals" class="btn-hero-primary me-2">
                            <i class="fas fa-user-tie me-1"></i> Find a CA
                        </a>
                        <a href="#how-it-works" class="btn-hero-secondary">
                            <i class="fas fa-info-circle me-1"></i> Learn More
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════
             HOW IT WORKS
        ════════════════════════════════════════ -->
        <section class="how-section" id="how-it-works" aria-labelledby="how-heading">
            <div class="container">
                <div class="text-center mb-5">
                    <span class="section-badge">Simple Process</span>
                    <h2 class="section-title" id="how-heading">Find Your CA in <span>3 Easy Steps</span></h2>
                    <p class="section-desc mx-auto">No long paperwork. Direct transparent communication. Connect directly with the right expert in minutes.</p>
                </div>
                <div class="steps-wrapper">
                    <div class="step-connector" aria-hidden="true"></div>
                    <div class="row g-4">
                        @{
                            var steps = new (string Title, string Desc, string Icon)[]
                            {
                                ("Post Your Requirement",  "Describe what you need — tax filing, GST, audit, or compliance advisory. Takes under 2 minutes.", "fas fa-edit"),
                                ("Browse Verified CAs",     "Browse ICAI-verified professionals matched to your exact service requirements.", "fas fa-user-check"),
                                ("Engage & Get It Done",   "Chat, schedule a call, or hire directly. Transparent pricing and milestone tracking built in.", "fas fa-handshake")
                            };
                        }
                        @for (int i = 0; i < steps.Length; i++)
                        {
                            <div class="col-md-4">
                                <div class="step-card reveal @(i > 0 ? $"reveal-delay-{i*2}" : "")">
                                    <div class="step-number" aria-label="Step @(i+1)">
                                        <i class="@steps[i].Icon me-1" style="font-size:0.95rem;opacity:0.9;"></i>@(i+1)
                                    </div>
                                    <h5>@steps[i].Title</h5>
                                    <p>@steps[i].Desc</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </section>

        <style>
        /* Why Choose Us Section Styling */
        .why-choose-section {
            background: #060606;
            color: #ffffff;
            padding: 80px 0;
            font-family: var(--body-font, 'Inter', sans-serif);
            border-top: 1px solid rgba(212,175,55,0.1);
            border-bottom: 1px solid rgba(212,175,55,0.1);
        }
        .wcu-header {
            margin-bottom: 50px;
        }
        .wcu-badge-container {
            display: inline-flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 12px;
        }
        .wcu-line {
            width: 30px;
            height: 1px;
            background: var(--secondary, #d4a017);
        }
        .wcu-badge-main {
            color: var(--secondary, #d4a017);
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
        }
        .wcu-title {
            font-size: 2.5rem;
            font-weight: 700;
            font-family: var(--heading-font, 'Playfair Display', serif);
            color: var(--heading-color, #ffffff);
            letter-spacing: 0.5px;
            margin-bottom: 10px;
        }
        .wcu-header-icon {
            font-size: 1.2rem;
            color: var(--secondary, #d4a017);
            margin-bottom: 15px;
        }
        .wcu-subtitle {
            color: #bdbdbd;
            max-width: 700px;
            margin: 0 auto;
            font-size: 1rem;
            line-height: 1.6;
        }
        .wcu-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 16px;
            margin-bottom: 40px;
        }
        @@media (max-width: 1200px) {
            .wcu-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }
        @@media (max-width: 768px) {
            .wcu-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        @@media (max-width: 480px) {
            .wcu-grid {
                grid-template-columns: 1fr;
            }
        }
        .wcu-card {
            background: #111111;
            border: 1px solid rgba(212,175,55,0.15);
            border-radius: 12px;
            padding: 24px 16px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            height: 100%;
        }
        .wcu-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary, #4F46E5);
            box-shadow: 0 8px 24px rgba(212,175,55,0.15);
        }
        .wcu-card-icon-wrap {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            border: 1px solid var(--secondary, #d4a017);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--secondary, #d4a017);
            font-size: 1.5rem;
            margin-bottom: 20px;
            transition: all 0.3s ease;
        }
        .wcu-card:hover .wcu-card-icon-wrap {
            background: var(--secondary, #d4a017);
            color: #111111;
        }
        .wcu-custom-icon {
            width: 32px;
            height: 32px;
            object-fit: contain;
        }
        .wcu-card-title {
            font-size: 0.95rem;
            font-weight: 700;
            font-family: var(--heading-font, 'Playfair Display', serif);
            color: #ffffff;
            letter-spacing: 0.5px;
            margin-bottom: 12px;
            text-transform: uppercase;
        }
        .wcu-card-desc {
            font-size: 0.8rem;
            color: #bdbdbd;
            line-height: 1.5;
            margin-bottom: 0;
        }
        </style>
    }
    else if (sectionKey == "portfolio" && settings.ShowFeaturedCAsSection)
    {
        <!-- ═══════════════════════════════════════
             FEATURED CA PROFESSIONALS
        ════════════════════════════════════════ -->
        <section class="professionals-section" id="professionals" aria-labelledby="prof-heading">
            <div class="container">
                <div class="text-center mb-5">
                    <span class="section-badge">@settings.FeaturedCAsBadge</span>
                    <h2 class="section-title" id="prof-heading">@Html.Raw(settings.FeaturedCAsTitle)</h2>
                    <p class="section-desc mx-auto">@settings.FeaturedCAsSubtitle</p>
                </div>
                <div class="row g-4">
                    @{ int delay = 0; }
                    @foreach (var ca in featured)
                    {
                        var caSlug = ca.Name.ToLower().Replace("ca ", "").Replace(" ", "-") + "-" + ca.Id;
                        <div class="col-md-6 col-lg-3">
                            <div class="prof-card reveal @(delay > 0 ? $"reveal-delay-{delay}" : "")" itemscope itemtype="https://schema.org/Person">
                                <div class="prof-card-header">
                                    @if (ca.IsVerified)
                                    {
                                        <span class="prof-verified"><i class="fas fa-check-circle" aria-hidden="true"></i> Verified</span>
                                    }
                                    <a href="/expert/@caSlug" style="text-decoration:none;" aria-label="View profile of @ca.Name">
                                        <div class="prof-avatar" aria-label="@ca.Name">
                                            @if (!string.IsNullOrEmpty(ca.ImagePath))
                                            {
                                                <img src="@ca.ImagePath" alt="@ca.Name" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />
                                            }
                                            else
                                            {
                                                <i class="fas fa-user-tie" style="font-size:1.4rem;color:#0d1f33;" aria-hidden="true"></i>
                                            }
                                        </div>
                                        <div class="prof-name" itemprop="name">@ca.Name</div>
                                    </a>
                                    <div class="prof-designation" itemprop="jobTitle">@ca.Designation &middot; @ca.YearsExp yrs &middot; <span itemprop="workLocation">@ca.City</span></div>
                                </div>
                                <div class="prof-card-body">
                                    <div class="mb-2">
                                        @foreach (var tag in ca.Specialisations.Take(2))
                                        {
                                            <span class="prof-tag" itemprop="knowsAbout">@tag</span>
                                        }
                                    </div>
                                    <div class="prof-rating" aria-label="Rating @ca.Rating out of 5" itemprop="aggregateRating" itemscope itemtype="https://schema.org/AggregateRating">
                                        <meta itemprop="ratingValue" content="@ca.Rating" />
                                        <meta itemprop="bestRating" content="5" />
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            <span>@(s <= (int)ca.Rating ? "★" : "☆")</span>
                                        }
                                        <span class="ms-1 text-muted small">@ca.Rating</span>
                                    </div>
                                    <div class="prof-meta">
                                        <i class="fas fa-briefcase" aria-hidden="true"></i> @ca.CasesHandled+ cases &nbsp;|&nbsp;
                                        <i class="fas fa-clock" aria-hidden="true"></i> ~@ca.ResponseTime
                                    </div>
                                    <a href="/expert/@caSlug" class="btn btn-connect text-decoration-none" aria-label="View Profile of @ca.Name">
                                        <i class="fas fa-user-circle" aria-hidden="true"></i> View Profile &amp; Connect
                                    </a>
                                </div>
                            </div>
                        </div>
                        delay++;
                    }
                </div>
                <div class="text-center mt-4">
                    <a href="/find-expert" class="btn-hero-secondary d-inline-flex" style="color:#1a3c5e;border-color:#1a3c5e;">
                        <i class="fas fa-th-large" aria-hidden="true"></i>&nbsp; Browse All @Model.FeaturedProfessionals.Count+ Professionals
                    </a>
                </div>
            </div>
        </section>
    }
    else if (sectionKey == "testimonials" && settings.ShowTestimonialsSection)
    {
        <!-- ═══════════════════════════════════════
             TESTIMONIALS
        ════════════════════════════════════════ -->
        <section class="testimonials-section" aria-labelledby="testi-heading">
            <div class="container">
                <div class="text-center mb-5">
                    <span class="section-badge">Client Stories</span>
                    <h2 class="section-title" id="testi-heading">What Our <span>Clients Say</span></h2>
                </div>
                <div class="row g-4">
                    @{ int td = 0; }
                    @foreach (var t in Model.Testimonials)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="testi-card reveal @(td > 0 ? $"reveal-delay-{td*2}" : "")">
                                <div class="testi-quote" aria-hidden="true">"</div>
                                <p class="testi-text">@t.Text</p>
                                <div class="testi-author">
                                    <div class="testi-avatar" aria-hidden="true">
                                        <i class="fas fa-user-circle" style="font-size:1.5rem;color:#ffffff;"></i>
                                    </div>
                                    <div>
                                        <div class="testi-name">@t.AuthorName</div>
                                        <div class="testi-role">@t.AuthorRole</div>
                                        <div class="testi-stars" aria-label="@t.Rating star rating">
                                            @for (int s = 0; s < t.Rating; s++) { <span>★</span> }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        td++;
                    }
                </div>
            </div>
        </section>
    }
    else if (sectionKey == "blog" && settings.ShowBlogSection)
    {
        <!-- ═══════════════════════════════════════
             FAQ
        ════════════════════════════════════════ -->
        <section class="faq-section" id="faq" aria-labelledby="faq-heading">
            <div class="container">
                <div class="text-center mb-5">
                    <span class="section-badge">Got Questions?</span>
                    <h2 class="section-title" id="faq-heading">Frequently Asked <span>Questions</span></h2>
                </div>
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="accordion faq-accordion" id="faqAccordion">
                            @{ int fi = 0; }
                            @foreach (var faq in Model.Faqs)
                            {
                                var faqId = $"faqH{fi}";
                                var collapseId = $"faqC{fi}";
                                <div class="accordion-item faq-item reveal">
                                    <h3 class="accordion-header" id="@faqId">
                                        <button class="accordion-button @(fi > 0 ? "collapsed" : "")" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                                aria-expanded="@(fi == 0 ? "true" : "false")" aria-controls="@collapseId">
                                            @faq.Question
                                        </button>
                                    </h3>
                                    <div id="@collapseId" class="accordion-collapse collapse @(fi == 0 ? "show" : "")"
                                         aria-labelledby="@faqId" data-bs-parent="#faqAccordion">
                                        <div class="accordion-body">@faq.Answer</div>
                                    </div>
                                </div>
                                fi++;
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
    else if (sectionKey == "cta" && settings.ShowCtaSection)
    {
        <!-- ═══════════════════════════════════════
             CTA
        ════════════════════════════════════════ -->
        <section class="cta-section" aria-labelledby="cta-heading">
            <div class="container">
                <div class="cta-content">
                    <span class="section-badge" style="background:rgba(212,160,23,0.15);color:#f0c040;border-color:rgba(212,160,23,0.3);">Ready to Begin?</span>
