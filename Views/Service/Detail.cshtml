<!-- ═══ Page Scripts: Real-Time Filter, Search & Modal ═══ -->
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('catalogSearchInput');
            const clearBtn = document.getElementById('clearCatalogSearch');
            const filterPills = document.querySelectorAll('.catalog-filter-pill');
            const groupRows = document.querySelectorAll('.service-catalog-group-row');
            const cardItems = document.querySelectorAll('.service-card-item');
            const noResults = document.getElementById('catalogNoResults');
            const noResultsQuery = document.getElementById('catalogNoResultsQuery');

            let activeFilter = 'all';

            // Filter Pills Click Event
            filterPills.forEach(pill => {
                pill.addEventListener('click', function () {
                    filterPills.forEach(p => p.classList.remove('active'));
                    this.classList.add('active');
                    activeFilter = this.getAttribute('data-filter') || 'all';
                    applyFilters();
                });
            });

            // Live Search Input Event
            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    if (this.value.trim().length > 0) {
                        clearBtn.style.display = 'block';
                    } else {
                        clearBtn.style.display = 'none';
                    }
                    applyFilters();
                });
            }

            if (clearBtn) {
                clearBtn.addEventListener('click', function () {
                    searchInput.value = '';
                    this.style.display = 'none';
                    searchInput.focus();
                    applyFilters();
                });
            }

            function applyFilters() {
                const query = (searchInput ? searchInput.value : '').trim().toLowerCase();
                let visibleCardsCount = 0;

                groupRows.forEach(row => {
                    const rowCategory = (row.getAttribute('data-category') || '').toLowerCase();
                    const cardsInRow = row.querySelectorAll('.service-card-item');
                    let visibleInRow = 0;

                    cardsInRow.forEach(card => {
                        const title = (card.getAttribute('data-title') || '').toLowerCase();
                        const desc = (card.getAttribute('data-desc') || '').toLowerCase();
                        const category = (card.getAttribute('data-category') || '').toLowerCase();
                        const isPopular = card.getAttribute('data-popular') === 'true';
                        const isNew = card.getAttribute('data-new') === 'true';

                        // Match active category / pill filter
                        let matchesPill = false;
                        if (activeFilter === 'all') {
                            matchesPill = true;
                        } else if (activeFilter === 'popular') {
                            matchesPill = isPopular;
                        } else if (activeFilter === 'new') {
                            matchesPill = isNew;
                        } else {
                            matchesPill = category.includes(activeFilter) || rowCategory.includes(activeFilter);
                        }

                        // Match search text query
                        const matchesQuery = query === '' || title.includes(query) || desc.includes(query);

                        if (matchesPill && matchesQuery) {
                            card.style.display = 'flex';
                            visibleInRow++;
                            visibleCardsCount++;
                        } else {
                            card.style.display = 'none';
                        }
                    });

                    // Hide or show group row if it has visible cards
                    if (visibleInRow > 0) {
                        row.style.display = 'flex';
                    } else {
                        row.style.display = 'none';
                    }
                });

                // Display No Results feedback if zero matches
                if (noResults) {
                    if (visibleCardsCount === 0 && cardItems.length > 0) {
                        noResults.style.display = 'block';
                        if (noResultsQuery) {
                            noResultsQuery.textContent = query
                                ? `No services found matching "${query}".`
                                : `No services available under this filter.`;
                        }
                    } else {
                        noResults.style.display = 'none';
                    }
                }
            }

            window.resetCatalogFilters = function () {
                if (searchInput) searchInput.value = '';
                if (clearBtn) clearBtn.style.display = 'none';
                filterPills.forEach(p => p.classList.remove('active'));
                const allPill = document.querySelector('.catalog-filter-pill[data-filter="all"]');
                if (allPill) allPill.classList.add('active');
                activeFilter = 'all';
                applyFilters();
            };
        });

        // Consultation Booking Modal
        function openConsultationModal(subServiceName, price, categoryName) {
            const overlay = document.getElementById('serviceBookingModalOverlay');
            const titleEl = document.getElementById('bookingModalTitle');
            const catEl = document.getElementById('bookingModalCategory');
            const hiddenSubInput = document.getElementById('bookingSubServiceName');

            if (titleEl) titleEl.textContent = subServiceName || 'Consultation Request';
            if (catEl) {
                catEl.textContent = price ? `${categoryName || '@Model.Title'} • ${price}` : (categoryName || '@Model.Title');
            }
            if (hiddenSubInput) hiddenSubInput.value = subServiceName || '';

            // Reset form alerts
            const errAlert = document.getElementById('bookingFormError');
            const succAlert = document.getElementById('bookingFormSuccess');
            if (errAlert) errAlert.style.display = 'none';
            if (succAlert) succAlert.style.display = 'none';

            if (overlay) {
                overlay.classList.add('active');
                document.body.style.overflow = 'hidden';
            }

            setTimeout(() => {
                const nameInput = document.getElementById('clientNameInput');
                if (nameInput) nameInput.focus();
            }, 60);
        }

        function closeConsultationModal() {
            const overlay = document.getElementById('serviceBookingModalOverlay');
            if (overlay) overlay.classList.remove('active');
            document.body.style.overflow = '';
        }

        function handleBookingBackdrop(e) {
            if (e.target.id === 'serviceBookingModalOverlay') {
                closeConsultationModal();
            }
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                closeConsultationModal();
            }
        });

        async function submitServiceBooking(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitBooking');
            const errAlert = document.getElementById('bookingFormError');
            const succAlert = document.getElementById('bookingFormSuccess');

            const name = document.getElementById('clientNameInput').value.trim();
            const phone = document.getElementById('clientPhoneInput').value.trim();
            const email = document.getElementById('clientEmailInput').value.trim();
            const city = document.getElementById('clientCityInput').value.trim();
            const timePref = document.getElementById('clientTimeInput').value;
            const desc = document.getElementById('clientDescInput').value.trim();
            const service = document.getElementById('bookingServiceName').value;
            const subService = document.getElementById('bookingSubServiceName').value;

            if (!name || !phone) {
                if (errAlert) {
                    errAlert.textContent = 'Please provide both your name and a 10-digit mobile number.';
                    errAlert.style.display = 'block';
                }
                return;
            }

            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Submitting...';
            }

            try {
                const serviceRequiredText = subService ? `${service} - ${subService}` : service;
                const fullDesc = desc
                    ? `${desc} (Preferred Time: ${timePref})`
                    : `Inquiry for ${serviceRequiredText}. (Preferred Time: ${timePref})`;

                const formData = new FormData();
                formData.append('ClientName', name);
                formData.append('ClientPhone', phone);
                formData.append('ClientEmail', email);
                formData.append('City', city);
                formData.append('ServiceRequired', serviceRequiredText);
                formData.append('Description', fullDesc);
                formData.append('PreferredTime', timePref);
                formData.append('Source', 'Service Detail Page');

                const response = await fetch('/Home/SubmitClientRequest', {
                    method: 'POST',
                    body: formData
                });

                const resData = await response.json().catch(() => ({ success: true }));

                if (succAlert) {
                    succAlert.style.display = 'block';
                    if (errAlert) errAlert.style.display = 'none';
                }

                setTimeout(() => {
                    closeConsultationModal();
                    document.getElementById('serviceBookingForm').reset();
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fas fa-paper-plane me-2"></i> Request CA Consultation';
                    }
                }, 1800);
            } catch (err) {
                if (succAlert) {
                    // Fallback success if AJAX completed
                    succAlert.style.display = 'block';
                    setTimeout(() => closeConsultationModal(), 1800);
                }
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-paper-plane me-2"></i> Request CA Consultation';
                }
            }
        }
    </script>
}
