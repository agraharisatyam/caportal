@using caportal.Models
@model caportal.Models.CoveredService
@{
    ViewData["Title"] = Model.Title + " — CACampus";
    ViewData["Description"] = Model.Description + ". Find verified Chartered Accountants for " + Model.Title + " on CACampus India.";
    Layout = "~/Views/Shared/_LandingLayout.cshtml";
    var allServices = ViewBag.AllServices as List<CoveredService> ?? new List<CoveredService>();
}

<!-- Hero -->
<section style="background:linear-gradient(135deg,#0d1f33,#1a2a4a);padding:80px 0 60px;margin-top:0;">
    <div class="container">
        <div class="d-flex align-items-center gap-4 flex-wrap">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="@Model.ImagePath" alt="@Model.Title"
                     style="width:90px;height:90px;object-fit:contain;border-radius:16px;background:rgba(255,255,255,0.08);padding:8px;" />
            }
            <div>
                <div class="mb-2">
                    <a href="/" style="color:rgba(255,255,255,0.6);font-size:.82rem;text-decoration:none;">Home</a>
                    <span style="color:rgba(255,255,255,0.4);margin:0 8px;">/</span>
                    <span style="color:#d4a017;font-size:.82rem;">@Model.Title</span>
                </div>
                <h1 style="color:#fff;font-size:2.4rem;font-weight:800;margin:0 0 10px;">@Model.Title</h1>
                <p style="color:rgba(255,255,255,0.75);font-size:1rem;margin:0;max-width:600px;">@Model.Description</p>
            </div>
        </div>

        <div class="d-flex gap-3 mt-5 flex-wrap">
            <a href="#find-ca" class="btn-hero-primary px-4 py-3" style="border-radius:10px;">
                <i class="fas fa-user-tie me-2"></i>Find a CA for @Model.Title
            </a>
            <a href="/" class="btn-hero-secondary px-4 py-3" style="border-radius:10px;color:#fff;border-color:rgba(255,255,255,0.3);">
                <i class="fas fa-arrow-left me-2"></i>Back to Home
            </a>
        </div>
    </div>
</section>

<!-- Why choose a CA section -->
<section style="padding:60px 0;background:#fff;">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6">
                <span class="section-badge">Expert Guidance</span>
                <h2 class="section-title mt-2">Why You Need a CA for<br><span>@Model.Title</span></h2>
                <p class="mt-3" style="color:#6b7280;line-height:1.8;">
                    Navigating @Model.Title requires deep expertise and up-to-date knowledge of Indian regulations.
                    Our ICAI-verified Chartered Accountants ensure compliance, minimize risk, and help you focus on what matters — growing your business.
                </p>
                <ul class="mt-4" style="list-style:none;padding:0;">
                    @foreach (var point in new[]{"100% ICAI-verified professionals","Transparent pricing with no hidden fees","Response within 1–2 hours","Secure milestone-based payments"})
                    {
                        <li class="d-flex align-items-center gap-2 mb-2">
                            <i class="fas fa-check-circle" style="color:#d4a017;"></i>
                            <span style="color:#374151;font-size:.9rem;">@point</span>
                        </li>
                    }
                </ul>
                <a href="#find-ca" class="btn-hero-primary mt-4 d-inline-flex">
                    <i class="fas fa-search me-2"></i>Find a CA Now
                </a>
            </div>
            <div class="col-lg-6">
                <div style="background:linear-gradient(135deg,#0d1f33,#1a3c5e);border-radius:20px;padding:36px;">
                    <div class="row g-4 text-center">
                        @foreach (var stat in new[]{("12K+","Verified CAs"),("50K+","Cases Resolved"),("200+","Cities"),("98%","Satisfaction")})
                        {
                            <div class="col-6">
                                <div style="font-size:2rem;font-weight:800;color:#d4a017;">@stat.Item1</div>
                                <div style="color:rgba(255,255,255,0.7);font-size:.82rem;margin-top:4px;">@stat.Item2</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Find CA section -->
<section id="find-ca" style="padding:60px 0;background:#f8fafc;">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-badge">Find an Expert</span>
            <h2 class="section-title">Verified CAs for <span>@Model.Title</span></h2>
            <p class="section-desc">Browse ICAI-verified professionals ready to help with @Model.Title</p>
        </div>
        <!-- Search bar -->
        <div class="d-flex gap-3 justify-content-center mb-5 flex-wrap">
            <input type="text" class="form-control" style="max-width:300px;"
                   placeholder="Search by city..." id="citySearch" />
            <a href="/#professionals" class="btn-hero-primary">
                <i class="fas fa-search me-2"></i>Browse All CAs
            </a>
        </div>
        <!-- CTA card -->
        <div style="background:linear-gradient(135deg,#0d1f33,#1a3c5e);border-radius:20px;padding:48px;text-align:center;">
            <h3 style="color:#fff;font-weight:800;margin-bottom:12px;">Post Your @Model.Title Requirement</h3>
            <p style="color:rgba(255,255,255,0.75);margin-bottom:28px;max-width:500px;margin-left:auto;margin-right:auto;">
                Describe your need and get matched with 3 verified CA experts within 2 hours. Free to start.
            </p>
            <a href="/#professionals" class="btn-hero-primary px-5 py-3" style="font-size:1rem;">
                <i class="fas fa-comments me-2"></i>Get Free Consultation
            </a>
        </div>
    </div>
</section>

<!-- Other Services -->
<section style="padding:60px 0;background:#fff;">
    <div class="container">
        <div class="text-center mb-4">
            <h4 style="color:#1a3c5e;font-weight:700;">Other Services</h4>
        </div>
        <div class="row g-3 justify-content-center">
            @foreach (var svc in allServices.Where(s => s.Id != Model.Id).Take(8))
            {
                <div class="col-6 col-md-3 col-lg-2">
                    <a href="/service/@svc.Id"
                       style="display:block;text-align:center;padding:16px 8px;border:1px solid #e5e7eb;border-radius:12px;text-decoration:none;transition:all .2s;"
                       onmouseover="this.style.borderColor='#d4a017';this.style.boxShadow='0 4px 16px rgba(212,160,23,0.15)'"
                       onmouseout="this.style.borderColor='#e5e7eb';this.style.boxShadow='none'">
                        @if (!string.IsNullOrEmpty(svc.ImagePath))
                        {
                            <img src="@svc.ImagePath" alt="@svc.Title"
                                 style="width:40px;height:40px;object-fit:contain;margin-bottom:8px;" />
                        }
                        else
                        {
                            <i class="@svc.Icon" style="font-size:1.4rem;color:#1a3c5e;display:block;margin-bottom:8px;"></i>
                        }
                        <div style="font-size:.78rem;font-weight:600;color:#1a3c5e;">@svc.Title</div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>
