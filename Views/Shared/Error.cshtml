@model ErrorViewModel
@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Page Error — CA Chartered Campus";
}

<div class="container py-5 my-5">
    <div class="row justify-content-center text-center">
        <div class="col-lg-6 col-md-8">
            <div class="p-5 rounded-4 shadow-sm bg-white border border-light">
                <div class="mb-4">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10 text-danger p-4" style="width: 80px; height: 80px;">
                        <i class="fas fa-exclamation-triangle fa-2x"></i>
                    </span>
                </div>
                <h1 class="h2 fw-bold text-dark mb-2">Something Went Wrong</h1>
                <p class="text-secondary mb-4">
                    We encountered an unexpected issue while processing your request. Our technical team has been notified.
                </p>

                @if (Model?.ShowRequestId == true)
                {
                    <div class="alert alert-light border small text-muted mb-4 py-2">
                        Reference ID: <code>@Model.RequestId</code>
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a href="/" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold">
                        <i class="fas fa-home me-2"></i> Back to Homepage
                    </a>
                    <a href="/contact" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold">
                        <i class="fas fa-headset me-2"></i> Contact Support
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
