@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Page Not Found (404) — CA Chartered Campus";
}

<div class="container py-5 my-5">
    <div class="row justify-content-center text-center">
        <div class="col-lg-6 col-md-8">
            <div class="p-5 rounded-4 shadow-sm bg-white border border-light">
                <div class="mb-4">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning bg-opacity-10 text-warning p-4" style="width: 88px; height: 88px;">
                        <span class="display-6 fw-bold text-dark">404</span>
                    </span>
                </div>
                <h1 class="h2 fw-bold text-dark mb-2">Page Not Found</h1>
                <p class="text-secondary mb-4">
                    The page you are looking for might have been moved, renamed, or is temporarily unavailable.
                </p>

                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a href="/" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold">
                        <i class="fas fa-home me-2"></i> Go to Homepage
                    </a>
                    <a href="/find-expert" class="btn btn-outline-primary px-4 py-2 rounded-pill fw-semibold">
                        <i class="fas fa-user-tie me-2"></i> Find a CA
                    </a>
                    <a href="/contact" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold">
                        <i class="fas fa-headset me-2"></i> Contact Us
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
