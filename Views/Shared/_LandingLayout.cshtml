<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="CACampus — India's premier platform connecting businesses with verified Chartered Accountants." />
    <title>@ViewData["Title"] - CACampus</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-Avb2QiuDEEvB4bZJYdft2mNjVShBftLdPG8FJ0V7irTLQ8Uo0qcPxh4Plh7eecDqYW1uqWOV/firPRuAzG4Bg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="/site-dynamic.css" />
</head>
<body>

<!-- ═══════════════════════════════════════════
     TOP BAR
════════════════════════════════════════════ -->
<div class="topbar" role="banner">
    <div class="container">
        <div class="topbar-inner">
            <!-- Left: dropdown links -->
            <div class="topbar-left">
                <div class="topbar-dropdown" id="findExpertDrop">
                    <button class="topbar-btn" aria-haspopup="true" aria-expanded="false">
                        <i class="fas fa-user-tie me-1"></i> Find an Expert
                        <i class="fas fa-chevron-down ms-1 topbar-arrow"></i>
                    </button>
                    <div class="topbar-menu" role="menu">
                        <a href="#professionals" class="topbar-menu-item" role="menuitem">
                            <i class="fas fa-search me-2 text-muted"></i>Browse All CAs
                        </a>
                        <a href="#professionals" class="topbar-menu-item" role="menuitem">
                            <i class="fas fa-star me-2 text-warning"></i>Top Rated CAs
                        </a>
                        <a href="#professionals" class="topbar-menu-item" role="menuitem">
                            <i class="fas fa-map-marker-alt me-2 text-danger"></i>CAs Near Me
                        </a>
                        <a href="#professionals" class="topbar-menu-item" role="menuitem">
                            <i class="fas fa-clock me-2 text-success"></i>Available Now
                        </a>
                    </div>
                </div>

                <div class="topbar-separator" aria-hidden="true"></div>

                <div class="topbar-dropdown" id="taxLegalDrop">
                    <button class="topbar-btn" aria-haspopup="true" aria-expanded="false">
                        <i class="fas fa-balance-scale me-1"></i> Tax &amp; Legal
                        <i class="fas fa-chevron-down ms-1 topbar-arrow"></i>
                    </button>
                    <div class="topbar-menu" role="menu">
                        <a href="#" class="topbar-menu-item" role="menuitem">
                            <i class="fas fa-file-invoice-dollar me-2 text-primary"></i>GST &amp; Indirect Tax
                        </a>
                        <a href="#" class="topbar-menu-item" role="menuitem">
                            <i class="fas fa-landmark me-2 text-primary"></i>Income Tax
                        </a>
                        <a href="#" class="topbar-menu-item" role="menuitem">
                            <i class="fas fa-building me-2 text-primary"></i>Corporate Compliance
                        </a>
                        <a href="#" class="topbar-menu-item" role="menuitem">
                            <i class="fas fa-rocket me-2 text-primary"></i>Startup Finance
                        </a>
                        <a href="#" class="topbar-menu-item" role="menuitem">
                            <i class="fas fa-globe me-2 text-primary"></i>FEMA &amp; RBI
                        </a>
                    </div>
                </div>

                <div class="topbar-separator" aria-hidden="true"></div>

                <a href="#contact" class="topbar-btn">
                    <i class="fas fa-envelope me-1"></i> Contact Us
                </a>
            </div>

            <!-- Right: phone + login -->
            <div class="topbar-right">
                <a href="tel:+919876543210" class="topbar-btn topbar-phone">
                    <i class="fas fa-phone-alt me-1"></i> +91 98765 43210
                </a>
                <div class="topbar-separator" aria-hidden="true"></div>
                <a href="/Admin/Auth/Login" class="topbar-btn">
                    <i class="fas fa-lock me-1"></i> Admin
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════
     MAIN NAVBAR
════════════════════════════════════════════ -->
<nav class="ca-navbar" id="mainNav" aria-label="Main navigation">
    <div class="container">
        <div class="navbar-inner">

            <!-- Logo -->
            <a class="navbar-brand" href="/" aria-label="CACampus home">
                <div class="brand-icon" aria-hidden="true">CA</div>
                <div class="brand-text-wrap">
                    <span class="brand-name"><span class="brand-ca">CA</span>Campus</span>
                    <span class="brand-tagline">Verified CA Network</span>
                </div>
            </a>

            <!-- Desktop Nav links -->
            <ul class="navbar-nav flex-row gap-0 d-none d-lg-flex mb-0 align-items-center" role="list">
                <li class="nav-item">
                    <a class="nav-link" href="/">Home</a>
                </li>
                <li class="nav-item nav-dropdown" id="servicesNav">
                    <a class="nav-link nav-link-dropdown" href="#features">
                        Services <i class="fas fa-chevron-down ms-1" style="font-size:.65rem;"></i>
                    </a>
                    <div class="nav-mega-menu" role="menu">
                        <div class="row g-0">
                            <div class="col-6">
                                <div class="mega-section-title">Tax Services</div>
                                <a href="#" class="mega-item" role="menuitem"><i class="fas fa-file-invoice-dollar"></i>GST &amp; Indirect Tax</a>
                                <a href="#" class="mega-item" role="menuitem"><i class="fas fa-landmark"></i>Income Tax Filing</a>
                                <a href="#" class="mega-item" role="menuitem"><i class="fas fa-balance-scale"></i>Tax Litigation</a>
                                <a href="#" class="mega-item" role="menuitem"><i class="fas fa-handshake"></i>Transfer Pricing</a>
                            </div>
                            <div class="col-6">
                                <div class="mega-section-title">Compliance</div>
                                <a href="#" class="mega-item" role="menuitem"><i class="fas fa-building"></i>ROC / MCA Filings</a>
                                <a href="#" class="mega-item" role="menuitem"><i class="fas fa-chart-line"></i>Audit &amp; Assurance</a>
                                <a href="#" class="mega-item" role="menuitem"><i class="fas fa-rocket"></i>Startup Finance</a>
                                <a href="#" class="mega-item" role="menuitem"><i class="fas fa-globe"></i>FEMA &amp; RBI</a>
                            </div>
                        </div>
                    </div>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#how-it-works">How It Works</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#professionals">Find CAs</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#pricing">Pricing</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#contact">Contact</a>
                </li>
            </ul>

            <!-- Desktop CTA buttons -->
            <div class="d-none d-lg-flex align-items-center gap-2">
                <a href="#" class="btn-nav-login">
                    <i class="fas fa-sign-in-alt me-1"></i> Log In
                </a>
                <a href="#" class="btn-nav-cta">
                    <i class="fas fa-comments me-1"></i> Consult Now
                </a>
            </div>

            <!-- Mobile toggler -->
            <button class="mobile-toggle d-lg-none" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mobileNav"
                    aria-controls="mobileNav" aria-expanded="false" aria-label="Toggle navigation">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <!-- Mobile menu -->
        <div class="collapse" id="mobileNav">
            <div class="mobile-menu">
                <ul class="navbar-nav gap-1 mb-3">
                    <li><a class="nav-link" href="/">Home</a></li>
                    <li><a class="nav-link" href="#features">Services</a></li>
                    <li><a class="nav-link" href="#how-it-works">How It Works</a></li>
                    <li><a class="nav-link" href="#professionals">Find CAs</a></li>
                    <li><a class="nav-link" href="#pricing">Pricing</a></li>
                    <li><a class="nav-link" href="#contact">Contact</a></li>
                </ul>
                <div class="d-flex gap-2">
                    <a href="#" class="btn btn-outline-light btn-sm flex-fill text-center">Log In</a>
                    <a href="#" class="btn-nav-cta btn btn-sm flex-fill text-center">Consult Now</a>
                </div>
            </div>
        </div>
    </div>
</nav>

@RenderBody()

<!-- ═══════════════════════════════════════════
     EXPERT CONSULTATION POPUP
════════════════════════════════════════════ -->
<div class="consult-overlay" id="consultOverlay" role="dialog" aria-modal="true" aria-labelledby="consultTitle" aria-hidden="true">
    <div class="consult-popup">
        <!-- Close button -->
        <button class="consult-close" id="consultClose" aria-label="Close consultation popup">
            <i class="fas fa-times"></i>
        </button>

        <!-- Header -->
        <div class="consult-header">
            <div class="consult-icon" aria-hidden="true">
                <i class="fas fa-user-tie"></i>
            </div>
            <h2 class="consult-title" id="consultTitle">Expert Consultation</h2>
            <p class="consult-sub">Enter your details to get a free callback from our Chartered Accountants.</p>
        </div>

        <!-- Form -->
        <form class="consult-form" id="consultForm" novalidate>
            <div class="consult-field">
                <label class="consult-label" for="consultName">FULL NAME</label>
                <input type="text" id="consultName" class="consult-input" placeholder="John Doe" required autocomplete="name" />
                <span class="consult-error" id="nameError">Please enter your full name.</span>
            </div>

            <div class="consult-field">
                <label class="consult-label" for="consultPhone">PHONE NUMBER</label>
                <input type="tel" id="consultPhone" class="consult-input" placeholder="+91 98765 43210" required autocomplete="tel" pattern="[0-9+\s]{10,15}" />
                <span class="consult-error" id="phoneError">Please enter a valid phone number.</span>
            </div>

            <div class="consult-field">
                <label class="consult-label" for="consultService">SELECT SERVICE</label>
                <select id="consultService" class="consult-input consult-select" required>
                    <option value="" disabled selected>Choose a category...</option>
                    <option value="gst">GST &amp; Indirect Tax</option>
                    <option value="income-tax">Income Tax Filing</option>
                    <option value="audit">Audit &amp; Assurance</option>
                    <option value="corporate">Corporate Compliance</option>
                    <option value="startup">Startup Finance</option>
                    <option value="fema">FEMA &amp; RBI</option>
                    <option value="transfer-pricing">Transfer Pricing</option>
                    <option value="tax-litigation">Tax Litigation</option>
                    <option value="other">Other</option>
                </select>
                <span class="consult-error" id="serviceError">Please select a service.</span>
            </div>

            <button type="submit" class="consult-submit">
                <i class="fas fa-phone-alt me-2" aria-hidden="true"></i>REQUEST CALLBACK
            </button>

            <!-- Success message -->
            <div class="consult-success" id="consultSuccess" aria-live="polite" style="display:none;">
                <i class="fas fa-check-circle me-2"></i>
                Thank you! Our CA will call you within 2 hours.
            </div>
        </form>
    </div>
</div>

<!-- Floating trigger button -->
<button class="consult-float-btn" id="consultTrigger" aria-label="Open expert consultation">
    <i class="fas fa-comments" aria-hidden="true"></i>
    <span>Free Consult</span>
</button>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/landing.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
