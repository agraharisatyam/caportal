<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="CACampus — India's premier platform connecting businesses with verified Chartered Accountants." />
    <title>@ViewData["Title"] - CACampus</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-Avb2QiuDEEvB4bZJYdft2mNjVShBftLdPG8FJ0V7irTLQ8Uo0qcPxh4Plh7eecDqYW1uqWOV/firPRuAzG4Bg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="/site-dynamic.css" />
</head>
<body>

<!-- ═══════════════════════════════════════════
     MAIN NAVBAR (merged topbar + navbar)
════════════════════════════════════════════ -->
<nav class="ca-navbar" id="mainNav" aria-label="Main navigation">
    @{
        var navSvc = Context.RequestServices.GetService(typeof(caportal.Services.SiteSettingsService)) as caportal.Services.SiteSettingsService;
        var navSettings = navSvc?.Get();
        var navLogo = navSettings?.LogoPath;
        var navSiteName = navSettings?.SiteName ?? "CACampus";
        var navTagline  = navSettings?.SiteTagline ?? "Verified CA Network";
        var navPhone    = navSettings?.SitePhone ?? "+91 98765 43210";
    }
    <div class="container">
        <div class="navbar-inner">

            <!-- Brand / Logo -->
            <a class="navbar-brand" href="/" aria-label="@navSiteName home">
                @if (!string.IsNullOrEmpty(navLogo))
                {
                    <img src="@navLogo" alt="@(navSettings?.LogoAlt ?? navSiteName)" class="site-logo-main" />
                }
                else
                {
                    <div class="brand-icon" aria-hidden="true">CA</div>
                    <div class="brand-text-wrap">
                        <span class="brand-name"><span class="brand-ca">CA</span>@navSiteName.Replace("CA","")</span>
                        <span class="brand-tagline">@navTagline</span>
                    </div>
                }
            </a>

            <!-- Desktop Nav links -->
            <ul class="navbar-nav flex-row gap-0 d-none d-lg-flex mb-0 align-items-center" role="list">
                <li class="nav-item">
                    <a class="nav-link" href="/">Home</a>
                </li>
                <li class="nav-item nav-dropdown" id="servicesNav">
                    <a class="nav-link nav-link-dropdown" href="#features">
                        Services <i class="fas fa-chevron-down ms-1" style="font-size:.65rem;"></i>
                    </a>
                    <div class="nav-mega-menu" role="menu">
                        <div class="row g-0">
                            <div class="col-6">
                                <div class="mega-section-title">Tax Services</div>
                                <a href="#" class="mega-item" role="menuitem"><i class="fas fa-file-invoice-dollar"></i>GST &amp; Indirect Tax</a>
                                <a href="#" class="mega-item" role="menuitem"><i class="fas fa-landmark"></i>Income Tax Filing</a>
                                <a href="#" class="mega-item" role="menuitem"><i class="fas fa-balance-scale"></i>Tax Litigation</a>
                                <a href="#" class="mega-item" role="menuitem"><i class="fas fa-handshake"></i>Transfer Pricing</a>
                            </div>
                            <div class="col-6">
                                <div class="mega-section-title">Compliance</div>
                                <a href="#" class="mega-item" role="menuitem"><i class="fas fa-building"></i>ROC / MCA Filings</a>
                                <a href="#" class="mega-item" role="menuitem"><i class="fas fa-chart-line"></i>Audit &amp; Assurance</a>
                                <a href="#" class="mega-item" role="menuitem"><i class="fas fa-rocket"></i>Startup Finance</a>
                                <a href="#" class="mega-item" role="menuitem"><i class="fas fa-globe"></i>FEMA &amp; RBI</a>
                            </div>
                        </div>
                    </div>
                </li>
                <li class="nav-item nav-dropdown" id="findExpertNav">
                    <a class="nav-link nav-link-dropdown" href="#professionals">
                        Find an Expert <i class="fas fa-chevron-down ms-1" style="font-size:.65rem;"></i>
                    </a>
                    <div class="nav-mega-menu" role="menu">
                        <div class="row g-0">
                            <div class="col-6">
                                <div class="mega-section-title">Browse CAs</div>
                                <a href="#professionals" class="mega-item" role="menuitem"><i class="fas fa-search"></i>Browse All CAs</a>
                                <a href="#professionals" class="mega-item" role="menuitem"><i class="fas fa-star"></i>Top Rated CAs</a>
                            </div>
                            <div class="col-6">
                                <div class="mega-section-title">Availability</div>
                                <a href="#professionals" class="mega-item" role="menuitem"><i class="fas fa-map-marker-alt"></i>CAs Near Me</a>
                                <a href="#professionals" class="mega-item" role="menuitem"><i class="fas fa-clock"></i>Available Now</a>
                            </div>
                        </div>
                    </div>
                </li>
                <li class="nav-item nav-dropdown" id="taxLegalNav">
                    <a class="nav-link nav-link-dropdown" href="#">
                        Tax &amp; Legal <i class="fas fa-chevron-down ms-1" style="font-size:.65rem;"></i>
                    </a>
                    <div class="nav-mega-menu" role="menu">
                        <div class="row g-0">
                            <div class="col-6">
                                <div class="mega-section-title">Taxation</div>
                                <a href="#" class="mega-item" role="menuitem"><i class="fas fa-file-invoice-dollar"></i>GST &amp; Indirect Tax</a>
                                <a href="#" class="mega-item" role="menuitem"><i class="fas fa-landmark"></i>Income Tax</a>
                                <a href="#" class="mega-item" role="menuitem"><i class="fas fa-building"></i>Corporate Compliance</a>
                            </div>
                            <div class="col-6">
                                <div class="mega-section-title">Finance &amp; Law</div>
                                <a href="#" class="mega-item" role="menuitem"><i class="fas fa-rocket"></i>Startup Finance</a>
                                <a href="#" class="mega-item" role="menuitem"><i class="fas fa-globe"></i>FEMA &amp; RBI</a>
                            </div>
                        </div>
                    </div>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#how-it-works">How It Works</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#pricing">Pricing</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#contact">Contact</a>
                </li>
            </ul>

            <!-- Desktop right side: phone + admin + CTAs -->
            <div class="d-none d-lg-flex align-items-center gap-2">
                <a href="tel:@navPhone.Replace(" ","")" class="nav-link nav-phone">
                    <i class="fas fa-phone-alt me-1"></i> @navPhone
                </a>
                <div class="nav-sep" aria-hidden="true"></div>
                <a href="/Admin/Auth/Login" class="btn-nav-login">
                    <i class="fas fa-lock me-1"></i> Admin
                </a>
                <a href="#" class="btn-nav-cta">
                    <i class="fas fa-comments me-1"></i> Consult Now
                </a>
            </div>

            <!-- Mobile toggler -->
            <button class="mobile-toggle d-lg-none" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mobileNav"
                    aria-controls="mobileNav" aria-expanded="false" aria-label="Toggle navigation">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <!-- Mobile menu -->
        <div class="collapse" id="mobileNav">
            <div class="mobile-menu">
                <ul class="navbar-nav gap-1 mb-3">
                    <li><a class="nav-link" href="/">Home</a></li>
                    <li><a class="nav-link" href="#features">Services</a></li>
                    <li><a class="nav-link" href="#professionals">Find an Expert</a></li>
                    <li><a class="nav-link" href="#">Tax &amp; Legal</a></li>
                    <li><a class="nav-link" href="#how-it-works">How It Works</a></li>
                    <li><a class="nav-link" href="#professionals">Find CAs</a></li>
                    <li><a class="nav-link" href="#pricing">Pricing</a></li>
                    <li><a class="nav-link" href="#contact">Contact</a></li>
                </ul>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="tel:@navPhone.Replace(" ","")" class="btn btn-outline-secondary btn-sm flex-fill text-center">
                        <i class="fas fa-phone-alt me-1"></i> @navPhone
                    </a>
                    <a href="/Admin/Auth/Login" class="btn btn-outline-light btn-sm flex-fill text-center">
                        <i class="fas fa-lock me-1"></i> Admin
                    </a>
                    <a href="#" class="btn-nav-cta btn btn-sm flex-fill text-center">Consult Now</a>
                </div>
            </div>
        </div>
    </div>
</nav>

@RenderBody()

<!-- Floating Consult Widget — button + inline form -->
<div class="float-widget" id="floatWidget">

    <!-- Form panel (slides up above button) -->
    <div class="float-form-panel" id="floatFormPanel" aria-hidden="true">
        <!-- Close -->
        <button class="float-form-close" id="floatFormClose" aria-label="Close consultation form">
            <i class="fas fa-times"></i>
        </button>

        <!-- Header -->
        <div class="float-form-header">
            @{
                var floatSvc = Context.RequestServices.GetService(typeof(caportal.Services.SiteSettingsService)) as caportal.Services.SiteSettingsService;
                var floatSettings = floatSvc?.Get();
                var floatLogo = floatSettings?.LogoPath;
                var floatSiteName = floatSettings?.SiteName ?? "CACampus";
            }
            <div class="float-form-icon" aria-hidden="true">
                @if (!string.IsNullOrEmpty(floatLogo))
                {
                    <img src="@floatLogo" alt="@(floatSettings?.LogoAlt ?? floatSiteName)" style="max-height:48px;max-width:120px;object-fit:contain;" />
                }
                else
                {
                    <i class="fas fa-user-tie"></i>
                }
            </div>
            <h3 class="float-form-title">Expert Consultation</h3>
            <p class="float-form-sub">Enter your details to get a free callback from our Chartered Accountants.</p>
        </div>

        <!-- Form -->
        <form class="float-form-body" id="floatConsultForm" novalidate>

            <div class="float-field">
                <label class="float-label" for="fcName">FULL NAME</label>
                <input type="text" id="fcName" class="float-input" placeholder="John Doe" required autocomplete="name" />
                <span class="float-err" id="fcNameErr">Please enter your full name.</span>
            </div>

            <div class="float-field">
                <label class="float-label" for="fcPhone">PHONE NUMBER</label>
                <input type="tel" id="fcPhone" class="float-input" placeholder="+91 98765 43210" required autocomplete="tel" />
                <span class="float-err" id="fcPhoneErr">Please enter a valid phone number.</span>
            </div>

            <div class="float-field">
                <label class="float-label" for="fcService">SELECT SERVICE</label>
                <select id="fcService" class="float-input float-select" required>
                    <option value="" disabled selected>Choose a category...</option>
                    <option value="gst">GST &amp; Indirect Tax</option>
                    <option value="income-tax">Income Tax Filing</option>
                    <option value="audit">Audit &amp; Assurance</option>
                    <option value="corporate">Corporate Compliance</option>
                    <option value="startup">Startup Finance</option>
                    <option value="fema">FEMA &amp; RBI</option>
                    <option value="transfer-pricing">Transfer Pricing</option>
                    <option value="tax-litigation">Tax Litigation</option>
                    <option value="other">Other</option>
                </select>
                <span class="float-err" id="fcServiceErr">Please select a service.</span>
            </div>

            <button type="submit" class="float-submit">
                <i class="fas fa-phone-alt me-2" aria-hidden="true"></i>REQUEST CALLBACK
            </button>

            <div class="float-success" id="floatSuccess" style="display:none;" aria-live="polite">
                <i class="fas fa-check-circle me-2"></i>
                Thank you! We'll call you within 2 hours.
            </div>

        </form>
    </div>

    <!-- Trigger button -->
    <button class="float-trigger-btn" id="floatTriggerBtn" aria-expanded="false" aria-controls="floatFormPanel">
        <i class="fas fa-comments float-btn-icon" id="floatBtnIcon" aria-hidden="true"></i>
        <span id="floatBtnText">Free Consult</span>
    </button>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/landing.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
