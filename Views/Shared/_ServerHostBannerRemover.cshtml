<!-- Server Host Banner / Ad Suppressor (Blocks & removes Somee.com footer ads and scripts) -->
<style>
    center,
    center:has(a[href*="somee.com"]),
    center:has(a[href*="Somee.com"]),
    a[href*="somee.com"],
    a[href*="Somee.com"],
    div[style*="z-index: 2147483647"],
    div[style*="z-index:2147483647"],
    div[style*="opacity: 0.9"][style*="bottom: 0px"],
    div[onmouseover*="S_ssac"],
    div[onmouseover*="s_ssac"],
    body > center,
    html > center,
    body > div[style*="height: 65px"] {
        display: none !important;
        visibility: hidden !important;
        opacity: 0 !important;
        pointer-events: none !important;
        height: 0 !important;
        min-height: 0 !important;
        max-height: 0 !important;
        width: 0 !important;
        line-height: 0 !important;
        font-size: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        position: absolute !important;
        top: -99999px !important;
        left: -99999px !important;
        clip: rect(0, 0, 0, 0) !important;
        overflow: hidden !important;
    }
</style>
<script>
    (function () {
        // 1. Intercept script injection from Somee (WholeInsert5.js)
        var origAppendChild = Node.prototype.appendChild;
        Node.prototype.appendChild = function (node) {
            if (node && node.nodeName === 'SCRIPT' && node.src && (node.src.indexOf('somee.com') !== -1 || node.src.indexOf('WholeInsert') !== -1)) {
                return node;
            }
            return origAppendChild.apply(this, arguments);
        };

        var origInsertBefore = Node.prototype.insertBefore;
        Node.prototype.insertBefore = function (node, refNode) {
            if (node && node.nodeName === 'SCRIPT' && node.src && (node.src.indexOf('somee.com') !== -1 || node.src.indexOf('WholeInsert') !== -1)) {
                return node;
            }
            return origInsertBefore.apply(this, arguments);
        };

        if (Element.prototype.append) {
            var origAppend = Element.prototype.append;
            Element.prototype.append = function () {
                for (var i = 0; i < arguments.length; i++) {
                    var arg = arguments[i];
                    if (arg && arg.nodeName === 'SCRIPT' && arg.src && (arg.src.indexOf('somee.com') !== -1 || arg.src.indexOf('WholeInsert') !== -1)) {
                        return;
                    }
                }
                return origAppend.apply(this, arguments);
            };
        }

        // 2. Intercept innerHTML / insertAdjacentHTML injection
        var origInsertAdjacentHTML = Element.prototype.insertAdjacentHTML;
        Element.prototype.insertAdjacentHTML = function (pos, html) {
            if (typeof html === 'string' && (html.indexOf('somee.com') !== -1 || html.indexOf('2147483647') !== -1 || html.indexOf('VirtualServer') !== -1)) {
                return;
            }
            return origInsertAdjacentHTML.apply(this, arguments);
        };

        // 3. Active DOM cleanup function
        function purgeSomeeAds() {
            var targets = document.querySelectorAll('center, a[href*="somee.com"], a[href*="Somee.com"], div[style*="2147483647"], div[onmouseover*="S_ssac"], div[style*="height: 65px"]');
            for (var i = 0; i < targets.length; i++) {
                var el = targets[i];
                try {
                    if (el.nodeName === 'CENTER' || (el.href && el.href.toLowerCase().indexOf('somee.com') !== -1) || (el.style && (el.style.zIndex === '2147483647' || el.style.height === '65px'))) {
                        el.remove();
                    }
                } catch (e) { }
            }
        }

        // 4. MutationObserver for instant removal
        if (window.MutationObserver) {
            var obs = new MutationObserver(function () {
                purgeSomeeAds();
            });
            obs.observe(document.documentElement, { childList: true, subtree: true });
        }

        document.addEventListener('DOMContentLoaded', purgeSomeeAds);
        window.addEventListener('load', purgeSomeeAds);
        purgeSomeeAds();
    })();
</script>
